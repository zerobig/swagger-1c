////////////////////////////////////////////////////////////////////////////////
// Demo_Products - HTTP-сервис демонстрационного API товаров.
//
// Демонстрирует правильное использование swagger-1c + zod-1c:
//   1. Валидация запроса одной строкой через Swag_ZodАптер.
//   2. Ранний возврат 422 с детальным списком ошибок.
//   3. Работа с проверенными и приведёнными данными
//      (числа - Числа, uuid - строки, enum - валидные значения).
//   4. Единая обработка ошибок через Swag_ОбработкаHTTP.ОтветJSON.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// GET /demo/products?page=1&limit=20&search=...&sort=name_asc
Функция ТоварыGET(Запрос) Экспорт

	// 1. Валидируем запрос одной строкой
	Результат = Swag_ZodАдаптер.ПроверитьЗапрос(
			"Demo_Products", "ТоварыGET", Запрос);

	Если НЕ Результат.Успех Тогда
		Возврат Swag_ОбработкаHTTP.ОтветJSON(
			ОшибкаВалидации(Результат.Ошибки), 422);
	КонецЕсли;

	// 2. Применяем значения по умолчанию для необязательных параметров
	Параметры = Результат.Данные;
	Страница = ?(Параметры.Свойство("page"), Параметры.page, 1);
	Лимит = ?(Параметры.Свойство("limit"), Параметры.limit, 20);
	Поиск = ?(Параметры.Свойство("search"), Параметры.search, "");
	Сортировка = ?(Параметры.Свойство("sort"), Параметры.sort, "name_asc");

	// 3. Бизнес-логика (заглушка - в реальном API это запрос к БД)
	Список = ПолучитьДемоТовары(Поиск, Сортировка);

	// 4. Формируем постраничный ответ
	ВсегоТоваров = Список.Количество();
	Начало = (Страница - 1) * Лимит;
	Конец = Начало + Лимит - 1;
	Элементы = Новый Массив;
	Для Индекс = Начало По Конец Цикл
		Если Индекс >= ВсегоТоваров Тогда
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Список[Индекс]);
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("items", Элементы);
	Ответ.Вставить("total", ВсегоТоваров);
	Ответ.Вставить("page", Страница);
	Ответ.Вставить("limit", Лимит);
	Ответ.Вставить("pages", ?(ВсегоТоваров = 0, 0, Цел((ВсегоТоваров - 1) / Лимит) + 1));

	Возврат Swag_ОбработкаHTTP.ОтветJSON(Ответ, 200);

КонецФункции

// GET /demo/products/{id}
Функция ТоварGET(Запрос) Экспорт

	Результат = Swag_ZodАдаптер.ПроверитьЗапрос(
			"Demo_Products", "ТоварGET", Запрос);

	Если НЕ Результат.Успех Тогда
		Возврат Swag_ОбработкаHTTP.ОтветJSON(
			ОшибкаВалидации(Результат.Ошибки), 422);
	КонецЕсли;

	// Результат.Данные.id - уже проверенная строка UUID
	Ид = Результат.Данные.id;

	Товар = НайтиДемоТоварПоИд(Ид);
	Если Товар = Неопределено Тогда
		Возврат Swag_ОбработкаHTTP.ОтветJSON(
			ОшибкаПростая("not_found", "Товар с id " + Ид + " не найден"), 404);
	КонецЕсли;

	Возврат Swag_ОбработкаHTTP.ОтветJSON(Товар, 200);

КонецФункции

// POST /demo/products
Функция ТоварыСозданиеPOST(Запрос) Экспорт

	Результат = Swag_ZodАдаптер.ПроверитьЗапрос(
			"Demo_Products", "ТоварыСозданиеPOST", Запрос);

	Если НЕ Результат.Успех Тогда
		Возврат Swag_ОбработкаHTTP.ОтветJSON(
			ОшибкаВалидации(Результат.Ошибки), 422);
	КонецЕсли;

	// Результат.Данные содержит поля из тела запроса:
	// name (Строка), price (Число), stock (Число), category (Строка), ...
	Данные = Результат.Данные;

	НовыйТовар = Новый Структура;
	НовыйТовар.Вставить("id", Строка(Новый УникальныйИдентификатор()));
	НовыйТовар.Вставить("name", Данные.name);
	НовыйТовар.Вставить("price", Данные.price);
	НовыйТовар.Вставить("stock", ?(Данные.Свойство("stock"), Данные.stock, 0));
	НовыйТовар.Вставить("category", ?(Данные.Свойство("category"), Данные.category, "other"));
	НовыйТовар.Вставить("description",
		?(Данные.Свойство("description"), Данные.description, Неопределено));

	СохранитьДемоТовар(НовыйТовар);

	Возврат Swag_ОбработкаHTTP.ОтветJSON(НовыйТовар, 201);

КонецФункции

// PUT /demo/products/{id}
Функция ТоварОбновлениеPUT(Запрос) Экспорт

	Результат = Swag_ZodАдаптер.ПроверитьЗапрос(
			"Demo_Products", "ТоварОбновлениеPUT", Запрос);

	Если НЕ Результат.Успех Тогда
		Возврат Swag_ОбработкаHTTP.ОтветJSON(
			ОшибкаВалидации(Результат.Ошибки), 422);
	КонецЕсли;

	Ид = Результат.Данные.id;
	Товар = НайтиДемоТоварПоИд(Ид);
	Если Товар = Неопределено Тогда
		Возврат Swag_ОбработкаHTTP.ОтветJSON(
			ОшибкаПростая("not_found", "Товар с id " + Ид + " не найден"), 404);
	КонецЕсли;

	// Обновляем поля (кроме id)
	Для Каждого Поле Из Результат.Данные Цикл
		Если Поле.Ключ = "id" Тогда
			Продолжить;
		КонецЕсли;
		Товар.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	СохранитьДемоТовар(Товар);

	Возврат Swag_ОбработкаHTTP.ОтветJSON(Товар, 200);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ============ ФОРМИРОВАНИЕ ОШИБОК ============

// Формат ошибки, соответствующий схеме DemoError.
Функция ОшибкаВалидации(ОшибкиZod)

	Детали = Новый Массив;
	Для Каждого Ош Из ОшибкиZod Цикл
		Деталь = Новый Структура;
		Деталь.Вставить("path", Ош.Путь);
		Деталь.Вставить("message", Ош.Сообщение);
		Детали.Добавить(Деталь);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("code", "validation_error");
	Результат.Вставить("message", "Ошибка валидации запроса");
	Результат.Вставить("details", Детали);
	Возврат Результат;

КонецФункции

Функция ОшибкаПростая(Код, Сообщение)

	Результат = Новый Структура;
	Результат.Вставить("code", Код);
	Результат.Вставить("message", Сообщение);
	Возврат Результат;

КонецФункции

// ============ БИЗНЕС-ЛОГИКА (ЗАГЛУШКИ) ============
//
// В реальном API замените на запросы к БД, справочникам, документам 1С.
// Демо использует статический список в памяти, чтобы пример был
// самодостаточным и не требовал создания объектов в конфигурации.

Функция ПолучитьДемоТовары(Поиск, Сортировка)

	ВсеТовары = ДемоКаталогТоваров();

	// Фильтр по поиску
	Если НЕ ПустаяСтрока(Поиск) Тогда
		ПоискВРег = ВРег(Поиск);
		Отфильтрованные = Новый Массив;
		Для Каждого Товар Из ВсеТовары Цикл
			Если СтрНайти(ВРег(Товар.name), ПоискВРег) > 0 Тогда
				Отфильтрованные.Добавить(Товар);
			КонецЕсли;
		КонецЦикла;
		ВсеТовары = Отфильтрованные;
	КонецЕсли;

	// Сортировка
	Если Сортировка = "name_asc" Тогда
		СортироватьПоПолю(ВсеТовары, "name", "Возр");
	ИначеЕсли Сортировка = "name_desc" Тогда
		СортироватьПоПолю(ВсеТовары, "name", "Убыв");
	ИначеЕсли Сортировка = "price_asc" Тогда
		СортироватьПоПолю(ВсеТовары, "price", "Возр");
	ИначеЕсли Сортировка = "price_desc" Тогда
		СортироватьПоПолю(ВсеТовары, "price", "Убыв");
	КонецЕсли;

	Возврат ВсеТовары;

КонецФункции

Функция НайтиДемоТоварПоИд(Ид)
	Для Каждого Товар Из ДемоКаталогТоваров() Цикл
		Если Товар.id = Ид Тогда
			Возврат Товар;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

