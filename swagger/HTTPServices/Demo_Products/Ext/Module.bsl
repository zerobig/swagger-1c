Функция ДемоКаталогТоваров()

	СтатическийКэш = Неопределено; // в 1С нет статики - возвращаем новый
	// Для реальной демонстрации можно вынести в параметр сеанса

	Товары = Новый Массив;

	Товар = Новый Структура;
	Товар.Вставить("id", "11111111-1111-1111-1111-111111111111");
	Товар.Вставить("name", "Ноутбук");
	Товар.Вставить("description", "14-дюймовый ноутбук для работы");
	Товар.Вставить("price", 75000);
	Товар.Вставить("stock", 10);
