КонецФункции

Процедура СортироватьПоПолю(Массив, ИмяПоля, Направление)

	// Простая пузырьковая сортировка для демо
	Для Индекс1 = 0 По Массив.Количество() - 2 Цикл
		Для Индекс2 = 0 По Массив.Количество() - 2 - Индекс1 Цикл
			Значение1 = Массив[Индекс2][ИмяПоля];
			Значение2 = Массив[Индекс2 + 1][ИмяПоля];

			НужноПереставить = Ложь;
			Если Направление = "Возр" Тогда
				НужноПереставить = Значение1 > Значение2;
			Иначе
				НужноПереставить = Значение1 < Значение2;
			КонецЕсли;

			Если НужноПереставить Тогда
				Временное = Массив[Индекс2];
				Массив[Индекс2] = Массив[Индекс2 + 1];
				Массив[Индекс2 + 1] = Временное;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

