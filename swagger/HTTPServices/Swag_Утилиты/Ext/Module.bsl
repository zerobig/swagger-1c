// GET /swagger/diagnostics
//
// Возвращает JSON-отчёт о замечаниях в описаниях HTTP-сервисов.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - Параметры:
//     * format - Строка - "json" (по умолчанию) или "csv"
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ДиагностикаОписанийGET(Запрос) Экспорт

	Отчёт = Swag_Сборщик.ДиагностикаОписаний();

	Если НРег(Запрос.ПараметрыЗапроса.Получить("format")) = "csv" Тогда
		Возврат ОтветCSV(Отчёт);
	КонецЕсли;

	Возврат Swag_ОбработкаHTTP.ОтветJSON(ОтчётВСтруктуру(Отчёт));

КонецФункции

// Превращает ТаблицаЗначений в Структуру для JSON-сериализации.
Функция ОтчётВСтруктуру(Отчёт)

	Результат = Новый Структура;
	Результат.Вставить("total", Отчёт.Количество());

	КоличествоПредупреждений = 0;
	КоличествоОшибок = 0;
	Для Каждого Строка Из Отчёт Цикл
		Если Строка.Критичность = "Предупреждение" Тогда
			КоличествоПредупреждений = КоличествоПредупреждений + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("warnings", КоличествоПредупреждений);
	Результат.Вставить("errors", КоличествоОшибок);

	Элементы = Новый Массив;
	Для Каждого Строка Из Отчёт Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("code", Строка.Код);
		Элемент.Вставить("path", Строка.URL);
		Элемент.Вставить("message", Строка.Сообщение);
		Элемент.Вставить("severity", Строка.Критичность);
		Элемент.Вставить("service", Строка.Сервис);
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Результат.Вставить("items", Элементы);

	Возврат Результат;

КонецФункции

// Экспорт отчёта в CSV для открытия в Excel.
Функция ОтветCSV(Отчёт)

	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку("Код;Путь;Сообщение;Критичность;Сервис");

	Для Каждого Строка Из Отчёт Цикл
		Текст.ДобавитьСтроку(
			Строка.Код + ";"
			+ Строка.URL + ";"
			+ Строка.Сообщение + ";"
			+ Строка.Критичность + ";"
			+ Строка.Сервис);
	КонецЦикла;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "text/csv; charset=utf-8");
	Ответ.Заголовки.Вставить("Content-Disposition",
		"attachment; filename=""swagger-diagnostics.csv""");
	Ответ.УстановитьТелоИзСтроки(Текст.ПолучитьТекст(),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции
