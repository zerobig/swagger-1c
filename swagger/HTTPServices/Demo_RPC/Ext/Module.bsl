////////////////////////////////////////////////////////////////////////////////
// Demo_RPC - демонстрационный HTTP-сервис, реализующий JSON-RPC 2.0.
//
// Endpoint: POST /hs/demo/rpc
//
// Поддерживает:
//   - одиночные запросы и батч-запросы (массив);
//   - именованные параметры (params - объект);
//   - уведомления (notification, без поля "id") - ответ 204 без тела;
//   - стандартные коды ошибок JSON-RPC (-32700, -32600, -32601, -32602,
//     -32603) и серверные коды (-32001 и т.п.).
//
// Демонстрационные методы:
//   echo             - возвращает переданное сообщение
//   sum              - сумма двух чисел
//   time.now         - текущее время сервера
//   products.list    - постраничный список товаров
//   products.get     - один товар по id
//
// В реальном проекте бизнес-логику лучше вынести в отдельный общий модуль,
// а здесь оставить только диспетчеризацию и упаковку ответа.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция RPC_POST(Запрос) Экспорт

	ТелоСтрокой = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоСтрокой) Тогда
		Возврат УпаковатьJSONRPCОтвет(
			СобратьОшибкуJSONRPC(Null, -32700, "Parse error",
				"Пустое тело запроса"));
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоСтрокой);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина); // в Соответствие/Массив
	Исключение
		Возврат УпаковатьJSONRPCОтвет(
			СобратьОшибкуJSONRPC(Null, -32700, "Parse error",
				"Некорректный JSON: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	// Одиночный запрос
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Результат = ОбработатьЗапросJSONRPC(Данные);
		Если Результат = Неопределено Тогда
			// Notification - ответ не отправляется
			Возврат Новый HTTPСервисОтвет(204);
		КонецЕсли;
		Возврат УпаковатьJSONRPCОтвет(Результат);
	КонецЕсли;

	// Батч
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Если Данные.Количество() = 0 Тогда
			Возврат УпаковатьJSONRPCОтвет(
				СобратьОшибкуJSONRPC(Null, -32600, "Invalid Request",
					"Пустой батч-запрос"));
		КонецЕсли;

		Результаты = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			РезультатЭлемента = ОбработатьЗапросJSONRPC(Элемент);
			Если РезультатЭлемента <> Неопределено Тогда
				Результаты.Добавить(РезультатЭлемента);
			КонецЕсли;
		КонецЦикла;

		Если Результаты.Количество() = 0 Тогда
			// Все notification - ответ не отправляется
			Возврат Новый HTTPСервисОтвет(204);
		КонецЕсли;

		Возврат УпаковатьJSONRPCОтвет(Результаты);
	КонецЕсли;

	// Ни объект, ни массив
	Возврат УпаковатьJSONRPCОтвет(
		СобратьОшибкуJSONRPC(Null, -32600, "Invalid Request",
			"Ожидался объект или массив"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область JSONRPCОбработка

// Обрабатывает один JSON-RPC запрос.
// Возвращает Соответствие (готовый ответ) или Неопределено
// (если запрос - notification, ответ не нужен).
Функция ОбработатьЗапросJSONRPC(Запрос)

	Если ТипЗнч(Запрос) <> Тип("Соответствие") Тогда
		Возврат СобратьОшибкуJSONRPC(Null, -32600, "Invalid Request",
			"Запрос должен быть объектом");
	КонецЕсли;

	// Проверка версии
	Если Запрос.Получить("jsonrpc") <> "2.0" Тогда
		Возврат СобратьОшибкуJSONRPC(ИзвлечьИд(Запрос), -32600,
			"Invalid Request", "Ожидалось jsonrpc = ""2.0""");
	КонецЕсли;

	// Notification: отсутствие ключа "id"
	ИдЗапроса = Запрос.Получить("id");
	ЭтоНотификация = (ИдЗапроса = Неопределено);

	// Имя метода
	ИмяМетода = Запрос.Получить("method");
	Если ТипЗнч(ИмяМетода) <> Тип("Строка") ИЛИ ПустаяСтрока(ИмяМетода) Тогда
		Возврат СобратьОшибкуJSONRPC(ИдЗапроса, -32600,
			"Invalid Request", "method должен быть непустой строкой");
	КонецЕсли;

	// Параметры
	Параметры = Запрос.Получить("params");
	Если Параметры = Неопределено ИЛИ ТипЗнч(Параметры) = Тип("Null") Тогда
		Параметры = Новый Соответствие;
	ИначеЕсли ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		Возврат СобратьОшибкуJSONRPC(ИдЗапроса, -32602,
			"Invalid params", "params должен быть объектом");
	КонецЕсли;

	// Диспетчеризация
	Попытка
		Результат = ВызватьМетодJSONRPC(ИмяМетода, Параметры);
	Исключение
		Возврат СобратьОшибкуJSONRPC(ИдЗапроса, -32603, "Internal error",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Результат = Неопределено Тогда
		Возврат СобратьОшибкуJSONRPC(ИдЗапроса, -32601, "Method not found",
			"Метод """ + ИмяМетода + """ не найден");
	КонецЕсли;

	// Ошибка в методе (например, неверные параметры)
	Если Результат.Свойство("errorCode") Тогда
		Возврат СобратьОшибкуJSONRPC(ИдЗапроса,
			Результат.errorCode, Результат.errorMessage,
			?(Результат.Свойство("errorData"), Результат.errorData, Неопределено));
	КонецЕсли;

	// Notification - ответ не формируем
	Если ЭтоНотификация Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Успешный ответ
	Возврат СобратьУспехJSONRPC(ИдЗапроса, Результат.result);

КонецФункции

Функция ИзвлечьИд(Запрос)
	Если Запрос.Свойство("id") Тогда
		Возврат Запрос.Получить("id");
	КонецЕсли;
	Возврат Null;
КонецФункции

Функция СобратьУспехJSONRPC(Ид, Данные)
	Результат = Новый Соответствие;
	Результат.Вставить("jsonrpc", "2.0");
	Результат.Вставить("result", Данные);
	Результат.Вставить("id", Ид);
	Возврат Результат;
КонецФункции

Функция СобратьОшибкуJSONRPC(Ид, Код, Сообщение, Данные = Неопределено)

	Ошибка = Новый Соответствие;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Если Данные <> Неопределено Тогда
		Ошибка.Вставить("data", Данные);
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("jsonrpc", "2.0");
	Результат.Вставить("error", Ошибка);
	Результат.Вставить("id", ?(Ид = Неопределено, Null, Ид));
	Возврат Результат;

КонецФункции

Функция УпаковатьJSONRPCОтвет(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(),
		КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОшибкаМетода(Код, Сообщение, Данные = Неопределено)
	Результат = Новый Структура;
	Результат.Вставить("errorCode", Код);
	Результат.Вставить("errorMessage", Сообщение);
	Результат.Вставить("errorData", Данные);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Методы

// Возвращает Соответствие("result", Данные) при успехе,
// или результат ОшибкаМетода(...) при ошибке,
// или Неопределено, если метод не найден.
Функция ВызватьМетодJSONRPC(ИмяМетода, Параметры)

	Если ИмяМетода = "echo" Тогда
		Возврат МетодEcho(Параметры);
	ИначеЕсли ИмяМетода = "sum" Тогда
		Возврат МетодSum(Параметры);
	ИначеЕсли ИмяМетода = "time.now" Тогда
		Возврат МетодTimeNow(Параметры);
	ИначеЕсли ИмяМетода = "products.list" Тогда
		Возврат МетодProductsList(Параметры);
	ИначеЕсли ИмяМетода = "products.get" Тогда
		Возврат МетодProductsGet(Параметры);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция МетодEcho(Параметры)

	Сообщение = Параметры.Получить("message");
	Если ТипЗнч(Сообщение) <> Тип("Строка") Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"message должен быть строкой");
	КонецЕсли;
	Если СтрДлина(Сообщение) > 1000 Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"message длиннее 1000 символов");
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("message", Сообщение);
	Возврат Новый Структура("result", Результат);

КонецФункции

Функция МетодSum(Параметры)

	А = Параметры.Получить("a");
	Б = Параметры.Получить("b");

	Если ТипЗнч(А) <> Тип("Число") Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"a должен быть числом");
	КонецЕсли;
	Если ТипЗнч(Б) <> Тип("Число") Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"b должен быть числом");
	КонецЕсли;

	Результат = Новый Соответствие;
	Результат.Вставить("value", А + Б);
	Возврат Новый Структура("result", Результат);

КонецФункции

Функция МетодTimeNow(Параметры)

	Результат = Новый Соответствие;
	Результат.Вставить("timestamp", ТекущаяУниверсальнаяДата());
	Возврат Новый Структура("result", Результат);

КонецФункции

Функция МетодProductsList(Параметры)

	Страница = Параметры.Получить("page");
	Лимит = Параметры.Получить("limit");

	Если Страница = Неопределено Тогда
		Страница = 1;
	ИначеЕсли ТипЗнч(Страница) <> Тип("Число") ИЛИ Страница < 1 Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"page должен быть целым числом >= 1");
	КонецЕсли;

	Если Лимит = Неопределено Тогда
		Лимит = 20;
	ИначеЕсли ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит < 1 ИЛИ Лимит > 100 Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"limit должен быть целым числом от 1 до 100");
	КонецЕсли;

	ВсеТовары = ДемоКаталогТоваров();
	Всего = ВсеТовары.Количество();

	Начало = (Страница - 1) * Лимит;
	КонецИндекс = Начало + Лимит - 1;
	Элементы = Новый Массив;
	Для Индекс = Начало По КонецИндекс Цикл
		Если Индекс >= Всего Тогда
			Прервать;
		КонецЕсли;
		Элементы.Добавить(ВсеТовары[Индекс]);
	КонецЦикла;

	Результат = Новый Соответствие;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("total", Всего);
	Результат.Вставить("page", Страница);
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("pages",
		?(Всего = 0, 0, Цел((Всего - 1) / Лимит) + 1));
	Возврат Новый Структура("result", Результат);

КонецФункции

Функция МетодProductsGet(Параметры)

	Ид = Параметры.Получить("id");
	Если ТипЗнч(Ид) <> Тип("Строка") ИЛИ ПустаяСтрока(Ид) Тогда
		Возврат ОшибкаМетода(-32602, "Invalid params",
			"id должен быть непустой строкой");
	КонецЕсли;

	Для Каждого Товар Из ДемоКаталогТоваров() Цикл
		Если Товар.Получить("id") = Ид Тогда
			Возврат Новый Структура("result", Товар);
		КонецЕсли;
	КонецЦикла;

	Возврат ОшибкаМетода(-32001, "Product not found",
		"Товар с id " + Ид + " не найден");

КонецФункции

#КонецОбласти

#Область ДемоДанные

Функция ДемоКаталогТоваров()

	Товары = Новый Массив;

	Товар = Новый Соответствие;
	Товар.Вставить("id", "11111111-1111-1111-1111-111111111111");
	Товар.Вставить("name", "Ноутбук");
	Товар.Вставить("price", 75000);
	Товар.Вставить("stock", 10);
	Товары.Добавить(Товар);

	Товар = Новый Соответствие;
	Товар.Вставить("id", "22222222-2222-2222-2222-222222222222");
	Товар.Вставить("name", "Футболка");
	Товар.Вставить("price", 1500);
	Товар.Вставить("stock", 100);
	Товары.Добавить(Товар);

	Товар = Новый Соответствие;
	Товар.Вставить("id", "33333333-3333-3333-3333-333333333333");
	Товар.Вставить("name", "Кофе в зёрнах");
	Товар.Вставить("price", 1200);
	Товар.Вставить("stock", 50);
	Товары.Добавить(Товар);

	Возврат Товары;

КонецФункции

#КонецОбласти

#КонецОбласти
