////////////////////////////////////////////////////////////////////////////////
// Swag_Операция - билдер Operation (OpenAPI 3.1).
// Фабрика Swag_Модель.НоваяОперация возвращает экземпляр этой обработки.
////////////////////////////////////////////////////////////////////////////////

Перем Состояние;

Процедура Инициализировать(Method, Путь) Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Method", Method);
	Состояние.Вставить("Path", Путь);
	Состояние.Вставить("OperationId", Неопределено);
	Состояние.Вставить("Summary", Неопределено);
	Состояние.Вставить("Description", Неопределено);
	Состояние.Вставить("Tags", Новый Массив);
	Состояние.Вставить("Parameters", Новый Массив);
	Состояние.Вставить("RequestBody", Неопределено);
	Состояние.Вставить("Responses", Новый Соответствие);
	Состояние.Вставить("Security", Неопределено); // Неопределено = унаследовано от глобального
	Состояние.Вставить("Deprecated", Ложь);

КонецПроцедуры

// ============ МОДИФИКАТОРЫ ============

Функция OperationId(Значение) Экспорт
	Состояние.OperationId = Значение;
	Возврат ЭтотОбъект;
КонецФункции

Функция КраткоеОписание(Значение) Экспорт
	Состояние.Summary = Значение;
	Возврат ЭтотОбъект;
КонецФункции

Функция Описание(Значение) Экспорт
	Состояние.Description = Значение;
	Возврат ЭтотОбъект;
КонецФункции

Функция Тег(Имя) Экспорт
	Состояние.Tags.Добавить(Имя);
	Возврат ЭтотОбъект;
КонецФункции

Функция Устарело() Экспорт
	Состояние.Deprecated = Истина;
	Возврат ЭтотОбъект;
КонецФункции

// ============ ПАРАМЕТРЫ ============

Функция Параметр(Имя, Расположение, Схема, Описание = Неопределено, Обязательный = Неопределено) Экспорт

	Если Расположение = "path" Тогда
		Обязательный = Истина;
	ИначеЕсли Обязательный = Неопределено Тогда
		Обязательный = Ложь;
	КонецЕсли;

	Параметр = Новый Структура;
	Параметр.Вставить("name", Имя);
	// Внутреннее имя location; сериализатор → "in"
	Параметр.Вставить("location", Расположение);
	Параметр.Вставить("required", Обязательный);
	Если Описание <> Неопределено Тогда
		Параметр.Вставить("description", Описание);
	КонецЕсли;
	Параметр.Вставить("schema", РазвернутьСхему(Схема, "Параметр '" + Имя + "'"));

	Состояние.Parameters.Добавить(Параметр);
	Возврат ЭтотОбъект;

КонецФункции

// ============ REQUEST BODY ============

Функция ТелоЗапроса(Схема, Описание = Неопределено, MIME = "application/json") Экспорт

	MediaType = Новый Структура("schema", РазвернутьСхему(Схема, "ТелоЗапроса"));
	Content = Новый Соответствие;
	Content.Вставить(MIME, MediaType);

	RequestBody = Новый Структура;
	RequestBody.Вставить("content", Content);
	RequestBody.Вставить("required", Истина);
	Если Описание <> Неопределено Тогда
		RequestBody.Вставить("description", Описание);
	КонецЕсли;

	Состояние.RequestBody = RequestBody;
	Возврат ЭтотОбъект;

КонецФункции

// ============ RESPONSES ============

Функция Ответ(Код, Описание, Схема = Неопределено, MIME = "application/json") Экспорт

	Ответ = Новый Структура;
	Ответ.Вставить("description", Описание);

	Если Схема <> Неопределено Тогда
		MediaType = Новый Структура("schema", РазвернутьСхему(Схема, "Ответ " + Код));
		Content = Новый Соответствие;
		Content.Вставить(MIME, MediaType);
		Ответ.Вставить("content", Content);
	КонецЕсли;

	Состояние.Responses.Вставить(Строка(Код), Ответ);
	Возврат ЭтотОбъект;

КонецФункции

// ============ SECURITY ============

Функция ТребуетSecurity(Имя, Scopes = Неопределено) Экспорт

	Если Состояние.Security = Неопределено Тогда
		Состояние.Security = Новый Массив;
	КонецЕсли;

	Если Scopes = Неопределено Тогда
		Scopes = Новый Массив;
	КонецЕсли;

	Требование = Новый Соответствие;
	Требование.Вставить(Имя, Scopes);
	Состояние.Security.Добавить(Требование);

	Возврат ЭтотОбъект;

КонецФункции

Функция БезSecurity() Экспорт
	Состояние.Security = Новый Массив; // пустой массив = без аутентификации
	Возврат ЭтотОбъект;
КонецФункции

// ============ СБОРКА ============

Функция Сформировать() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("method", Состояние.Method);
	Результат.Вставить("path", Состояние.Path);

	Если Состояние.OperationId <> Неопределено Тогда
		Результат.Вставить("operationId", Состояние.OperationId);
	КонецЕсли;
	Если Состояние.Summary <> Неопределено Тогда
		Результат.Вставить("summary", Состояние.Summary);
	КонецЕсли;
	Если Состояние.Description <> Неопределено Тогда
		Результат.Вставить("description", Состояние.Description);
	КонецЕсли;
	Если Состояние.Tags.Количество() > 0 Тогда
		Результат.Вставить("tags", Состояние.Tags);
	КонецЕсли;
	Если Состояние.Parameters.Количество() > 0 Тогда
		Результат.Вставить("parameters", Состояние.Parameters);
	КонецЕсли;
	Если Состояние.RequestBody <> Неопределено Тогда
		Результат.Вставить("requestBody", Состояние.RequestBody);
	КонецЕсли;

	Результат.Вставить("responses", Состояние.Responses);

	Если Состояние.Security <> Неопределено Тогда
		Результат.Вставить("security", Состояние.Security);
	КонецЕсли;
	Если Состояние.Deprecated Тогда
		Результат.Вставить("deprecated", Истина);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция РазвернутьСхему(Значение, ИмяПараметра)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Значение.Сформировать();
	Исключение
		ВызватьИсключение ИмяПараметра
		+ ": ожидалась схема (Swag_Схема) или Структура, получено: " + Строка(ТипЗначения);
	КонецПопытки;
КонецФункции
