////////////////////////////////////////////////////////////////////////////////
// Swag_Схема - билдер JSON Schema (OpenAPI 3.1).
// Фабрики в общем модуле Swag_Модель возвращают экземпляр этой обработки.
// Метод Сформировать() возвращает чистую Структуру с полями OpenAPI.
////////////////////////////////////////////////////////////////////////////////

Перем Состояние;

Процедура Инициализировать(Тип, КлючВариантов = Неопределено) Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Тип", Тип);
	Состояние.Вставить("КлючВариантов", КлючВариантов); // "oneOf" / "anyOf" / "allOf"
	Состояние.Вставить("Поля", Новый Структура); // произвольные поля модели
	Состояние.Вставить("Свойства", Новый Соответствие);
	Состояние.Вставить("Требуемые", Новый Массив);
	Состояние.Вставить("ЗначенияПеречисления", Новый Массив);
	Состояние.Вставить("Варианты", Новый Массив);
	Состояние.Вставить("Элементы", Неопределено);
	Состояние.Вставить("Nullable", Ложь);

КонецПроцедуры

// ============ МОДИФИКАТОРЫ - ОБЩИЕ ============

Функция ФорматЗначения(Значение) Экспорт
	ПроверитьТип("string,integer,number", "ФорматЗначения");
	Состояние.Поля.Вставить("format", Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция Заголовок(Значение) Экспорт
	Состояние.Поля.Вставить("title", Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция Описание(Значение) Экспорт
	Состояние.Поля.Вставить("description", Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция Пример(Значение) Экспорт
	Состояние.Поля.Вставить("example", Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция ЗначениеПоУмолчанию(Значение) Экспорт
	Состояние.Поля.Вставить("default", Значение);
	Возврат ЭтотОбъект;
КонецФункции

Функция ДопускаетNull() Экспорт
	Состояние.Nullable = Истина;
	Возврат ЭтотОбъект;
КонецФункции

Функция ТолькоЧтение() Экспорт
	Состояние.Поля.Вставить("readOnly", Истина);
	Возврат ЭтотОбъект;
КонецФункции

Функция ТолькоЗапись() Экспорт
	Состояние.Поля.Вставить("writeOnly", Истина);
	Возврат ЭтотОбъект;
КонецФункции

Функция Устарело() Экспорт
	Состояние.Поля.Вставить("deprecated", Истина);
	Возврат ЭтотОбъект;
КонецФункции

