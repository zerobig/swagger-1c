	Возврат ЭтотОбъект;
КонецФункции

// ============ МОДИФИКАТОРЫ - OBJECT ============

Функция Свойство(Имя, Схема) Экспорт
	ПроверитьТип("object", "Свойство");
	Состояние.Свойства.Вставить(Имя, РазвернутьСхему(Схема, "Свойство '" + Имя + "'"));
	Возврат ЭтотОбъект;
КонецФункции

// Принимает либо одну строку, либо массив имён.
Функция Требует(Имена) Экспорт
	ПроверитьТип("object", "Требует");
	Если ТипЗнч(Имена) = Тип("Массив") Тогда
		Для Каждого Имя Из Имена Цикл
			Состояние.Требуемые.Добавить(Имя);
		КонецЦикла;
	Иначе
		Состояние.Требуемые.Добавить(Имена);
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

Функция ДополнительныеСвойства(Значение) Экспорт
	ПроверитьТип("object", "ДополнительныеСвойства");
	Состояние.Поля.Вставить("additionalProperties", Значение);
	Возврат ЭтотОбъект;
КонецФункции

// ============ МОДИФИКАТОРЫ - ENUM ============

Функция ЗначениеПеречисления(Значение) Экспорт
	Если Состояние.Тип <> "string" И Состояние.Тип <> "integer" Тогда
		ВызватьИсключение
		"ЗначениеПеречисления: перечисление можно устанавливать только "
		+ "для свойства типов string и integer";
	КонецЕсли;
	Состояние.ЗначенияПеречисления.Добавить(Значение);
	Возврат ЭтотОбъект;
КонецФункции

// ============ МОДИФИКАТОРЫ - ONE OF / ANY OF / ALL OF ============

Функция Вариант(Схема) Экспорт
	Если Состояние.КлючВариантов = Неопределено Тогда
		ВызватьИсключение "Вариант: метод доступен только для схем oneOf/anyOf/allOf";
	КонецЕсли;
	Состояние.Варианты.Добавить(РазвернутьСхему(Схема, "Вариант"));
	Возврат ЭтотОбъект;
КонецФункции

// ============ СБОРКА ============

Функция Сформировать() Экспорт

	Результат = Новый Структура;

	// Базовые поля
	Если Состояние.Тип <> Неопределено Тогда
		Результат.Вставить("type", Состояние.Тип);
	КонецЕсли;

	Для Каждого Поле Из Состояние.Поля Цикл
		Результат.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	// Nullable
	Если Состояние.Nullable Тогда
		Результат.Вставить("nullable", Истина);
	КонецЕсли;

	// Тип-специфичные поля
	Если Состояние.Тип = "object" Тогда
		Результат.Вставить("properties", Состояние.Свойства);
		Если Состояние.Требуемые.Количество() > 0 Тогда
			Результат.Вставить("required", Состояние.Требуемые);
		КонецЕсли;
	ИначеЕсли Состояние.Тип = "array" Тогда
		Если Состояние.Элементы <> Неопределено Тогда
			Результат.Вставить("items", Состояние.Элементы);
		КонецЕсли;
	КонецЕсли;

	// Enum
	Если Состояние.ЗначенияПеречисления.Количество() > 0 Тогда
		Результат.Вставить("enum", Состояние.ЗначенияПеречисления);
	КонецЕсли;

	// OneOf/AnyOf/AllOf
	Если Состояние.КлючВариантов <> Неопределено
		И Состояние.Варианты.Количество() > 0 Тогда
		Результат.Вставить(Состояние.КлючВариантов, Состояние.Варианты);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Процедура ПроверитьТип(ДопустимыеТипы, ИмяМетода)
	Если Состояние.Тип = Неопределено Тогда
		Возврат; // oneOf/anyOf/allOf - без базового типа
	КонецЕсли;
	Если СтрНайти("," + ДопустимыеТипы + ",", "," + Состояние.Тип + ",") > 0 Тогда
		Возврат;
	КонецЕсли;
	ВызватьИсключение ИмяМетода
	+ ": метод допустим только для типов [" + ДопустимыеТипы + "], "
	+ "текущий тип - " + Состояние.Тип;
КонецПроцедуры

Функция РазвернутьСхему(Значение, ИмяПараметра)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Значение.Сформировать();
	Исключение
		ВызватьИсключение ИмяПараметра
		+ ": ожидалась схема (Swag_Схема) или готовая Структура, "
		+ "получено: " + Строка(ТипЗначения);
	КонецПопытки;
КонецФункции
