// Вспомогательная функция - прочитать JSON обратно в Соответствие.
Функция Прочитать(ТекстJSON)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина); // Истина = в Соответствие
КонецФункции

