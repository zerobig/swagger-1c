Процедура ОписаниеСОперациейИСхемами() Экспорт
	Описание = Swag_Модель.НовоеОписание("Customer API", "1.0.0");
	Описание = Swag_Модель.ДобавитьСхему(Описание, "Customer",
			Swag_Модель.СхемаОбъект()
			.Свойство("id", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
			.Свойство("name", Swag_Модель.СхемаСтрока().МинДлина(1))
			.Требует("id")
			.Требует("name")
			.Сформировать());

	Операция = Swag_Модель.НоваяОперация("get", "/customers/{id}")
		.OperationId("getCustomer")
		.Параметр("id", "path", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
		.Ответ("200", "OK", Swag_Модель.СхемаСсылка("Customer"))
		.Ответ("404", "Not found")
		.Сформировать();
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);

	Данные = Прочитать(Swag_СериализаторOpenAPI.Сериализовать(Описание));

	// Проверяем пути
	Пути = Данные.Получить("paths");
	ЮТест.ОжидаетЧто(Пути.Получить("/customers/{id}")).НеРавно(Неопределено);

	// Проверяем operationId
	GET = Пути.Получить("/customers/{id}").Получить("get");
	ЮТест.ОжидаетЧто(GET.Получить("operationId")).Равно("getCustomer");

	// Проверяем параметр (in, не location)
	Параметр = GET.Получить("parameters")[0];
	ЮТест.ОжидаетЧто(Параметр.Получить("in")).Равно("path");
	ЮТест.ОжидаетЧто(Параметр.Получить("required")).ЭтоИстина();
	ЮТест.ОжидаетЧто(Параметр.Получить("schema").Получить("format")).Равно("uuid");

	// Проверяем схему Customer
	Customer = Данные.Получить("components").Получить("schemas").Получить("Customer");
	ЮТест.ОжидаетЧто(Customer.Получить("type")).Равно("object");
	ЮТест.ОжидаетЧто(Customer.Получить("required")).Содержит("id");
КонецПроцедуры

Процедура ОписаниеСSecurity() Экспорт
	Описание = Swag_Модель.НовоеОписание("API", "1.0");
	Описание = Swag_Модель.ДобавитьSecurityScheme(Описание, "basicAuth",
			Swag_Модель.SecurityBasic());
	Описание = Swag_Модель.ДобавитьSecurityScheme(Описание, "apiKey",
			Swag_Модель.SecurityApiKey("X-API-Key", "header"));
	Описание = Swag_Модель.УстановитьГлобальныйSecurity(Описание, "basicAuth");

	Операция = Swag_Модель.НоваяОперация("get", "/test")
		.Ответ("200", "OK")
		.Сформировать();
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);

	Данные = Прочитать(Swag_СериализаторOpenAPI.Сериализовать(Описание));

	Schemes = Данные.Получить("components").Получить("securitySchemes");
	Basic = Schemes.Получить("basicAuth");
	ЮТест.ОжидаетЧто(Basic.Получить("type")).Равно("http");
	ЮТест.ОжидаетЧто(Basic.Получить("scheme")).Равно("basic");

	ApiKey = Schemes.Получить("apiKey");
	ЮТест.ОжидаетЧто(ApiKey.Получить("type")).Равно("apiKey");
	ЮТест.ОжидаетЧто(ApiKey.Получить("in")).Равно("header"); // ← in, не location
	ЮТест.ОжидаетЧто(ApiKey.Получить("location")).Равно(Неопределено);

	ГлобальныйSecurity = Данные.Получить("security");
	ЮТест.ОжидаетЧто(ГлобальныйSecurity).ИмеетТип("Массив");
	ЮТест.ОжидаетЧто(ГлобальныйSecurity[0].Получить("basicAuth")).НеРавно(Неопределено);
КонецПроцедуры

Процедура СовместимостьС30Комплексно() Экспорт
	Описание = Swag_Модель.НовоеОписание("API", "1.0");
	Описание = Swag_Модель.ДобавитьСхему(Описание, "N",
			Swag_Модель.СхемаЦелое()
			.ЭксклюзивныйМинимум(0)
			.ДопускаетNull()
			.Сформировать());

	Данные30 = Прочитать(Swag_СериализаторOpenAPI.Сериализовать(Описание, Истина));
	Данные31 = Прочитать(Swag_СериализаторOpenAPI.Сериализовать(Описание, Ложь));

	С30 = Данные30.Получить("components").Получить("schemas").Получить("N");
	С31 = Данные31.Получить("components").Получить("schemas").Получить("N");

	// В 3.0 - nullable: true и exclusiveMinimum: true
	ЮТест.ОжидаетЧто(С30.Получить("nullable")).ЭтоИстина();
	ЮТест.ОжидаетЧто(С30.Получить("minimum")).Равно(0);
	ЮТест.ОжидаетЧто(С30.Получить("exclusiveMinimum")).ЭтоИстина();

	// В 3.1 - type: ["integer", "null"] и exclusiveMinimum: 0
	ЮТест.ОжидаетЧто(С31.Получить("nullable")).Равно(Неопределено);
	Тип = С31.Получить("type");
	ЮТест.ОжидаетЧто(Тип).Содержит("integer");
	ЮТест.ОжидаетЧто(Тип).Содержит("null");
	ЮТест.ОжидаетЧто(С31.Получить("exclusiveMinimum")).Равно(0);
КонецПроцедуры

