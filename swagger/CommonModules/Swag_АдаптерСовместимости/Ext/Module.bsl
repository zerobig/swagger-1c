////////////////////////////////////////////////////////////////////////////////
// Swag_АдаптерСовместимости - превращает формат swagger-1c в модель Swag_Модель.
//
// Не меняет модули <Имя>Описание. Использует существующую прослойку
// Swag_ОбработкаHTTP для матчинга описаний с метаданными HTTP-сервисов.
////////////////////////////////////////////////////////////////////////////////

// ============ СХЕМЫ ============

Функция ПреобразоватьОбъекты(МассивОбъектов) Экспорт

	Результат = Новый Массив;
	Если МассивОбъектов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Объект Из МассивОбъектов Цикл
		Результат.Добавить(Новый Структура(
				"Имя, Значение",
				Объект.Имя,
				ПреобразоватьОбъектВСхему(Объект)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПреобразоватьОбъектВСхему(Объект) Экспорт

	Схема = Swag_Модель.СхемаОбъект();

	Описание = ПрочитатьПоле(Объект, "ОписаниеОбъекта");
	Если НЕ ПустаяСтрока(Описание) Тогда
		Схема.Описание(Описание);
	КонецЕсли;

	Обязательные = ПрочитатьПоле(Объект, "ОбязательныеПоля");
	Если ТипЗнч(Обязательные) = Тип("Строка") И НЕ ПустаяСтрока(Обязательные) Тогда
		Для Каждого ИмяПоля Из СтрРазделить(Обязательные, ",", Ложь) Цикл
			Если НЕ ПустаяСтрока(СокрЛП(ИмяПоля)) Тогда
				Схема.Требует(СокрЛП(ИмяПоля));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Свойства = ПрочитатьПоле(Объект, "МассивСвойств");
	Если ТипЗнч(Свойства) = Тип("Массив") Тогда
		Для Каждого Свойство Из Свойства Цикл
			Схема.Свойство(Свойство.Имя, ПреобразоватьСвойствоВСхему(Свойство));
		КонецЦикла;
	КонецЕсли;

	Возврат Схема.Сформировать();

КонецФункции

Функция ПреобразоватьСвойствоВСхему(Свойство) Экспорт

	Тип = ПрочитатьПоле(Свойство, "Тип");

	Если Тип = "string" Тогда
		Схема = Swag_Модель.СхемаСтрока();
	ИначеЕсли Тип = "integer" Тогда
		Схема = Swag_Модель.СхемаЦелое();
	ИначеЕсли Тип = "number" Тогда
		Схема = Swag_Модель.СхемаЧисло();
	ИначеЕсли Тип = "boolean" Тогда
		Схема = Swag_Модель.СхемаБулево();
	ИначеЕсли Тип = "array" Тогда
		Схема = Swag_Модель.СхемаМассив();
		СхемаЭлемента = ПреобразоватьСсылкуИлиОбъединение(
				ПрочитатьПоле(Свойство, "Схема"));
		Если СхемаЭлемента <> Неопределено Тогда
			Схема.Элемент(СхемаЭлемента);
		КонецЕсли;
	ИначеЕсли Тип = "object" Тогда
		СхемаОбъединения = ПреобразоватьСсылкуИлиОбъединение(
				ПрочитатьПоле(Свойство, "Схема"));
		Если СхемаОбъединения <> Неопределено Тогда
			Возврат СхемаОбъединения; // $ref или oneOf/anyOf/allOf - самодостаточен
		КонецЕсли;
		Схема = Swag_Модель.СхемаОбъект();
	Иначе
		ВызватьИсключение "Swag_АдаптерСовместимости: неизвестный тип '"
		+ Строка(Тип) + "' у свойства " + Свойство.Имя;
	КонецЕсли;

	// Модификаторы
	ПрименитьМодификаторы(Схема, Свойство);

	// Перечисление
	Перечисление = ПрочитатьПоле(Свойство, "Перечисление");
	Если ТипЗнч(Перечисление) = Тип("Массив") Тогда
		Для Каждого Значение Из Перечисление Цикл
			Схема.ЗначениеПеречисления(Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Схема.Сформировать();

КонецФункции

Процедура ПрименитьМодификаторы(Схема, Свойство)

	Если ПрочитатьПоле(Свойство, "Nullable") = Истина Тогда
		Схема.ДопускаетNull();
	КонецЕсли;

	Формат = ПрочитатьПоле(Свойство, "Формат");
	Если НЕ ПустаяСтрока(Формат) Тогда
		Схема.ФорматЗначения(Формат);
	КонецЕсли;

	Минимум = ПрочитатьПоле(Свойство, "Минимум");
	Если Минимум <> Неопределено Тогда
		Если ПрочитатьПоле(Свойство, "НеВключаяМинимум") = Истина Тогда
			Схема.ЭксклюзивныйМинимум(Минимум);
		Иначе
			Схема.Минимум(Минимум);
		КонецЕсли;
	КонецЕсли;

	Максимум = ПрочитатьПоле(Свойство, "Максимум");
	Если Максимум <> Неопределено Тогда
		Если ПрочитатьПоле(Свойство, "НеВключаяМаксимум") = Истина Тогда
			Схема.ЭксклюзивныйМаксимум(Максимум);
		Иначе
			Схема.Максимум(Максимум);
		КонецЕсли;
	КонецЕсли;

	МаксДлина = ПрочитатьПоле(Свойство, "МаксимальнаяДлина");
	Если МаксДлина <> Неопределено Тогда
		Схема.МаксДлина(МаксДлина);
	КонецЕсли;

	МинДлина = ПрочитатьПоле(Свойство, "МинимальнаяДлина");
	Если МинДлина <> Неопределено Тогда
		Схема.МинДлина(МинДлина);
	КонецЕсли;

	ПоУмолчанию = ПрочитатьПоле(Свойство, "ПоУмолчанию");
	Если ПоУмолчанию <> Неопределено Тогда
		Схема.ЗначениеПоУмолчанию(ПоУмолчанию);
	КонецЕсли;

	Пример = ПрочитатьПоле(Свойство, "Пример");
	Если Пример <> Неопределено Тогда
		Схема.Пример(Пример);
	КонецЕсли;

	Описание = ПрочитатьПоле(Свойство, "Описание");
	Если НЕ ПустаяСтрока(Описание) Тогда
		Схема.Описание(Описание);
	КонецЕсли;

КонецПроцедуры

// Возвращает схему из "Схема"-поля: строка ($ref) или Структура (объединение).
// Используется в properties (array/object) и в MIME-типах.
Функция ПреобразоватьСсылкуИлиОбъединение(Схема) Экспорт

	Если Схема = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Схема) = Тип("Строка") Тогда
		// "#/components/schemas/Имя" или "Имя"
		Возврат Swag_Модель.СхемаСсылка(ИзвлечьИмяСхемы(Схема));
	КонецЕсли;

	// Структура: {СпособОбъединенияСхем, МассивТиповСхемы}
	Способ = Схема.СпособОбъединенияСхем;
	Типы = Схема.МассивТиповСхемы;

	Если Способ = "oneOf" Тогда
		Объединение = Swag_Модель.СхемаOneOf();
	ИначеЕсли Способ = "anyOf" Тогда
		Объединение = Swag_Модель.СхемаAnyOf();
	ИначеЕсли Способ = "allOf" Тогда
		Объединение = Swag_Модель.СхемаAllOf();
	Иначе
		ВызватьИсключение "Swag_АдаптерСовместимости: неизвестный способ объединения '"
		+ Строка(Способ) + "'";
	КонецЕсли;

	Для Каждого Тип Из Типы Цикл
		Объединение.Вариант(Swag_Модель.СхемаСсылка(ИзвлечьИмяСхемы(Тип)));
	КонецЦикла;

	Возврат Объединение.Сформировать();

КонецФункции

// ============ ОПЕРАЦИИ ============

// Собирает операции для одного HTTP-сервиса.
//
// Параметры:
//   HTTPСервис     - ОбъектМетаданных - HTTPСервис из Метаданные.HTTPСервисы
//   МодульОписания - ОбщийМодуль - <Имя>Описание
//
// Возвращаемое значение:
//   Массив из Структура - готовые операции (Swag_Операция.Сформировать)
//
Функция ПреобразоватьМетоды(HTTPСервис, МодульОписания, МассивМетодов) Экспорт

	Результат = Новый Массив;
	НаименованиеТега = ?(ЗначениеЗаполнено(HTTPСервис.Синоним),
			HTTPСервис.Синоним, HTTPСервис.Имя);

	Для Каждого ШаблонURL Из HTTPСервис.ШаблоныURL Цикл
		Для Каждого Метод Из ШаблонURL.Методы Цикл

			Ключ = ШаблонURL.Имя + Метод.HTTPМетод;
			URL = "/" + HTTPСервис.КорневойURL + ШаблонURL.Шаблон;
			HTTPМетод = НРег(Метод.HTTPМетод);

			// Один сломанный метод не должен убивать остальные
			Попытка
				Операция = Swag_Модель.НоваяОперация(HTTPМетод, URL)
					.Тег(НаименованиеТега)
					.OperationId(ПостроитьOperationId(HTTPСервис.Имя, Ключ));

				ЗаполнитьОписание(Операция, МассивМетодов, Ключ);
				ЗаполнитьПараметры(Операция, МассивМетодов, Ключ);
				ЗаполнитьТелоЗапроса(Операция, МассивМетодов, Ключ);
				ЗаполнитьОтветы(Операция, МассивМетодов, Ключ);

				Результат.Добавить(Операция.Сформировать());
			Исключение
				ЗаписатьОшибкуМетода(HTTPСервис.Имя, Метод.HTTPМетод, URL,
					ИнформацияОбОшибке());
			КонецПопытки;

		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьОписание(Операция, МассивМетодов, Ключ)

	Описание = Swag_ОбработкаHTTP.ПолучитьЗначениеОписанияМетода(
			МассивМетодов, Ключ, "Описание");

	Если НЕ ЗначениеЗаполнено(Описание) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Если Описание.Свойство("Описание") И НЕ ПустаяСтрока(Описание.Описание) Тогда
			Операция.КраткоеОписание(Описание.Описание);
		КонецЕсли;
		Если Описание.Свойство("ДетальноеОписание")
			И НЕ ПустаяСтрока(Описание.ДетальноеОписание) Тогда
			Операция.Описание(Описание.ДетальноеОписание);
		КонецЕсли;
	Иначе
		Операция.КраткоеОписание(Описание);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПараметры(Операция, МассивМетодов, Ключ)

	Параметры = Swag_ОбработкаHTTP.ПолучитьМассивЭлементовОписания(
			МассивМетодов, Ключ, "Параметры");

	Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Параметр Из Параметры Цикл
		Операция.Параметр(
			Параметр.Имя,
			Параметр.ТипПараметра,
			ПреобразоватьПараметрВСхему(Параметр),
			?(Параметр.Свойство("Описание") И НЕ ПустаяСтрока(Параметр.Описание),
				Параметр.Описание, Неопределено),
			?(Параметр.Свойство("Обязательный"), Параметр.Обязательный, Ложь)
		);
	КонецЦикла;

КонецПроцедуры

Функция ПреобразоватьПараметрВСхему(Параметр)

	ТипЗначения = ПрочитатьПоле(Параметр, "ТипЗначения");

	Если ТипЗначения = "string" Тогда
		Схема = Swag_Модель.СхемаСтрока();
	ИначеЕсли ТипЗначения = "integer" Тогда
		Схема = Swag_Модель.СхемаЦелое();
	ИначеЕсли ТипЗначения = "number" Тогда
		Схема = Swag_Модель.СхемаЧисло();
	ИначеЕсли ТипЗначения = "boolean" Тогда
		Схема = Swag_Модель.СхемаБулево();
	ИначеЕсли ТипЗначения = "array" Тогда
		Схема = Swag_Модель.СхемаМассив();
	Иначе
		Схема = Swag_Модель.СхемаСтрока();
	КонецЕсли;

	МаксДлина = ПрочитатьПоле(Параметр, "МаксимальнаяДлина");
	Если МаксДлина <> Неопределено Тогда
		Схема.МаксДлина(МаксДлина);
	КонецЕсли;

	МинДлина = ПрочитатьПоле(Параметр, "МинимальнаяДлина");
	Если МинДлина <> Неопределено Тогда
		Схема.МинДлина(МинДлина);
	КонецЕсли;

	Перечисление = ПрочитатьПоле(Параметр, "Перечисление");
	Если ТипЗнч(Перечисление) = Тип("Массив") Тогда
		Для Каждого Значение Из Перечисление Цикл
			Схема.ЗначениеПеречисления(Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Схема.Сформировать();

КонецФункции

Процедура ЗаполнитьТелоЗапроса(Операция, МассивМетодов, Ключ)

	ТелоЗапроса = Swag_ОбработкаHTTP.ПолучитьЗначениеОписанияМетода(
			МассивМетодов, Ключ, "ТелоЗапроса");

	Если НЕ ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат;
	КонецЕсли;

	МассивТиповMIME = ПрочитатьПоле(ТелоЗапроса, "МассивТиповMIME");
	Если ТипЗнч(МассивТиповMIME) <> Тип("Массив")
		ИЛИ МассивТиповMIME.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// В OpenAPI тело запроса может иметь несколько MIME-типов.
	// Наша модель Swag_Операция.ТелоЗапроса() принимает одну схему.
	// Берём первый MIME (обычно application/json).
	ПервыйMIME = МассивТиповMIME[0];
	Схема = ПреобразоватьMIMEВСхему(ПервыйMIME);
	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Операция.ТелоЗапроса(Схема,
		?(ТелоЗапроса.Свойство("Описание") И НЕ ПустаяСтрока(ТелоЗапроса.Описание),
			ТелоЗапроса.Описание, Неопределено),
		ПервыйMIME.Заголовок);

КонецПроцедуры

Процедура ЗаполнитьОтветы(Операция, МассивМетодов, Ключ)

	Ответы = Swag_ОбработкаHTTP.ПолучитьМассивЭлементовОписания(
			МассивМетодов, Ключ, "Ответы");

	Если ТипЗнч(Ответы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Ответ Из Ответы Цикл

		ОписаниеОтвета = ?(Ответ.Свойство("Описание"), Ответ.Описание, "");
		МассивТиповMIME = ПрочитатьПоле(Ответ, "МассивТиповMIME");

		Если ТипЗнч(МассивТиповMIME) <> Тип("Массив")
			ИЛИ МассивТиповMIME.Количество() = 0 Тогда
			// Ответ без тела - только описание
			Операция.Ответ(Ответ.Код, ОписаниеОтвета);
			Продолжить;
		КонецЕсли;

		ПервыйMIME = МассивТиповMIME[0];
		Схема = ПреобразоватьMIMEВСхему(ПервыйMIME);

		Если Схема = Неопределено Тогда
			Операция.Ответ(Ответ.Код, ОписаниеОтвета);
		Иначе
			Операция.Ответ(Ответ.Код, ОписаниеОтвета, Схема, ПервыйMIME.Заголовок);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Преобразует MIME-структуру в схему (для тела и ответа).
Функция ПреобразоватьMIMEВСхему(MIME)

	Тип = ПрочитатьПоле(MIME, "Тип");
	Схема = ПрочитатьПоле(MIME, "Схема");

	Если Тип = "array" Тогда
		СхемаЭлемента = ПреобразоватьСсылкуИлиОбъединение(Схема);
		Если СхемаЭлемента <> Неопределено Тогда
			Возврат Swag_Модель.СхемаМассив(СхемаЭлемента).Сформировать();
		КонецЕсли;
		Возврат Swag_Модель.СхемаМассив().Сформировать();
	КонецЕсли;

	Возврат ПреобразоватьСсылкуИлиОбъединение(Схема);

КонецФункции

// ИмяСервиса + "_" + Ключ (например "Заказы_СоздатьPOST").
// Кириллица разрешена спецификацией OpenAPI 3.1.
Функция ПостроитьOperationId(ИмяСервиса, Ключ) Экспорт
	Возврат ИмяСервиса + "_" + Ключ;
КонецФункции

// ============ JSON-RPC (OpenRPC) ============

// Преобразует метод из формата <Имя>Описание в OpenRPC-метод.
//
// Параметры:
//   Метод - Структура - элемент массива ПолучитьОписаниеHTTPСервиса()
//
// Возвращаемое значение:
//   Структура - {name, summary, description, params, result}
//   или Неопределено, если у метода нет параметров с типом "json-rpc".
//
Функция ПреобразоватьМетодJSONRPC(Метод) Экспорт

	ИмяМетода = ПрочитатьПоле(Метод, "Имя");
	Если ПустаяСтрока(ИмяМетода) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("name", ИмяМетода);

	// Summary и Description - как в существующем адаптере
	Описание = ПрочитатьПоле(Метод, "Описание");
	Если ТипЗнч(Описание) = Тип("Структура") Тогда
		Результат.Вставить("summary", ПрочитатьПоле(Описание, "Описание"));
		Результат.Вставить("description",
			ПрочитатьПоле(Описание, "ДетальноеОписание"));
	Иначе
		Результат.Вставить("summary", Описание);
		Результат.Вставить("description", Неопределено);
	КонецЕсли;

	Params = Новый Массив;
	ПараметрыМетода = ПрочитатьПоле(Метод, "Параметры");
	Если ТипЗнч(ПараметрыМетода) = Тип("Массив") Тогда
		Для Каждого Параметр Из ПараметрыМетода Цикл
			Params.Добавить(ПреобразоватьJSONRPCПараметр(Параметр));
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("params", Params);

	// В OpenRPC у методов с параметрами структура params - именованная.
	// Это соответствует тому, как <Имя>Описание создаёт параметры через
	// .ПараметрЗапроса() / .ПараметрURL() / .ПараметрЗаголовка().
	Если Params.Количество() > 0 Тогда
		Результат.Вставить("paramStructure", "by-name");
	КонецЕсли;

	// Result - из ответа 200
	Результат.Вставить("result", ПреобразоватьJSONRPCРезультат(Метод));

	Возврат Результат;

КонецФункции

// Преобразует параметр JSON-RPC-метода.
Функция ПреобразоватьJSONRPCПараметр(Параметр) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("name", ПрочитатьПоле(Параметр, "Имя"));
	Результат.Вставить("description", ПрочитатьПоле(Параметр, "Описание"));
	Результат.Вставить("required",
		ПрочитатьПоле(Параметр, "Обязательный") = Истина);
	Результат.Вставить("schema", СхемаИзJSONRPCПараметра(Параметр));
	Возврат Результат;

КонецФункции

// Формирует JSON Schema из полей параметра.
// Используется тот же подход, что и в ПреобразоватьПараметрВСхему для HTTP,
// но без привязки к location/in.
Функция СхемаИзJSONRPCПараметра(Параметр) Экспорт

	ТипЗначения = ПрочитатьПоле(Параметр, "ТипЗначения");
	Схема = Новый Соответствие;

	Если НЕ ПустаяСтрока(ТипЗначения) Тогда
		Схема.Вставить("type", НРег(ТипЗначения));
	КонецЕсли;

	МинимальнаяДлина = ПрочитатьПоле(Параметр, "МинимальнаяДлина");
	Если МинимальнаяДлина <> Неопределено Тогда
		Схема.Вставить("minLength", МинимальнаяДлина);
	КонецЕсли;

	МаксимальнаяДлина = ПрочитатьПоле(Параметр, "МаксимальнаяДлина");
	Если МаксимальнаяДлина <> Неопределено Тогда
		Схема.Вставить("maxLength", МаксимальнаяДлина);
	КонецЕсли;

	Перечисление = ПрочитатьПоле(Параметр, "Перечисление");
	Если ТипЗнч(Перечисление) = Тип("Массив") И Перечисление.Количество() > 0 Тогда
		Схема.Вставить("enum", Перечисление);
	КонецЕсли;

	Возврат Схема;

КонецФункции

// Преобразует ответ 200 в result OpenRPC-метода.
Функция ПреобразоватьJSONRPCРезультат(Метод) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("name", "result");

	Ответы = ПрочитатьПоле(Метод, "Ответы");
	Если ТипЗнч(Ответы) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Ответ Из Ответы Цикл
		Если ПрочитатьПоле(Ответ, "Код") <> 200 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить("description", ПрочитатьПоле(Ответ, "Описание"));

		МассивMIME = ПрочитатьПоле(Ответ, "МассивТиповMIME");
		Если ТипЗнч(МассивMIME) = Тип("Массив") И МассивMIME.Количество() > 0 Тогда
			Схема = ПрочитатьПоле(МассивMIME[0], "Схема");
			Если Схема <> Неопределено Тогда
				Результат.Вставить("schema", СхемаВФорматOpenRPC(Схема));
			КонецЕсли;
		КонецЕсли;

		Прервать;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция ИзвлечьИмяСхемы(Ссылка)
	Префикс = "#/components/schemas/";
	Если Лев(Ссылка, СтрДлина(Префикс)) = Префикс Тогда
		Возврат Сред(Ссылка, СтрДлина(Префикс) + 1);
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ПрочитатьПоле(Коллекция, Имя)
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Коллекция);
	Если ТипЗначения = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ЗаписатьОшибкуМетода(ИмяСервиса, HTTPМетод, URL, ИнформацияОбОшибке)
	ЗаписьЖурналаРегистрации(
		"Swagger: Сборка модели OpenAPI",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		СтрШаблон(
			"HTTP-сервис ""%1"", метод %2 %3 пропущен: %4",
			ИмяСервиса, ВРег(HTTPМетод), URL,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)));
КонецПроцедуры

// Приводит схему из формата Swag_ФормированиеОписаний к формату JSON Schema
// для OpenRPC. Строка "#/components/schemas/X" превращается в {$ref: ...},
// структура объединения - в {oneOf|anyOf|allOf: [{$ref: ...}, ...]}.
Функция СхемаВФорматOpenRPC(Схема) Экспорт

	Если Схема = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Схема) = Тип("Строка") Тогда
		Результат = Новый Соответствие;
		Результат.Вставить("ref", Схема); // сериализатор сделает $ref
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Схема) = Тип("Структура")
		И Схема.Свойство("СпособОбъединенияСхем") Тогда
		МассивСхем = Новый Массив;
		Для Каждого Элемент Из Схема.МассивТиповСхемы Цикл
			Реф = Новый Соответствие;
			Реф.Вставить("ref", Элемент); // сериализатор сделает $ref
			МассивСхем.Добавить(Реф);
		КонецЦикла;
		Результат = Новый Соответствие;
		Результат.Вставить(Схема.СпособОбъединенияСхем, МассивСхем);
		Возврат Результат;
	КонецЕсли;

	Возврат Схема;

КонецФункции
