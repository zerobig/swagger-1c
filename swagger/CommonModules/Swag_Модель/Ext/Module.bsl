// ============ ВАЛИДАТОР СХЕМЫ ============

Процедура ПроверитьSchema(Схема, Путь, Описание, Ошибки) Экспорт

	ТипЗначения = ТипЗнч(Схема);
	Если ТипЗначения <> Тип("Структура") И ТипЗначения <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, "SCHEMA_NOT_STRUCTURE",
			"Схема должна быть структурой или соответствием", Схема);
		Возврат;
	КонецЕсли;

	// $ref - если задан, дальше не проверяем
	Ссылка = ПолучитьПоле(Схема, "ref");
	Если Ссылка <> Неопределено Тогда
		ПроверитьСсылку(Ссылка, Путь, Описание, Ошибки);
		Возврат;
	КонецЕсли;

	Тип = ПолучитьПоле(Схема, "type");
	Если Тип <> Неопределено И НЕ ДопустимыйТип(Тип) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".type", "SCHEMA_TYPE_INVALID",
			"Недопустимый type: " + Строка(Тип), Тип);
		Возврат; // остальные проверки зависят от типа
	КонецЕсли;

	// Nullable без type
	Если ПолучитьПоле(Схема, "nullable") = Истина И Тип = Неопределено Тогда
		ДобавитьОшибку(Ошибки, Путь + ".nullable", "SCHEMA_NULLABLE_WITHOUT_TYPE",
			"Поле nullable требует явного type", Неопределено);
	КонецЕсли;

	// Array
	Если Тип = "array" Тогда
		Элементы = ПолучитьПоле(Схема, "items");
		Если Элементы = Неопределено Тогда
			ДобавитьОшибку(Ошибки, Путь + ".items", "SCHEMA_ARRAY_ITEMS_MISSING",
				"Для type=array обязателен items", Неопределено);
		Иначе
			ПроверитьSchema(Элементы, Путь + ".items", Описание, Ошибки);
		КонецЕсли;
	КонецЕсли;

	// Object
	Если Тип = "object" Тогда
		ПроверитьОбъектнуюСхему(Схема, Путь, Описание, Ошибки);
	КонецЕсли;

	// Эксклюзивные границы - числа
	ПроверитьЧисловоеПоле(Схема, "exclusiveMinimum", Путь, Ошибки);
	ПроверитьЧисловоеПоле(Схема, "exclusiveMaximum", Путь, Ошибки);

	// Enum
	Перечисление = ПолучитьПоле(Схема, "enum");
	Если Перечисление <> Неопределено Тогда
		Если ТипЗнч(Перечисление) <> Тип("Массив") ИЛИ Перечисление.Количество() = 0 Тогда
			ДобавитьОшибку(Ошибки, Путь + ".enum", "SCHEMA_ENUM_EMPTY",
				"enum должен быть непустым массивом", Неопределено);
		КонецЕсли;
	КонецЕсли;

	// oneOf / anyOf / allOf
	Для Каждого КлючВариантов Из СтрРазделить("oneOf,anyOf,allOf", ",") Цикл
		Варианты = ПолучитьПоле(Схема, КлючВариантов);
		Если Варианты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Варианты) <> Тип("Массив") ИЛИ Варианты.Количество() = 0 Тогда
			ДобавитьОшибку(Ошибки, Путь + "." + КлючВариантов, "SCHEMA_ONE_OF_EMPTY",
				КлючВариантов + " должен быть непустым массивом схем", Неопределено);
		Иначе
			Для Индекс = 0 По Варианты.Количество() - 1 Цикл
				ПроверитьSchema(Варианты[Индекс],
					Путь + "." + КлючВариантов + "[" + Индекс + "]", Описание, Ошибки);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ВАЛИДАТОРА ============

Процедура ПроверитьСсылку(Ссылка, Путь, Описание, Ошибки)
	Если ТипЗнч(Ссылка) <> Тип("Строка") Тогда
		ДобавитьОшибку(Ошибки, Путь + ".ref", "SCHEMA_REF_INVALID_FORMAT",
			"$ref должен быть строкой", Ссылка);
		Возврат;
	КонецЕсли;
	Префикс = "#/components/schemas/";
	Если Лев(Ссылка, СтрДлина(Префикс)) <> Префикс Тогда
		ДобавитьОшибку(Ошибки, Путь + ".ref", "SCHEMA_REF_INVALID_FORMAT",
			"Ссылка должна начинаться с " + Префикс, Ссылка);
		Возврат;
	КонецЕсли;
	Если Описание = Неопределено Тогда
		Возврат; // валидируем схему вне контекста описания - не проверяем существование
	КонецЕсли;
	ИмяСхемы = Сред(Ссылка, СтрДлина(Префикс) + 1);
	Если НЕ СуществуетСхема(Описание, ИмяСхемы) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".ref", "SCHEMA_REF_NOT_FOUND",
			"Схема не найдена: " + ИмяСхемы, ИмяСхемы);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОбъектнуюСхему(Схема, Путь, Описание, Ошибки)
	Свойства = ПолучитьПоле(Схема, "properties");
	Если Свойства = Неопределено ИЛИ ТипЗнч(Свойства) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь + ".properties", "SCHEMA_OBJECT_PROPERTIES_MISSING",
			"Для type=object обязателен properties (Соответствие)", Неопределено);
		Возврат;
	КонецЕсли;

	Для Каждого Свойство Из Свойства Цикл
		ПроверитьSchema(Свойство.Значение,
			Путь + ".properties." + Свойство.Ключ, Описание, Ошибки);
	КонецЦикла;

	Требуемые = ПолучитьПоле(Схема, "required");
	Если Требуемые = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Требуемые) <> Тип("Массив") Тогда
		ДобавитьОшибку(Ошибки, Путь + ".required", "SCHEMA_OBJECT_REQUIRED_INVALID",
			"required должен быть массивом строк", Требуемые);
		Возврат;
	КонецЕсли;

	Для Каждого ИмяПоля Из Требуемые Цикл
		Если НЕ СодержитКлюч(Свойства, ИмяПоля) Тогда
			ДобавитьОшибку(Ошибки, Путь + ".required", "SCHEMA_OBJECT_REQUIRED_INVALID",
				"Поле '" + ИмяПоля + "' указано в required, но отсутствует в properties",
				ИмяПоля);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьЧисловоеПоле(Схема, ИмяПоля, Путь, Ошибки)
	Значение = ПолучитьПоле(Схема, ИмяПоля);
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		ДобавитьОшибку(Ошибки, Путь + "." + ИмяПоля, "SCHEMA_EXCLUSIVE_BOOLEAN",
			ИмяПоля + " должен быть числом (в OpenAPI 3.1)", Значение);
	КонецЕсли;
КонецПроцедуры

Функция ДопустимыйТип(Тип)
	Возврат СтрНайти(",string,integer,number,boolean,array,object,", "," + Тип + ",") > 0;
КонецФункции

Функция СуществуетСхема(Описание, ИмяСхемы)
	Компоненты = ПолучитьПоле(Описание, "components");
	Если Компоненты = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Схемы = ПолучитьПоле(Компоненты, "schemas");
	Если Схемы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СодержитКлюч(Схемы, ИмяСхемы);
КонецФункции

Функция СодержитКлюч(Коллекция, Ключ)
	Если ТипЗнч(Коллекция) = Тип("Структура") Тогда
		Возврат Коллекция.Свойство(Ключ);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Коллекция Цикл
			Если Элемент.Ключ = Ключ Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ПолучитьПоле(Коллекция, Имя)
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Коллекция);
	Если ТипЗначения = Тип("Структура") Тогда
		Значение = Неопределено;
		Коллекция.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// ============ ОПИСАНИЕ API ============

// Создаёт корневую структуру ОписаниеAPI с пустыми путями и компонентами.
Функция НовоеОписание(Title, Version) Экспорт

	Описание = Новый Структура;
	Описание.Вставить("openapi", "3.1.0");

	Инфо = Новый Структура("title, version", Title, Version);
	Описание.Вставить("info", Инфо);

	Описание.Вставить("paths", Новый Соответствие);

	Компоненты = Новый Структура;
	Компоненты.Вставить("schemas", Новый Соответствие);
	Компоненты.Вставить("securitySchemes", Новый Соответствие); // ← добавлено
	Описание.Вставить("components", Компоненты);

	Описание.Вставить("servers", Новый Массив);
	Описание.Вставить("tags", Новый Массив);

	Возврат Описание;

КонецФункции

// Добавляет схему в components.schemas. Принимает билдер Swag_Схема или готовую Структуру.
Функция ДобавитьСхему(Описание, Имя, Схема) Экспорт

	Развернутая = РазвернутьСхемуВСтруктуру(Схема, "ДобавитьСхему '" + Имя + "'");
	Описание.components.schemas.Вставить(Имя, Развернутая);
	Возврат Описание;

КонецФункции

// Добавляет операцию в paths. Принимает билдер Swag_Операция или готовую Структуру.
Функция ДобавитьОперацию(Описание, Операция) Экспорт

	Готовая = РазвернутьСхемуВСтруктуру(Операция, "ДобавитьОперацию");
	Путь = Готовая.path;
	Метод = Готовая.method;

	PathItem = Описание.paths.Получить(Путь);
	Если PathItem = Неопределено Тогда
		PathItem = Новый Структура;
		Описание.paths.Вставить(Путь, PathItem);
	КонецЕсли;

	// Убираем method и path из Operation - они уже на уровне PathItem
	ОперацияБезПути = Новый Структура;
	Для Каждого Поле Из Готовая Цикл
		Если Поле.Ключ = "method" ИЛИ Поле.Ключ = "path" Тогда
			Продолжить;
		КонецЕсли;
		ОперацияБезПути.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	PathItem.Вставить(Метод, ОперацияБезПути);

	Возврат Описание;

КонецФункции

Функция НоваяОперация(Method, Путь) Экспорт
	Операция = Обработки.Swag_Операция.Создать();
	Операция.Инициализировать(Method, Путь);
	Возврат Операция;
КонецФункции

// Добавляет сервер.
Функция ДобавитьСервер(Описание, URL, ОписаниеСервера = Неопределено) Экспорт
	Сервер = Новый Структура("url", URL);
	Если ОписаниеСервера <> Неопределено Тогда
		Сервер.Вставить("description", ОписаниеСервера);
	КонецЕсли;
	Описание.servers.Добавить(Сервер);
	Возврат Описание;
КонецФункции

// Добавляет тег.
Функция ДобавитьТег(Описание, Имя, ОписаниеТега = Неопределено) Экспорт
	Тег = Новый Структура("name", Имя);
	Если ОписаниеТега <> Неопределено Тогда
		Тег.Вставить("description", ОписаниеТега);
	КонецЕсли;
	Описание.tags.Добавить(Тег);
	Возврат Описание;
КонецФункции

// ============ SECURITY: ФАБРИКИ ============
//
// SecurityScheme - это Структура с полями OpenAPI. Исключение - ключ "in":
// в 1С "in" - английское ключевое слово, поэтому внутри модели используется
// "location". Swag_СериализаторOpenAPI выполняет обратную подмену "location" → "in".

// Basic Authentication: {type: "http", scheme: "basic"}
Функция SecurityBasic(Описание = Неопределено) Экспорт

	Схема = Новый Структура;
	Схема.Вставить("type", "http");
	Схема.Вставить("scheme", "basic");
	Если Описание <> Неопределено Тогда
		Схема.Вставить("description", Описание);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// Bearer (JWT): {type: "http", scheme: "bearer", bearerFormat: "JWT"}
Функция SecurityBearer(Описание = Неопределено, BearerFormat = "JWT") Экспорт

	Схема = Новый Структура;
	Схема.Вставить("type", "http");
	Схема.Вставить("scheme", "bearer");
	Если BearerFormat <> Неопределено Тогда
		Схема.Вставить("bearerFormat", BearerFormat);
	КонецЕсли;
	Если Описание <> Неопределено Тогда
		Схема.Вставить("description", Описание);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// API Key: {type: "apiKey", name: "...", in: "header|query|cookie"}
Функция SecurityApiKey(Имя, Расположение, Описание = Неопределено) Экспорт

	Если НЕ ЭтоОдноиз(Расположение, "header,query,cookie") Тогда
		ВызватьИсключение
		"SecurityApiKey: расположение должно быть одним из: header, query, cookie";
	КонецЕсли;

	Схема = Новый Структура;
	Схема.Вставить("type", "apiKey");
	Схема.Вставить("name", Имя);
	Схема.Вставить("location", Расположение); // ← не "in"
	Если Описание <> Неопределено Тогда
		Схема.Вставить("description", Описание);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// OAuth 2.0 - Client Credentials (machine-to-machine)
// Scopes - Массив из Строка, например ["read", "write"]
Функция SecurityOAuth2ClientCredentials(TokenURL, Scopes, Описание = Неопределено) Экспорт

	Flow = Новый Структура;
	Flow.Вставить("tokenUrl", TokenURL);
	Flow.Вставить("scopes", ПостроитьScopes(Scopes));

	Flows = Новый Структура;
	Flows.Вставить("clientCredentials", Flow);

	Схема = Новый Структура;
	Схема.Вставить("type", "oauth2");
	Схема.Вставить("flows", Flows);
	Если Описание <> Неопределено Тогда
		Схема.Вставить("description", Описание);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// OAuth 2.0 - Authorization Code (интерактивный)
Функция SecurityOAuth2AuthorizationCode(AuthorizationURL, TokenURL, Scopes, Описание = Неопределено) Экспорт

	Flow = Новый Структура;
	Flow.Вставить("authorizationUrl", AuthorizationURL);
	Flow.Вставить("tokenUrl", TokenURL);
	Flow.Вставить("scopes", ПостроитьScopes(Scopes));

	Flows = Новый Структура;
	Flows.Вставить("authorizationCode", Flow);

	Схема = Новый Структура;
	Схема.Вставить("type", "oauth2");
	Схема.Вставить("flows", Flows);
	Если Описание <> Неопределено Тогда
		Схема.Вставить("description", Описание);
	КонецЕсли;
	Возврат Схема;

КонецФункции

// ============ SECURITY: ДОБАВЛЕНИЕ В ОПИСАНИЕ ============

// Регистрирует security-схему в components.securitySchemes.
Функция ДобавитьSecurityScheme(Описание, Имя, Схема) Экспорт

	Если НЕ Описание.components.Свойство("securitySchemes") Тогда
		Описание.components.Вставить("securitySchemes", Новый Соответствие);
	КонецЕсли;
	Описание.components.securitySchemes.Вставить(Имя, Схема);
	Возврат Описание;

КонецФункции

// Устанавливает глобальный security (применяется ко всем операциям,
// где не переопределён через Operation.ТребуетSecurity / БезSecurity).
Функция УстановитьГлобальныйSecurity(Описание, Имя, Scopes = Неопределено) Экспорт

	Если Scopes = Неопределено Тогда
		Scopes = Новый Массив;
	КонецЕсли;

	Требование = Новый Соответствие;
	Требование.Вставить(Имя, Scopes);

	Security = Новый Массив;
	Security.Добавить(Требование);
	Описание.Вставить("security", Security);
	Возврат Описание;

КонецФункции

// ============ SECURITY: ВАЛИДАТОР ============

Процедура ПроверитьSecuritySchemes(Компоненты, Ошибки)

	Если Компоненты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Схемы = ПолучитьПоле(Компоненты, "securitySchemes");
	Если Схемы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Схемы) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, "components.securitySchemes",
			"COMPONENTS_SECURITY_SCHEMES_INVALID",
			"securitySchemes должен быть Соответствием", Схемы);
		Возврат;
	КонецЕсли;

	Для Каждого Схема Из Схемы Цикл
		ПроверитьSecurityScheme(Схема.Ключ, Схема.Значение, Ошибки);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьSecurityScheme(Имя, Схема, Ошибки)

	Путь = "components.securitySchemes." + Имя;

	Если ТипЗнч(Схема) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, Путь, "SEC_SCHEME_NOT_STRUCTURE",
			"SecurityScheme должен быть Структурой", Схема);
		Возврат;
	КонецЕсли;

	Тип = ПолучитьПоле(Схема, "type");
	Если Тип = Неопределено ИЛИ НЕ ЭтоОдноиз(Тип, "http,apiKey,oauth2") Тогда
		ДобавитьОшибку(Ошибки, Путь + ".type", "SEC_SCHEME_TYPE_INVALID",
			"type должен быть одним из: http, apiKey, oauth2", Тип);
		Возврат;
	КонецЕсли;

	Если Тип = "http" Тогда
		ПроверитьSecurityHTTP(Схема, Путь, Ошибки);
	ИначеЕсли Тип = "apiKey" Тогда
		ПроверитьSecurityApiKey(Схема, Путь, Ошибки);
	ИначеЕсли Тип = "oauth2" Тогда
		ПроверитьSecurityOAuth2(Схема, Путь, Ошибки);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьSecurityHTTP(Схема, Путь, Ошибки)

	HTTPСхема = ПолучитьПоле(Схема, "scheme");
	Если HTTPСхема = Неопределено ИЛИ НЕ ЭтоОдноиз(HTTPСхема, "basic,bearer") Тогда
		ДобавитьОшибку(Ошибки, Путь + ".scheme", "SEC_SCHEME_HTTP_SCHEME_MISSING",
			"scheme должен быть одним из: basic, bearer", HTTPСхема);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьSecurityApiKey(Схема, Путь, Ошибки)

	ИмяКлюча = ПолучитьПоле(Схема, "name");
	Если ИмяКлюча = Неопределено ИЛИ ПустаяСтрока(Строка(ИмяКлюча)) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".name", "SEC_SCHEME_APIKEY_NAME_MISSING",
			"name обязателен для apiKey", ИмяКлюча);
	КонецЕсли;

	Расположение = ПолучитьПоле(Схема, "location");
	Если Расположение = Неопределено ИЛИ НЕ ЭтоОдноиз(Расположение, "header,query,cookie") Тогда
		ДобавитьОшибку(Ошибки, Путь + ".location", "SEC_SCHEME_APIKEY_LOCATION_INVALID",
			"location (in) должен быть одним из: header, query, cookie", Расположение);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьSecurityOAuth2(Схема, Путь, Ошибки)

	Flows = ПолучитьПоле(Схема, "flows");
	Если Flows = Неопределено ИЛИ ТипЗнч(Flows) <> Тип("Структура")
		ИЛИ Flows.Количество() = 0 Тогда
		ДобавитьОшибку(Ошибки, Путь + ".flows", "SEC_SCHEME_OAUTH2_FLOWS_MISSING",
			"flows обязателен для oauth2 и не может быть пустым", Flows);
		Возврат;
	КонецЕсли;

	Для Каждого Flow Из Flows Цикл
		ПутьFlow = Путь + ".flows." + Flow.Ключ;
		Если ТипЗнч(Flow.Значение) <> Тип("Структура") Тогда
			ДобавитьОшибку(Ошибки, ПутьFlow, "SEC_SCHEME_OAUTH2_FLOWS_MISSING",
				"flow должен быть Структурой", Flow.Значение);
			Продолжить;
		КонецЕсли;
		Scopes = ПолучитьПоле(Flow.Значение, "scopes");
		Если Scopes = Неопределено ИЛИ ТипЗнч(Scopes) <> Тип("Соответствие") Тогда
			ДобавитьОшибку(Ошибки, ПутьFlow + ".scopes", "SEC_SCHEME_OAUTH2_SCOPES_MISSING",
				"scopes обязателен и должен быть Соответствием", Scopes);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Проверяет массив security (глобальный или на операции).
// ПрефиксКода: "GLOBAL_SECURITY" или "OPERATION_SECURITY".
Процедура ПроверитьSecurity(Значение, Путь, Описание, Ошибки, ПрефиксКода)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ДобавитьОшибку(Ошибки, Путь, ПрефиксКода + "_NOT_ARRAY",
			"security должен быть массивом", Значение);
		Возврат;
	КонецЕсли;

	ИменаSecurity = ПолучитьИменаSecurity(Описание);

	Для Индекс = 0 По Значение.Количество() - 1 Цикл
		Требование = Значение[Индекс];
		ПутьТребования = Путь + "[" + Индекс + "]";

		Если ТипЗнч(Требование) <> Тип("Соответствие") Тогда
			ДобавитьОшибку(Ошибки, ПутьТребования, ПрефиксКода + "_NOT_ARRAY",
				"элемент security должен быть Соответствием", Требование);
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяScheme Из Требование Цикл
			Если НЕ СодержитИмя(ИменаSecurity, ИмяScheme.Ключ) Тогда
				ДобавитьОшибку(Ошибки, ПутьТребования, ПрефиксКода + "_UNKNOWN_NAME",
					"Схема аутентификации не зарегистрирована: " + Строка(ИмяScheme.Ключ),
					ИмяScheme.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьИменаSecurity(Описание)

	Результат = Новый Массив;
	Компоненты = ПолучитьПоле(Описание, "components");
	Если Компоненты = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Схемы = ПолучитьПоле(Компоненты, "securitySchemes");
	Если Схемы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Схемы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Схема Из Схемы Цикл
		Результат.Добавить(Схема.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// ============ ОБЩИЕ ВСПОМОГАТЕЛЬНЫЕ ============

// Проверяет, что значение входит в список (строка через запятую).
Функция ЭтоОдноиз(Значение, СписокЧерезЗапятую)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти("," + СписокЧерезЗапятую + ",", "," + Строка(Значение) + ",") > 0;
КонецФункции

Функция СодержитИмя(МассивИмен, Имя)
	Для Каждого Элемент Из МассивИмен Цикл
		Если Элемент = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПостроитьScopes(Scopes)
	Результат = Новый Соответствие;
	Если Scopes = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из Scopes Цикл
		Результат.Вставить(Имя, "");
	КонецЦикла;
	Возврат Результат;
КонецФункции

// ============ ВАЛИДАТОР ОПИСАНИЯ ============

// Возвращает {Валидно: Булево, Ошибки: Массив}.
Функция ПроверитьОписание(Описание) Экспорт

	Ошибки = Новый Массив;

	// R01: корень
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, "", "ROOT_NOT_STRUCTURE",
			"Корень описания должен быть Структурой", Описание);
		Возврат Новый Структура("Валидно, Ошибки", Ложь, Ошибки);
	КонецЕсли;

	// R02-R03: openapi
	Версия = ПолучитьПоле(Описание, "openapi");
	Если Версия = Неопределено Тогда
		ДобавитьОшибку(Ошибки, "openapi", "OPENAPI_MISSING",
			"Поле openapi обязательно", Неопределено);
	ИначеЕсли Версия <> "3.1.0" Тогда
		ДобавитьОшибку(Ошибки, "openapi", "OPENAPI_INVALID_VERSION",
			"Поддерживается только версия 3.1.0", Версия);
	КонецЕсли;

	// I01-I03: info
	ПроверитьInfo(ПолучитьПоле(Описание, "info"), "info", Ошибки);

	// R04: paths
	Пути = ПолучитьПоле(Описание, "paths");
	Если Пути = Неопределено ИЛИ ТипЗнч(Пути) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, "paths", "PATHS_MISSING",
			"Поле paths обязательно и должно быть Соответствием", Неопределено);
	КонецЕсли;

	// R05-R06: components
	Компоненты = ПолучитьПоле(Описание, "components");
	Если Компоненты = Неопределено ИЛИ ТипЗнч(Компоненты) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, "components", "COMPONENTS_MISSING",
			"Поле components обязательно и должно быть Структурой", Неопределено);
	Иначе
		Схемы = ПолучитьПоле(Компоненты, "schemas");
		Если Схемы = Неопределено ИЛИ ТипЗнч(Схемы) <> Тип("Соответствие") Тогда
			ДобавитьОшибку(Ошибки, "components.schemas", "COMPONENTS_SCHEMAS_MISSING",
				"components.schemas обязательно и должно быть Соответствием", Неопределено);
		Иначе
			// Проверяем каждую компонентную схему
			Для Каждого Схема Из Схемы Цикл
				ПроверитьSchema(Схема.Значение,
					"components.schemas." + Схема.Ключ, Описание, Ошибки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если Компоненты <> Неопределено И ТипЗнч(Компоненты) = Тип("Структура") Тогда
		ПроверитьSecuritySchemes(Компоненты, Ошибки);
	КонецЕсли;

	// глобальный security
	ПроверитьSecurity(ПолучитьПоле(Описание, "security"), "security", Описание, Ошибки, "GLOBAL_SECURITY");

	// S01-S02: servers
	ПроверитьServers(ПолучитьПоле(Описание, "servers"), "servers", Ошибки);

	// P01-P03, O01-O02: проход по paths с проверкой уникальности operationId
	Если ТипЗнч(Пути) = Тип("Соответствие") Тогда
		НайденныеOperationId = Новый Соответствие;
		Для Каждого Путь Из Пути Цикл
			ПроверитьPathItem(Путь.Ключ, Путь.Значение, Описание, Ошибки, НайденныеOperationId);
		КонецЦикла;
	КонецЕсли;

	Валидно = (Ошибки.Количество() = 0);
	Возврат Новый Структура("Валидно, Ошибки", Валидно, Ошибки);

КонецФункции

Функция ПроверитьОписаниеИлиВыбросить(Описание) Экспорт
	Результат = ПроверитьОписание(Описание);
	Если НЕ Результат.Валидно Тогда
		ВызватьИсключение "Модель OpenAPI невалидна:" + Символы.ПС + ТекстОшибок(Результат.Ошибки);
	КонецЕсли;
	Возврат Описание;
КонецФункции

// ============ ВНУТРЕННИЕ ПРОВЕРКИ ============

Процедура ПроверитьInfo(Инфо, Путь, Ошибки)

	Если Инфо = Неопределено ИЛИ ТипЗнч(Инфо) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, Путь, "INFO_MISSING",
			"Поле info обязательно и должно быть Структурой", Инфо);
		Возврат;
	КонецЕсли;

	Заголовок = ПолучитьПоле(Инфо, "title");
	Если Заголовок = Неопределено ИЛИ ПустаяСтрока(Строка(Заголовок)) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".title", "INFO_TITLE_MISSING",
			"info.title не может быть пустым", Заголовок);
	КонецЕсли;

	Версия = ПолучитьПоле(Инфо, "version");
	Если Версия = Неопределено ИЛИ ПустаяСтрока(Строка(Версия)) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".version", "INFO_VERSION_MISSING",
			"info.version не может быть пустым", Версия);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьServers(Серверы, Путь, Ошибки)

	Если Серверы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Серверы) <> Тип("Массив") Тогда
		ДобавитьОшибку(Ошибки, Путь, "SERVER_NOT_STRUCTURE",
			"servers должен быть массивом", Серверы);
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По Серверы.Количество() - 1 Цикл
		Сервер = Серверы[Индекс];
		ПутьСервера = Путь + "[" + Индекс + "]";
		Если ТипЗнч(Сервер) <> Тип("Структура") Тогда
			ДобавитьОшибку(Ошибки, ПутьСервера, "SERVER_NOT_STRUCTURE",
				"Элемент servers должен быть Структурой", Сервер);
			Продолжить;
		КонецЕсли;
		URL = ПолучитьПоле(Сервер, "url");
		Если URL = Неопределено ИЛИ ПустаяСтрока(Строка(URL)) Тогда
			ДобавитьОшибку(Ошибки, ПутьСервера + ".url", "SERVER_URL_MISSING",
				"server.url не может быть пустым", URL);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьPathItem(Путь, PathItem, Описание, Ошибки, НайденныеOperationId)

	Если Лев(Путь, 1) <> "/" Тогда
		ДобавитьОшибку(Ошибки, "paths." + Путь, "PATH_NOT_START_SLASH",
			"Путь должен начинаться с '/'", Путь);
	КонецЕсли;

	Если ТипЗнч(PathItem) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, "paths." + Путь, "PATH_ITEM_NOT_STRUCTURE",
			"PathItem должен быть Структурой", PathItem);
		Возврат;
	КонецЕсли;

	Методы = Новый Массив;
	Для Каждого Метод Из СтрРазделить("get,post,put,patch,delete", ",") Цикл
		Если СодержитКлюч(PathItem, Метод) Тогда
			Методы.Добавить(Метод);
		КонецЕсли;
	КонецЦикла;

	Если Методы.Количество() = 0 Тогда
		ДобавитьОшибку(Ошибки, "paths." + Путь, "PATH_ITEM_NO_OPERATIONS",
			"PathItem должен содержать хотя бы одну операцию (get/post/put/patch/delete)",
			Неопределено);
		Возврат;
	КонецЕсли;

	Для Каждого Метод Из Методы Цикл
		Операция = PathItem[Метод];
		ПроверитьOperation(Операция, Путь, "paths." + Путь + "." + Метод,
			Описание, Ошибки, НайденныеOperationId);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьOperation(Операция, URL, Путь, Описание, Ошибки, НайденныеOperationId)

	Если ТипЗнч(Операция) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, Путь, "OPERATION_NOT_STRUCTURE",
			"Operation должна быть Структурой", Операция);
		Возврат;
	КонецЕсли;

	// O02: responses - мягкий режим для совместимости
	Ответы = ПолучитьПоле(Операция, "responses");
	ПустыеОтветы = (Ответы = Неопределено
			ИЛИ ТипЗнч(Ответы) <> Тип("Соответствие")
			ИЛИ Ответы.Количество() = 0);

	Если ПустыеОтветы Тогда
		МягкийРежим = (ПолучитьПоле(Описание, "_СтрогаяПроверка") = Ложь);
		Если МягкийРежим Тогда
			ДобавитьОшибку(Ошибки, Путь + ".responses",
				"OPERATION_RESPONSES_EMPTY_WARN",
				"responses не заданы - по стандарту OpenAPI это неполно. "
				+ "Рекомендуется добавить .Ответ(200).ОписаниеОтвета(...)",
				Неопределено);
		Иначе
			ДобавитьОшибку(Ошибки, Путь + ".responses",
				"OPERATION_RESPONSES_MISSING",
				"responses обязательно и не может быть пустым", Неопределено);
		КонецЕсли;
	Иначе
		Для Каждого Ответ Из Ответы Цикл
			ПроверитьResponse(Ответ.Значение,
				Путь + ".responses." + Ответ.Ключ, Описание, Ошибки);
		КонецЦикла;
	КонецЕсли;

	// requestBody (RB01-RB02)
	ПроверитьRequestBody(ПолучитьПоле(Операция, "requestBody"),
		Путь + ".requestBody", Описание, Ошибки);

	// O03: parameters
	Параметры = ПолучитьПоле(Операция, "parameters");
	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
			ДобавитьОшибку(Ошибки, Путь + ".parameters", "OPERATION_PARAMETERS_NOT_ARRAY",
				"parameters должен быть массивом", Параметры);
		Иначе
			Для Индекс = 0 По Параметры.Количество() - 1 Цикл
				ПроверитьParameter(Параметры[Индекс], URL,
					Путь + ".parameters[" + Индекс + "]", Описание, Ошибки);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// O04–O05 - security операции
	ПроверитьSecurity(ПолучитьПоле(Операция, "security"),
		Путь + ".security", Описание, Ошибки, "OPERATION_SECURITY");

	// O06 - уникальность operationId
	OperationId = ПолучитьПоле(Операция, "operationId");
	Если OperationId <> Неопределено И НЕ ПустаяСтрока(Строка(OperationId)) Тогда
		Если СодержитКлюч(НайденныеOperationId, OperationId) Тогда
			ДобавитьОшибку(Ошибки, Путь + ".operationId", "OPERATION_ID_DUPLICATE",
				"operationId уже используется в "
				+ НайденныеOperationId.Получить(OperationId), OperationId);
		Иначе
			НайденныеOperationId.Вставить(OperationId, Путь);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьParameter(Параметр, URL, Путь, Описание, Ошибки)

	Если ТипЗнч(Параметр) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, Путь, "PARAM_NOT_STRUCTURE",
			"Parameter должен быть Структурой", Параметр);
		Возврат;
	КонецЕсли;

	Имя = ПолучитьПоле(Параметр, "name");
	Если Имя = Неопределено ИЛИ ПустаяСтрока(Строка(Имя)) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".name", "PARAM_NAME_MISSING",
			"name не может быть пустым", Имя);
	КонецЕсли;

	Расположение = ПолучитьПоле(Параметр, "location");
	Если Расположение = Неопределено
		ИЛИ СтрНайти(",query,path,header,cookie,", "," + Строка(Расположение) + ",") = 0 Тогда
		ДобавитьОшибку(Ошибки, Путь + ".location", "PARAM_IN_INVALID",
			"location (in) должен быть одним из: query, path, header, cookie", Расположение);
	КонецЕсли;

	Схема = ПолучитьПоле(Параметр, "schema");
	Если Схема = Неопределено Тогда
		ДобавитьОшибку(Ошибки, Путь + ".schema", "PARAM_SCHEMA_MISSING",
			"schema обязательна", Неопределено);
	Иначе
		ПроверитьSchema(Схема, Путь + ".schema", Описание, Ошибки);
	КонецЕсли;

	// PA05: path-параметр обязан иметь required=true
	Если Расположение = "path" Тогда
		Обязательный = ПолучитьПоле(Параметр, "required");
		Если Обязательный <> Истина Тогда
			ДобавитьОшибку(Ошибки, Путь + ".required", "PARAM_PATH_REQUIRED_FALSE",
				"Path-параметр обязан иметь required=true", Обязательный);
		КонецЕсли;

		// PA06: path-параметр должен быть в URL
		Если Имя <> Неопределено И НЕ ПустаяСтрока(Строка(Имя)) Тогда
			Если СтрНайти(URL, "{" + Имя + "}") = 0 Тогда
				ДобавитьОшибку(Ошибки, Путь + ".name", "PARAM_PATH_NOT_IN_URL",
					"Path-параметр '" + Имя + "' отсутствует в URL " + URL, Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьResponse(Ответ, Путь, Описание, Ошибки)

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, Путь, "RESPONSE_NOT_STRUCTURE",
			"Response должен быть Структурой", Ответ);
		Возврат;
	КонецЕсли;

	// RSP02: description обязателен
	ОписаниеОтвета = ПолучитьПоле(Ответ, "description");
	Если ОписаниеОтвета = Неопределено ИЛИ ПустаяСтрока(Строка(ОписаниеОтвета)) Тогда
		ДобавитьОшибку(Ошибки, Путь + ".description", "RESPONSE_DESCRIPTION_MISSING",
			"description не может быть пустым", ОписаниеОтвета);
	КонецЕсли;

	// RSP03 + MT01/MT02: content (если есть)
	Content = ПолучитьПоле(Ответ, "content");
	Если Content = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПроверитьContent(Content, Путь + ".content", Описание, Ошибки);

КонецПроцедуры

// ============ ПРОВЕРКА CONTENT (общая для RequestBody и Response) ============

Процедура ПроверитьContent(Content, Путь, Описание, Ошибки)

	Если Content = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Content) <> Тип("Соответствие") Тогда
		ДобавитьОшибку(Ошибки, Путь, "CONTENT_NOT_MAP",
			"content должен быть Соответствием", Content);
		Возврат;
	КонецЕсли;

	// Пустой content здесь НЕ ошибка - для Response это допустимо.
	// Требование непустоты для RequestBody проверяется отдельно (RB02).

	Для Каждого Media Из Content Цикл

		ПутьMedia = Путь + "." + Media.Ключ;

		Если ТипЗнч(Media.Значение) <> Тип("Структура") Тогда
			ДобавитьОшибку(Ошибки, ПутьMedia, "MEDIA_TYPE_NOT_STRUCTURE",
				"MediaType должен быть Структурой", Media.Значение);
			Продолжить;
		КонецЕсли;

		СхемаMedia = ПолучитьПоле(Media.Значение, "schema");
		Если СхемаMedia = Неопределено Тогда
			ДобавитьОшибку(Ошибки, ПутьMedia + ".schema", "MEDIA_TYPE_SCHEMA_MISSING",
				"schema обязательна в MediaType", Неопределено);
		Иначе
			ПроверитьSchema(СхемаMedia, ПутьMedia + ".schema", Описание, Ошибки);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// ============ ПРОВЕРКА REQUEST BODY ============

Процедура ПроверитьRequestBody(RequestBody, Путь, Описание, Ошибки)

	Если RequestBody = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// RB01: requestBody - Структура
	Если ТипЗнч(RequestBody) <> Тип("Структура") Тогда
		ДобавитьОшибку(Ошибки, Путь, "REQUEST_BODY_NOT_STRUCTURE",
			"requestBody должен быть Структурой", RequestBody);
		Возврат;
	КонецЕсли;

	// RB02: content - Соответствие, непустое
	Content = ПолучитьПоле(RequestBody, "content");
	Если Content = Неопределено Тогда
		ДобавитьОшибку(Ошибки, Путь + ".content", "REQUEST_BODY_CONTENT_MISSING",
			"content обязателен в requestBody", Неопределено);
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Content) <> Тип("Соответствие") ИЛИ Content.Количество() = 0 Тогда
		ДобавитьОшибку(Ошибки, Путь + ".content", "REQUEST_BODY_CONTENT_MISSING",
			"content должен быть непустым Соответствием", Content);
		Возврат;
	КонецЕсли;

	ПроверитьContent(Content, Путь + ".content", Описание, Ошибки);

КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

Функция РазвернутьСхемуВСтруктуру(Значение, Контекст)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Значение.Сформировать();
	Исключение
		ВызватьИсключение Контекст
		+ ": ожидалась Структура или билдер, получено: " + Строка(ТипЗначения);
	КонецПопытки;
КонецФункции

// ============ ОБЩИЕ УТИЛИТЫ ============

Процедура ДобавитьОшибку(Ошибки, Путь, Код, Сообщение, Значение = Неопределено) Экспорт
	Ошибка = Новый Структура;
	Ошибка.Вставить("Код", Код);
	Ошибка.Вставить("Путь", Путь);
	Ошибка.Вставить("Сообщение", Сообщение);
	Ошибка.Вставить("Значение", Значение);
	Ошибки.Добавить(Ошибка);
КонецПроцедуры

Функция ТекстОшибок(Ошибки) Экспорт
	Если Ошибки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Ош Из Ошибки Цикл
		Части.Добавить("[" + Ош.Код + "] " + Ош.Путь + ": " + Ош.Сообщение);
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

// Истина, если все ошибки имеют код, заканчивающийся на _WARN.
Функция ТолькоПредупреждения(Ошибки) Экспорт

	Если Ошибки.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Ош Из Ошибки Цикл
		Если Прав(Ош.Код, 5) <> "_WARN" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Истина, если есть хотя бы одна ошибка (не предупреждение).
Функция ЕстьКритичныеОшибки(Ошибки) Экспорт
	Возврат НЕ ТолькоПредупреждения(Ошибки);
КонецФункции
