////////////////////////////////////////////////////////////////////////////////
// YaxUnit-тесты для Swag_Сборщик.СобратьМодельOpenRPC.
//
// Тесты не требуют наличия конкретных json-rpc сервисов. Если в
// конфигурации их нет - проверяется сценарий «модель = Неопределено»
// и fallback в Swag_Запросы.СформироватьJsonRpc.
//
// Если json-rpc сервисы есть - проверяется их попадание в модель
// и корректная структура методов.
////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
    ЮТТесты
        .ДобавитьТестовыйНабор("OpenRPC: сборка модели")
            .ДобавитьТест("ПустаяКонфигурация_ИлиМодель")
            .ДобавитьТест("МодельСодержитОбязательныеПоля")
            .ДобавитьТест("МодельНеСодержитSwaggerСервисов")
            .ДобавитьТест("ИменаМетодовУникальны")
        .ДобавитьТестовыйНабор("OpenRPC: формирование JSON")
            .ДобавитьТест("ФормированиеJSONПриОтсутствииJSONRPC_Fallback")
            .ДобавитьТест("ФормированиеJSONПриНаличииJSONRPC_РеальныйДокумент")
            .ДобавитьТест("СериализованныйJSONВалиден")
			.ДобавитьТест("JSONRPCJSONСодержитДолларRef")
    ;
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

// Список имён JSON-RPC-сервисов в текущей конфигурации.
Функция ИменаJSONRPCSервисов()

    Результат = Новый Массив;
    МодульСборщика = Swag_Сборщик;

    Для Каждого HTTPСервис Из Метаданные.HTTPСервисы Цикл
        Если HTTPСервис.Имя = "Swag_Сервис" Тогда
            Продолжить;
        КонецЕсли;

        ИмяМодуля = HTTPСервис.Имя + "Описание";
        Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Попытка
            Модуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
            Общие = Модуль.ПолучитьОбщиеНастройки();
            Если ТипЗнч(Общие) = Тип("Структура")
                И Общие.Свойство("Протокол")
                И Общие.Протокол = "json-rpc" Тогда
                Результат.Добавить(HTTPСервис.Имя);
            КонецЕсли;
        Исключение
            // Модуль без ПолучитьОбщиеНастройки - это не json-rpc
        КонецПопытки;
    КонецЦикла;

    Возврат Результат;

КонецФункции

Функция ЕстьJSONRPCSервисы()
    Возврат ИменаJSONRPCSервисов().Количество() > 0;
КонецФункции

// ============ СБОРКА МОДЕЛИ ============

Процедура ПустаяКонфигурация_ИлиМодель() Экспорт

    Модель = Swag_Сборщик.СобратьМодельOpenRPC();

    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.ОжидаетЧто(Модель,
            "Без json-rpc сервисов модель должна быть Неопределено")
            .Равно(Неопределено);
        Возврат;
    КонецЕсли;

    ЮТест.ОжидаетЧто(Модель).НеРавно(Неопределено);
    ЮТест.ОжидаетЧто(Модель).ИмеетТип("Структура");

КонецПроцедуры

Процедура МодельСодержитОбязательныеПоля() Экспорт

    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации нет json-rpc сервисов");
    КонецЕсли;

    Модель = Swag_Сборщик.СобратьМодельOpenRPC();
    ЮТест.ОжидаетЧто(Модель).НеРавно(Неопределено);

    ЮТест.ОжидаетЧто(Модель.openrpc).Равно("1.3.2");
    ЮТест.ОжидаетЧто(Модель.info).ИмеетТип("Структура");
    ЮТест.ОжидаетЧто(Модель.servers).ИмеетТип("Массив");
    ЮТест.ОжидаетЧто(Модель.methods).ИмеетТип("Массив");
    ЮТест.ОжидаетЧто(Модель.components).ИмеетТип("Структура");
    ЮТест.ОжидаетЧто(Модель.components.schemas).ИмеетТип("Соответствие");

КонецПроцедуры

Процедура МодельНеСодержитSwaggerСервисов() Экспорт

    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации нет json-rpc сервисов");
    КонецЕсли;

    Модель = Swag_Сборщик.СобратьМодельOpenRPC();
    ЮТест.ОжидаетЧто(Модель).НеРавно(Неопределено);

    // Каждый метод модели должен иметь имя из json-rpc сервиса
    ИменаJSONRPC = ИменаJSONRPCSервисов();

    Для Каждого Метод Из Модель.methods Цикл
        // Метод должен содержать поля OpenRPC
        ЮТест.ОжидаетЧто(Метод.Свойство("name"),
            "У каждого метода должно быть поле name").ЭтоИстина();
        ЮТест.ОжидаетЧто(Метод.Свойство("params")).ЭтоИстина();
        ЮТест.ОжидаетЧто(Метод.Свойство("result")).ЭтоИстина();
    КонецЦикла;

КонецПроцедуры

Процедура ИменаМетодовУникальны() Экспорт

    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации нет json-rpc сервисов");
    КонецЕсли;

    Модель = Swag_Сборщик.СобратьМодельOpenRPC();
    ЮТест.ОжидаетЧто(Модель).НеРавно(Неопределено);

    УникальныеИмена = Новый Соответствие;
    Дубликаты = Новый Массив;

    Для Каждого Метод Из Модель.methods Цикл
        Имя = Метод.name;
        Если УникальныеИмена.Получить(Имя) <> Неопределено Тогда
            Дубликаты.Добавить(Имя);
        Иначе
            УникальныеИмена.Вставить(Имя, Истина);
        КонецЕсли;
    КонецЦикла;

    ЮТест.ОжидаетЧто(Дубликаты.Количество(),
        "Найдены дубликаты имён методов: "
        + СтрСоединить(Дубликаты, ", ")).Равно(0);

КонецПроцедуры

// ============ ФОРМИРОВАНИЕ JSON ============

Процедура ФормированиеJSONПриОтсутствииJSONRPC_Fallback() Экспорт

    Если ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации есть json-rpc сервисы - fallback не проверить");
    КонецЕсли;

    ТекстJSON = Swag_Запросы.СформироватьJsonRpc("");

    ЮТест.ОжидаетЧто(ТекстJSON,
        "Без json-rpc сервисов должен возвращаться статический пример")
        .НеРавно("");

    // Проверяем, что это валидный JSON
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстJSON);
    Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
    ЮТест.ОжидаетЧто(Данные).ИмеетТип("Соответствие");
    ЮТест.ОжидаетЧто(Данные.Получить("openrpc")).НеРавно(Неопределено);

КонецПроцедуры

Процедура ФормированиеJSONПриНаличииJSONRPC_РеальныйДокумент() Экспорт

    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации нет json-rpc сервисов");
    КонецЕсли;

    ТекстJSON = Swag_Запросы.СформироватьJsonRpc("");
    ЮТест.ОжидаетЧто(ТекстJSON).НеРавно("");

    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(ТекстJSON);
    Данные = ПрочитатьJSON(ЧтениеJSON, Истина);

    // Реальный документ отличается от статического примера -
    // в нём должно быть больше одного метода (у статики ровно 1)
    ЮТест.ОжидаетЧто(Данные.Получить("openrpc")).Равно("1.3.2");
    ЮТест.ОжидаетЧто(Данные.Получить("methods")).ИмеетТип("Массив");
    ЮТест.ОжидаетЧто(Данные.Получить("methods").Количество()).Больше(0);

КонецПроцедуры

Процедура СериализованныйJSONВалиден() Экспорт

    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации нет json-rpc сервисов");
    КонецЕсли;

    ТекстJSON = Swag_Запросы.СформироватьJsonRpc("");

    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(ТекстJSON);
        Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
    Исключение
        ЮТест.ОжидаетЧто(Ложь,
            "Сериализованный JSON не парсится: "
            + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())).ЭтоИстина();
        Возврат;
    КонецПопытки;

    ЮТест.ОжидаетЧто(Данные.Получить("openrpc")).Равно("1.3.2");
    ЮТест.ОжидаетЧто(Данные.Получить("info")).ИмеетТип("Соответствие");
    ЮТест.ОжидаетЧто(Данные.Получить("servers")).ИмеетТип("Массив");
    ЮТест.ОжидаетЧто(Данные.Получить("methods")).ИмеетТип("Массив");

    // Каждый метод должен иметь name, params, result
    Для Каждого Метод Из Данные.Получить("methods") Цикл
        ЮТест.ОжидаетЧто(Метод.Получить("name")).НеРавно(Неопределено);
        ЮТест.ОжидаетЧто(Метод.Получить("params")).ИмеетТип("Массив");
        ЮТест.ОжидаетЧто(Метод.Получить("result")).ИмеетТип("Соответствие");
    КонецЦикла;

КонецПроцедуры

Процедура JSONRPCJSONСодержитДолларRef() Экспорт

    // Только если в конфигурации есть json-rpc сервис
    Если Не ЕстьJSONRPCSервисы() Тогда
        ЮТест.Пропустить("В конфигурации нет json-rpc сервисов");
    КонецЕсли;

    ТекстJSON = Swag_Запросы.СформироватьJsonRpc("");

    // Внутреннее имя ref не должно остаться в JSON
    ЮТест.ОжидаетЧто(СтрНайти(ТекстJSON, """ref"""),
        "В JSON должно быть $ref, а не ref").Равно(0);

    // Должен быть $ref, если хоть один метод возвращает ссылку на схему
    Если СтрНайти(ТекстJSON, """$ref""") > 0 Тогда
        ЮТест.ОжидаетЧто(СтрНайти(ТекстJSON, """$ref""")).Больше(0);
    КонецЕсли;

КонецПроцедуры
