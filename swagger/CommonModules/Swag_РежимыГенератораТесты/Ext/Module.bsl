КонецПроцедуры

Процедура ЕстьКритичныеОшибки_ПустойМассив() Экспорт
	ЮТест.ОжидаетЧто(Swag_Модель.ЕстьКритичныеОшибки(Новый Массив)).ЭтоЛожь();
КонецПроцедуры

// ============ МЯГКИЙ/СТРОГИЙ В ВАЛИДАТОРЕ ============

Процедура МягкийРежим_ResponsesПустые_КодWarn() Экспорт

	Модель = СобратьМодельСОперацией(Истина);
	Модель.Вставить("_СтрогаяПроверка", Ложь); // мягкий

	Результат = Swag_Модель.ПроверитьОписание(Модель);

	ЮТест.ОжидаетЧто(Результат.Ошибки)
		.Содержит(ЮТест.Предикат()
			.Свойство("Код").Равно("OPERATION_RESPONSES_EMPTY_WARN"));
	ЮТест.ОжидаетЧто(Swag_Модель.ТолькоПредупреждения(Результат.Ошибки),
		"В мягком режиме все ошибки должны быть предупреждениями").ЭтоИстина();

КонецПроцедуры

Процедура СтрогийРежим_ResponsesПустые_КодMissing() Экспорт

	Модель = СобратьМодельСОперацией(Истина);
	Модель.Вставить("_СтрогаяПроверка", Истина); // строгий

	Результат = Swag_Модель.ПроверитьОписание(Модель);

	ЮТест.ОжидаетЧто(Результат.Ошибки)
		.Содержит(ЮТест.Предикат()
			.Свойство("Код").Равно("OPERATION_RESPONSES_MISSING"));

КонецПроцедуры

Процедура МягкийРежим_ResponsesЕсть_БезОшибок() Экспорт

	Модель = СобратьМодельСОперацией(Ложь);
	Модель.Вставить("_СтрогаяПроверка", Ложь);

	Результат = Swag_Модель.ПроверитьОписание(Модель);

	ЮТест.ОжидаетЧто(Результат.Валидно,
		"Ошибки: " + Swag_Модель.ТекстОшибок(Результат.Ошибки)).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(0);

КонецПроцедуры

// ============ ФОРМИРОВАНИЕ JSON ============

Процедура РежимВыкл_СтарыйГенератор() Экспорт

	// Проверяем, что при режиме "Выкл" новый генератор не вызывается.
	// Косвенно: если новый генератор отдаёт "3.1.0", а старый - "3.0.0",
	// то в режиме "Выкл" мы должны увидеть "3.0.0" (или вообще не JSON,
	// если старый генератор не может собрать без реальной конфигурации).
	//
	// Мы не можем здесь проверить наличие старого JSON без полной конфигурации,
	// поэтому проверяем только, что ПолучитьРежимГенератора по умолчанию = "Выкл".

	Режим = Swag_Запросы.ПолучитьРежимГенератора();
	ЮТест.ОжидаетЧто(Режим,
		"По умолчанию должен быть 'Выкл' (модуль настроек отсутствует)")
		.Равно("Выкл");

КонецПроцедуры

Процедура РежимМягкий_НовыйГенератор() Экспорт

	// Модель с невалидной операцией (пустые responses)
	Модель = СобратьМодельСОперацией(Истина);

	ТекстJSON = Swag_Запросы.ОбработатьМодельВРежиме(Модель, "Мягкий");

	ЮТест.ОжидаетЧто(ТекстJSON,
		"Мягкий режим должен вернуть JSON даже для невалидной модели")
		.НеРавно(Неопределено);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЮТест.ОжидаетЧто(Данные.Получить("openapi")).Равно("3.1.0");

КонецПроцедуры

Процедура РежимСтрогий_ВалиднаяМодель() Экспорт

	// Заведомо валидная модель - без операций с пустыми responses
	Модель = СобратьВалиднуюМодель();

	ТекстJSON = Swag_Запросы.ОбработатьМодельВРежиме(Модель, "Строгий");

	ЮТест.ОжидаетЧто(ТекстJSON,
		"Строгий режим должен вернуть JSON для валидной модели")
		.НеРавно(Неопределено);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЮТест.ОжидаетЧто(Данные.Получить("openapi")).Равно("3.1.0");

КонецПроцедуры

Процедура РежимСтрогий_НевалиднаяМодель_Fallback() Экспорт

	// Модель с пустыми responses - невалидна в строгом режиме
	Модель = СобратьМодельСОперацией(Истина);

	ТекстJSON = Swag_Запросы.ОбработатьМодельВРежиме(Модель, "Строгий");

	ЮТест.ОжидаетЧто(ТекстJSON,
		"Строгий режим должен вернуть Неопределено для невалидной модели")
		.Равно(Неопределено);

КонецПроцедуры

Процедура СформироватьНовымГенератором_МягкийВсегдаОтдаётJSON() Экспорт

	// В мягком режиме функция отдаёт JSON при любом состоянии конфигурации -
	// это её контракт. Даже если модель невалидна (есть error_* методы),
	// JSON должен быть отдан.

	ТекстJSON = Swag_Запросы.СформироватьНовымГенератором("", "Мягкий");

	ЮТест.ОжидаетЧто(ТекстJSON,
		"Мягкий режим должен вернуть JSON независимо от конфигурации")
		.НеРавно(Неопределено);

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЮТест.ОжидаетЧто(Данные.Получить("openapi")).Равно("3.1.0");

КонецПроцедуры

Процедура СформироватьНовымГенератором_СтрогийЗависитОтКонфигурации() Экспорт

	// В строгом режиме результат зависит от конфигурации:
	//   - модель валидна → JSON
	//   - модель невалидна → Неопределено (fallback)
	// Тест проверяет только то, что один из двух вариантов возвращается.
	// Конкретное значение зависит от вашей конфигурации - это корректно.

	ТекстJSON = Swag_Запросы.СформироватьНовымГенератором("", "Строгий");

	Если ТекстJSON = Неопределено Тогда
		// На конфигурации есть невалидные описания - это допустимо
		ЮТест.ОжидаетЧто(Истина,
			"Строгий режим вернул Неопределено (в конфигурации есть замечания)").ЭтоИстина();
	Иначе
		// Модель валидна - проверим базовые поля
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЮТест.ОжидаетЧто(Данные.Получить("openapi")).Равно("3.1.0");
	КонецЕсли;

КонецПроцедуры

// ============ СЕРИАЛИЗАТОР - СЛУЖЕБНЫЕ ПОЛЯ ============

Процедура Сериализатор_СлужебныеПоляНеВJSON() Экспорт

	Описание = СобратьВалиднуюМодель();
	Описание.Вставить("_СтрогаяПроверка", Истина); // служебное поле

	ТекстJSON = Swag_СериализаторOpenAPI.Сериализовать(Описание);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстJSON, "_СтрогаяПроверка"),
		"Служебное поле _СтрогаяПроверка не должно попадать в JSON").Равно(0);
	ЮТест.ОжидаетЧто(СтрНайти(ТекстJSON, """openapi"": ""3.1.0""")).Больше(0);

КонецПроцедуры

// ============ ДИАГНОСТИКА ============

Процедура Диагностика_ВалидныйСервис_ПустойОтчёт() Экспорт

	// На пустой конфигурации (нет описаний с ошибками) отчёт пустой.
	Отчёт = Swag_Сборщик.ДиагностикаОписаний();

	ЮТест.ОжидаетЧто(Отчёт).ИмеетТип("ТаблицаЗначений");
	// Колонки должны быть в любом случае
	ЮТест.ОжидаетЧто(Отчёт.Колонки.Найти("Код")).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Отчёт.Колонки.Найти("Путь")).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Отчёт.Колонки.Найти("Критичность")).НеРавно(Неопределено);

КонецПроцедуры

Процедура Диагностика_ЕстьЗамечания_ОтчётНеПустой() Экспорт

	// Собираем модель с заведомо неполной операцией,
	// чтобы убедиться, что диагностика их ловит.
	// Но т.к. реальная модель собирается из конфигурации,
	// мы проверяем только структуру отчёта.

	Отчёт = Swag_Сборщик.ДиагностикаОписаний();

	// Если в конфигурации есть неполные описания - отчёт не пустой.
	// Тест мягкий: только проверяем, что структура правильная.
	ЮТест.ОжидаетЧто(Отчёт).ИмеетТип("ТаблицаЗначений");

	// Все строки должны иметь непустые Код и Путь
	Для Каждого Строка Из Отчёт Цикл
		ЮТест.ОжидаетЧто(Строка.Код).НеРавно("");
		ЮТест.ОжидаетЧто(Строка.Путь).НеРавно("");
		ЮТест.ОжидаетЧто(Строка.Критичность).НеРавно("");
	КонецЦикла;

КонецПроцедуры

Процедура Диагностика_КолонкиОтчёта() Экспорт

	Отчёт = Swag_Сборщик.ДиагностикаОписаний();

	ЮТест.ОжидаетЧто(Отчёт.Колонки.Количество()).Равно(5);

	ИменаКолонок = Новый Массив;
	Для Каждого Колонка Из Отчёт.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;

	ЮТест.ОжидаетЧто(ИменаКолонок).Содержит("Код");
	ЮТест.ОжидаетЧто(ИменаКолонок).Содержит("Путь");
	ЮТест.ОжидаетЧто(ИменаКолонок).Содержит("Сообщение");
	ЮТест.ОжидаетЧто(ИменаКолонок).Содержит("Критичность");
	ЮТест.ОжидаетЧто(ИменаКолонок).Содержит("Сервис");

КонецПроцедуры

Процедура Диагностика_КлассификацияКритичности() Экспорт

	Отчёт = Swag_Сборщик.ДиагностикаОписаний();

	Для Каждого Строка Из Отчёт Цикл
		Ожидаемое = ?(Прав(Строка.Код, 5) = "_WARN", "Предупреждение", "Ошибка");
		ЮТест.ОжидаетЧто(Строка.Критичность,
			"Для кода " + Строка.Код + " ожидалась " + Ожидаемое)
			.Равно(Ожидаемое);
	КонецЦикла;

КонецПроцедуры
