			.ДобавитьТест("Диагностика_КлассификацияКритичности")
		;
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

// Собирает минимальную модель с одной операцией и указанным responses.
Функция СобратьМодельСОперацией(ОперацияСПустымиОтветами)

	Описание = Swag_Модель.НовоеОписание("Тестовый API", "1.0");

	Операция = Swag_Модель.НоваяОперация("post", "/test")
		.КраткоеОписание("Тестовый метод")
		.Сформировать();

	Если НЕ ОперацияСПустымиОтветами Тогда
		Операция.Вставить("responses", Новый Соответствие);
		Ответ = Новый Структура("description", "OK");
		Операция.responses.Вставить("200", Ответ);
	КонецЕсли;
	// Если ОперацияСПустымиОтветами = Истина - оставляем responses пустым

	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);
	Возврат Описание;

КонецФункции

// Простая модель только с одной схемой - заведомо валидная.
Функция СобратьВалиднуюМодель()
	Описание = Swag_Модель.НовоеОписание("Тестовый API", "1.0");
	Описание = Swag_Модель.ДобавитьСхему(Описание, "Item",
			Swag_Модель.СхемаОбъект()
			.Свойство("id", Swag_Модель.СхемаСтрока())
			.Требует("id")
			.Сформировать());
	Операция = Swag_Модель.НоваяОперация("get", "/items")
		.Ответ("200", "OK")
		.Сформировать();
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);
	Возврат Описание;
КонецФункции

// ============ КЛАССИФИКАЦИЯ ============

Процедура ТолькоПредупреждения_ПустойМассив() Экспорт
	Ошибки = Новый Массив;
	ЮТест.ОжидаетЧто(Swag_Модель.ТолькоПредупреждения(Ошибки)).ЭтоИстина();
	ЮТест.ОжидаетЧто(Swag_Модель.ЕстьКритичныеОшибки(Ошибки)).ЭтоЛожь();
КонецПроцедуры

Процедура ТолькоПредупреждения_ТолькоЗамечанияWarn() Экспорт
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("Код", "OPERATION_RESPONSES_EMPTY_WARN"));
	Ошибки.Добавить(Новый Структура("Код", "SCHEMA_ARRAY_ITEMS_MISSING_WARN"));

	ЮТест.ОжидаетЧто(Swag_Модель.ТолькоПредупреждения(Ошибки)).ЭтоИстина();
	ЮТест.ОжидаетЧто(Swag_Модель.ЕстьКритичныеОшибки(Ошибки)).ЭтоЛожь();
КонецПроцедуры

Процедура ТолькоПредупреждения_ЕстьКритичная() Экспорт
	Ошибки = Новый Массив;
	Ошибки.Добавить(Новый Структура("Код", "OPERATION_RESPONSES_EMPTY_WARN"));
	Ошибки.Добавить(Новый Структура("Код", "OPENAPI_INVALID_VERSION"));

	ЮТест.ОжидаетЧто(Swag_Модель.ТолькоПредупреждения(Ошибки)).ЭтоЛожь();
