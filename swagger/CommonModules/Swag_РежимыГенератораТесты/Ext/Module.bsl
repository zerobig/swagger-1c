		.ДобавитьТестовыйНабор("Swag: Режимы - утилиты классификации")
			.ДобавитьТест("ТолькоПредупреждения_ПустойМассив")
			.ДобавитьТест("ТолькоПредупреждения_ТолькоЗамечанияWarn")
			.ДобавитьТест("ТолькоПредупреждения_ЕстьКритичная")
			.ДобавитьТест("ЕстьКритичныеОшибки_ПустойМассив")
		.ДобавитьТестовыйНабор("Swag: Режимы - мягкий режим в валидаторе")
			.ДобавитьТест("МягкийРежим_ResponsesПустые_КодWarn")
			.ДобавитьТест("СтрогийРежим_ResponsesПустые_КодMissing")
			.ДобавитьТест("МягкийРежим_ResponsesЕсть_БезОшибок")
		.ДобавитьТестовыйНабор("Swag: Режимы - формирование JSON")
			.ДобавитьТест("РежимВыкл_СтарыйГенератор")
			.ДобавитьТест("РежимМягкий_НовыйГенератор")
			.ДобавитьТест("РежимСтрогий_ВалиднаяМодель")
			.ДобавитьТест("РежимСтрогий_НевалиднаяМодель_Fallback")
			.ДобавитьТест("СформироватьНовымГенератором_МягкийВсегдаОтдаётJSON")
			.ДобавитьТест("СформироватьНовымГенератором_СтрогийЗависитОтКонфигурации")
		.ДобавитьТестовыйНабор("Swag: Режимы - сериализатор не выводит служебные поля")
			.ДобавитьТест("Сериализатор_СлужебныеПоляНеВJSON")
		.ДобавитьТестовыйНабор("Swag: Режимы - диагностика описаний")
			.ДобавитьТест("Диагностика_ВалидныйСервис_ПустойОтчёт")
			.ДобавитьТест("Диагностика_ЕстьЗамечания_ОтчётНеПустой")
