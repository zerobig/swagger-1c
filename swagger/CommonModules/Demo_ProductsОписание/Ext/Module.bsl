////////////////////////////////////////////////////////////////////////////////
// Demo_ProductsОписание - описание HTTP-сервиса Demo_Products.
//
// Демонстрирует правильные практики оформления OpenAPI через swagger-1c:
//   - переиспользуемая схема Product через components.schemas;
//   - описание всех параметров с типом, обязательностью, ограничениями;
//   - описание тела запроса и всех возможных ответов (включая ошибки);
//   - использование operationId в формате <ИмяСервиса>_<ИмяМетода>
//     (нужно для читаемых SDK, необязательно для валидации).
//
// Имена методов - это <ИмяШаблонаURL> + <HTTPМетод>:
//   ТоварыGET  → GET  /demo/products
//   ТоварGET   → GET  /demo/products/{id}
//   ТоварыPOST → POST /demo/products
//   ТоварPUT   → PUT  /demo/products/{id}
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Общие настройки сервиса. Используется для описания тега в swagger.json
// и для возможности скрыть сервис из документации.
Функция ПолучитьОбщиеНастройки() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Описание",
		"Демонстрационный API товаров. Пример правильного использования swagger-1c.");
	Настройки.Вставить("НеОтображать", Ложь);
	Возврат Настройки;

КонецФункции

// Схемы (objects), которые используются в описании методов.
//
// Product - основная модель. Используется и в ответах (GET),
// и в теле запроса (POST/PUT). Описывается один раз и переиспользуется
// через $ref.
Функция ПолучитьОбъектыHTTPСервиса() Экспорт

	Объекты = Swag_Описание
		.Объект("DemoProduct")
		.ОписаниеОбъекта("Товар в демонстрационном каталоге")
		.ОбязательныеПоля("id, name, price, stock")
		.Свойство("id")
		.ОписаниеСвойства("Уникальный идентификатор")
		.ТипЗначения("string")
		.ФорматЗначения("uuid")
		.Свойство("name")
		.ОписаниеСвойства("Наименование товара")
		.ТипЗначения("string")
		.МинимальнаяДлина(1)
		.МаксимальнаяДлина(200)
		.Свойство("description")
		.ОписаниеСвойства("Подробное описание")
		.ТипЗначения("string")
		.МаксимальнаяДлина(2000)
		.ДопускаетNull()
		.Свойство("price")
		.ОписаниеСвойства("Цена, руб.")
		.ТипЗначения("number")
		.Минимум(0)
		.Свойство("stock")
		.ОписаниеСвойства("Остаток на складе")
		.ТипЗначения("integer")
		.Минимум(0)
		.Свойство("category")
		.ОписаниеСвойства("Категория товара")
		.ТипЗначения("string")
		.ЗначениеПеречисления("electronics")
		.ЗначениеПеречисления("clothing")
		.ЗначениеПеречисления("food")
		.ЗначениеПеречисления("other")
		//
		.Объект("DemoProductInput")
		.ОписаниеОбъекта("Данные для создания или обновления товара")
		.ОбязательныеПоля("name, price")
		.Свойство("name")
		.ТипЗначения("string")
		.МинимальнаяДлина(1)
		.МаксимальнаяДлина(200)
		.Свойство("description")
		.ТипЗначения("string")
		.МаксимальнаяДлина(2000)
		.ДопускаетNull()
		.Свойство("price")
		.ТипЗначения("number")
		.Минимум(0)
		.Свойство("stock")
		.ТипЗначения("integer")
		.Минимум(0)
		.Свойство("category")
		.ТипЗначения("string")
		.ЗначениеПеречисления("electronics")
		.ЗначениеПеречисления("clothing")
		.ЗначениеПеречисления("food")
		.ЗначениеПеречисления("other")
		//
		.Объект("DemoProductList")
		.ОписаниеОбъекта("Постраничный список товаров")
		.ОбязательныеПоля("items, total, page, limit, pages")
		.Свойство("items")
		.ОписаниеСвойства("Товары на странице")
		.ТипЗначения("array")
		.Схема("DemoProduct")
		.Свойство("total")
		.ТипЗначения("integer")
		.Минимум(0)
		.Свойство("page")
		.ТипЗначения("integer")
		.Минимум(1)
		.Свойство("limit")
		.ТипЗначения("integer")
		.Минимум(1)
		.Свойство("pages")
		.ТипЗначения("integer")
		.Минимум(0)
		//
		.Объект("DemoError")
		.ОписаниеОбъекта("Структура ошибки API")
		.ОбязательныеПоля("code, message")
		.Свойство("code")
		.ТипЗначения("string")
		.Свойство("message")
		.ТипЗначения("string")
		.Свойство("details")
		.ОписаниеСвойства("Детали валидации")
		.ТипЗначения("array")
		.Схема("DemoErrorDetail")
		//
		.Объект("DemoErrorDetail")
		.ОбязательныеПоля("path, message")
		.Свойство("path")
		.ТипЗначения("string")
		.Свойство("message")
		.ТипЗначения("string")
		.Сформировать();

	Возврат Объекты;

КонецФункции

// Описание методов HTTP-сервиса.
Функция ПолучитьОписаниеHTTPСервиса() Экспорт

	Объекты = ПолучитьОбъектыHTTPСервиса();

	МассивМетодов = Swag_Описание
		// ============ GET /demo/products ============
		.Метод("ТоварыGET")
		.ОписаниеМетода("Список товаров с фильтрами и пагинацией")
		.ДетальноеОписаниеМетода(
			"Возвращает постраничный список товаров. "
			+ "Поддерживает поиск по имени и сортировку.")
		.ПараметрЗапроса("page")
		.ОписаниеПараметра("Номер страницы, начиная с 1")
		.ТипЗначения("integer")
		.ПараметрЗапроса("limit")
		.ОписаниеПараметра("Размер страницы, от 1 до 100")
		.ТипЗначения("integer")
		.ПараметрЗапроса("search")
		.ОписаниеПараметра("Поиск по имени (подстрока)")
		.ТипЗначения("string")
		.МаксимальнаяДлина(200)
		.ПараметрЗапроса("sort")
		.ОписаниеПараметра("Сортировка")
		.ТипЗначения("string")
		.ЗначениеПеречисления("name_asc")
		.ЗначениеПеречисления("name_desc")
		.ЗначениеПеречисления("price_asc")
		.ЗначениеПеречисления("price_desc")
		.Ответ(200)
		.ОписаниеОтвета("Постраничный список товаров")
		.ТипОтвета("application/json")
		.СхемаОтвета("DemoProductList")
		.Ответ(400)
		.ОписаниеОтвета("Некорректные параметры запроса")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[3].Имя) // DemoError

		// ============ GET /demo/products/{id} ============
		.Метод("ТоварGET")
		.ОписаниеМетода("Товар по идентификатору")
		.ПараметрURL("id")
		.ОписаниеПараметра("UUID товара")
		.ТипЗначения("string")
		.Ответ(200)
		.ОписаниеОтвета("Найденный товар")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[0].Имя) // DemoProduct
		.Ответ(404)
		.ОписаниеОтвета("Товар не найден")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[3].Имя) // DemoError

		// ============ POST /demo/products ============
		.Метод("ТоварыPOST")
		.ОписаниеМетода("Создание товара")
		.Тело("Данные нового товара")
		.ТипТела("application/json")
		.СхемаТела(Объекты[1].Имя) // DemoProductInput
		.Ответ(201)
		.ОписаниеОтвета("Созданный товар")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[0].Имя) // DemoProduct
		.Ответ(400)
		.ОписаниеОтвета("Некорректное тело запроса")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[3].Имя) // DemoError
		.Ответ(422)
		.ОписаниеОтвета("Ошибка валидации")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[3].Имя) // DemoError

		// ============ PUT /demo/products/{id} ============
		.Метод("ТоварPUT")
		.ОписаниеМетода("Обновление товара")
		.ПараметрURL("id")
		.ОписаниеПараметра("UUID товара")
		.ТипЗначения("string")
		.Тело("Новые данные товара")
		.ТипТела("application/json")
		.СхемаТела(Объекты[1].Имя) // DemoProductInput
		.Ответ(200)
		.ОписаниеОтвета("Обновлённый товар")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[0].Имя) // DemoProduct
		.Ответ(404)
		.ОписаниеОтвета("Товар не найден")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[3].Имя) // DemoError
		.Ответ(422)
		.ОписаниеОтвета("Ошибка валидации")
		.ТипОтвета("application/json")
		.СхемаОтвета(Объекты[3].Имя) // DemoError

		.Сформировать();

	Возврат МассивМетодов;

КонецФункции

#КонецОбласти
