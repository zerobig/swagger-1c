////////////////////////////////////////////////////////////////////////////////
// Demo_RPCОписание - описание JSON-RPC-сервиса Demo_RPC в формате OpenRPC.
//
// Протокол = "json-rpc" - указывает, что сервис участвует в сборке
// openrpc.json (GET /swagger/json-rpc.json), а не в swagger.json.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция ПолучитьОбщиеНастройки() Экспорт

    Настройки = Новый Структура;
    Настройки.Вставить("Описание",
        "Демонстрационный JSON-RPC 2.0 API. "
        + "Пример использования OpenRPC через swagger-1c.");
    Настройки.Вставить("НеОтображать", Ложь);
    Настройки.Вставить("Протокол", "json-rpc");
    Возврат Настройки;

КонецФункции

Функция ПолучитьОбъектыHTTPСервиса() Экспорт

    Объекты = Swag_Описание
        // [0] EchoResult
        .Объект("DemoRPCEchoResult")
            .ОписаниеОбъекта("Результат метода echo")
            .ОбязательныеПоля("message")
            .Свойство("message")
                .ОписаниеСвойства("Возвращённое сообщение")
                .ТипЗначения("string")
        // [1] SumResult
        .Объект("DemoRPCSumResult")
            .ОписаниеОбъекта("Результат метода sum")
            .ОбязательныеПоля("value")
            .Свойство("value")
                .ОписаниеСвойства("Сумма двух чисел")
                .ТипЗначения("number")
        // [2] TimeResult
        .Объект("DemoRPCTimeResult")
            .ОписаниеОбъекта("Результат метода time.now")
            .ОбязательныеПоля("timestamp")
            .Свойство("timestamp")
                .ОписаниеСвойства("Текущее время сервера")
                .ТипЗначения("string")
                .ФорматЗначения("date-time")
        // [3] Product
        .Объект("DemoRPCProduct")
            .ОписаниеОбъекта("Товар")
            .ОбязательныеПоля("id, name, price, stock")
            .Свойство("id")
                .ТипЗначения("string")
                .ФорматЗначения("uuid")
            .Свойство("name")
                .ТипЗначения("string")
                .МинимальнаяДлина(1)
                .МаксимальнаяДлина(200)
            .Свойство("price")
                .ТипЗначения("number")
                .Минимум(0)
            .Свойство("stock")
                .ТипЗначения("integer")
                .Минимум(0)
        // [4] ProductList
        .Объект("DemoRPCProductList")
            .ОписаниеОбъекта("Постраничный список товаров")
            .ОбязательныеПоля("items, total, page, limit, pages")
            .Свойство("items")
                .ТипЗначения("array")
                .Схема("DemoRPCProduct")
            .Свойство("total")
                .ТипЗначения("integer")
                .Минимум(0)
            .Свойство("page")
                .ТипЗначения("integer")
                .Минимум(1)
            .Свойство("limit")
                .ТипЗначения("integer")
                .Минимум(1)
            .Свойство("pages")
                .ТипЗначения("integer")
                .Минимум(0)
        .Сформировать();

    Возврат Объекты;

КонецФункции

Функция ПолучитьОписаниеHTTPСервиса() Экспорт

    Объекты = ПолучитьОбъектыHTTPСервиса();

    МассивМетодов = Swag_Описание
        // ============ echo ============
        .Метод("echo")
            .ОписаниеМетода("Возвращает переданное сообщение")
            .ДетальноеОписаниеМетода(
                "Простой эхо-метод для проверки работоспособности endpoint.")
            .ПараметрЗапроса("message")
                .ОписаниеПараметра("Текст сообщения, до 1000 символов")
                .ТипЗначения("string")
                .МаксимальнаяДлина(1000)
                .Обязательный()
            .Ответ(200)
                .ОписаниеОтвета("OK")
                .ТипОтвета("application/json")
                    .СхемаОтвета(Объекты[0].Имя)

        // ============ sum ============
        .Метод("sum")
            .ОписаниеМетода("Сумма двух чисел")
            .ПараметрЗапроса("a")
                .ОписаниеПараметра("Первое слагаемое")
                .ТипЗначения("number")
                .Обязательный()
            .ПараметрЗапроса("b")
                .ОписаниеПараметра("Второе слагаемое")
                .ТипЗначения("number")
                .Обязательный()
            .Ответ(200)
                .ОписаниеОтвета("OK")
                .ТипОтвета("application/json")
                    .СхемаОтвета(Объекты[1].Имя)

        // ============ time.now ============
        .Метод("time.now")
            .ОписаниеМетода("Текущее время сервера")
            .Ответ(200)
                .ОписаниеОтвета("OK")
                .ТипОтвета("application/json")
                    .СхемаОтвета(Объекты[2].Имя)

        // ============ products.list ============
        .Метод("products.list")
            .ОписаниеМетода("Постраничный список товаров")
            .ПараметрЗапроса("page")
                .ОписаниеПараметра("Номер страницы, начиная с 1")
                .ТипЗначения("integer")
            .ПараметрЗапроса("limit")
                .ОписаниеПараметра("Размер страницы, от 1 до 100")
                .ТипЗначения("integer")
            .Ответ(200)
                .ОписаниеОтвета("OK")
                .ТипОтвета("application/json")
                    .СхемаОтвета(Объекты[4].Имя)

        // ============ products.get ============
        .Метод("products.get")
            .ОписаниеМетода("Товар по идентификатору")
            .ПараметрЗапроса("id")
                .ОписаниеПараметра("UUID товара")
                .ТипЗначения("string")
                .Обязательный()
            .Ответ(200)
                .ОписаниеОтвета("OK")
                .ТипОтвета("application/json")
                    .СхемаОтвета(Объекты[3].Имя)

        .Сформировать();

    Возврат МассивМетодов;

КонецФункции

#КонецОбласти
