	Схема = Новый Структура("type", "string");
	СхемаZod = Swag_ZodАдаптер.СхемаВZod(Схема, Новый Соответствие);

	ЮТест.ОжидаетЧто(СхемаZod.Проверить("abc").Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(СхемаZod.Проверить(123).Успех).ЭтоЛожь();
КонецПроцедуры

