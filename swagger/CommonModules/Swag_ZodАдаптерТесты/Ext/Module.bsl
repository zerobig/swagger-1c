// ============ ПРОВЕРКА ЗАПРОСА ============

Процедура ПроверитьЗапрос_ВалидныйJSON() Экспорт
	Если ПропуститьБезZod() Тогда Возврат; КонецЕсли;

	// Собираем модель с операцией POST /test и телом {name: string}
	Модель = СобратьМодельСТелом();

	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоКакСтроку("{""name"":""Иван""}");

	Результат = Swag_ZodАдаптер.ПроверитьЗапросПоМодели(
			Модель, "/test", "post", Запрос);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.name).Равно("Иван");
КонецПроцедуры

Процедура ПроверитьЗапрос_НевалидныйJSON() Экспорт
	Если ПропуститьБезZod() Тогда Возврат; КонецЕсли;

	Модель = СобратьМодельСТелом();

	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоКакСтроку("{""name"":123}");

	Результат = Swag_ZodАдаптер.ПроверитьЗапросПоМодели(
			Модель, "/test", "post", Запрос);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Больше(0);
КонецПроцедуры

Процедура ПроверитьЗапрос_ОбязательныйПараметр() Экспорт
	Если ПропуститьБезZod() Тогда Возврат; КонецЕсли;

	Модель = СобратьМодельСПараметром();

	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	// Не передаём обязательный page

	Результат = Swag_ZodАдаптер.ПроверитьЗапросПоМодели(
			Модель, "/test", "get", Запрос);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Ошибки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ошибки[0].Путь).Равно("page");
КонецПроцедуры

Процедура ПроверитьЗапрос_ОпциональныйПараметрОтсутствует() Экспорт
	Если ПропуститьБезZod() Тогда Возврат; КонецЕсли;

	Модель = СобратьМодельСПараметром();

	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	Запрос.ПараметрыЗапроса.Вставить("page", "5");
	// limit не передан - опциональный

	Результат = Swag_ZodАдаптер.ПроверитьЗапросПоМодели(
			Модель, "/test", "get", Запрос);

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Данные.page).Равно(5); // приведено
КонецПроцедуры

Процедура ПроверитьЗапрос_НетОперации_Пропускаем() Экспорт
	Если ПропуститьБезZod() Тогда Возврат; КонецЕсли;

	// Пустая модель - операция не найдена, валидация пропускается
	Модель = Swag_Модель.НовоеОписание("API", "1.0");

	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	Результат = Swag_ZodАдаптер.ПроверитьЗапросПоМодели(
			Модель, "/несуществующий", "post", Запрос);

	ЮТест.ОжидаетЧто(Результат.Успех,
		"Если операции нет - пропускаем без ошибки").ЭтоИстина();
КонецПроцедуры

// ============ ХЕЛПЕРЫ ДЛЯ ТЕСТОВ ============

Функция СобратьМодельСТелом()
	Модель = Swag_Модель.НовоеОписание("API", "1.0");

	Операция = Swag_Модель.НоваяОперация("post", "/test")
		.OperationId("ТестPOST")
		.ТелоЗапроса(Swag_Модель.СхемаОбъект()
			.Свойство("name", Swag_Модель.СхемаСтрока())
			.Требует("name")
			.Сформировать())
		.Ответ("200", "OK")
		.Сформировать();

	Возврат Swag_Модель.ДобавитьОперацию(Модель, Операция);
КонецФункции

Функция СобратьМодельСПараметром()
	Модель = Swag_Модель.НовоеОписание("API", "1.0");

	Операция = Swag_Модель.НоваяОперация("get", "/test")
		.OperationId("ТестGET")
		.Параметр("page", "query", Swag_Модель.СхемаЦелое(), , Истина)
		.Параметр("limit", "query", Swag_Модель.СхемаЦелое())
		.Ответ("200", "OK")
		.Сформировать();

	Возврат Swag_Модель.ДобавитьОперацию(Модель, Операция);
КонецФункции

// Возвращает Истина, если тест нужно пропустить.
Функция ПропуститьБезZod()
	Если НЕ Swag_ZodАдаптер.ЕстьZod() Тогда
		ЮТест.Пропустить("zod-1c не установлен");
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции
