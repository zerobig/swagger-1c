	Схема.Вставить("required", ЮТКоллекции.ЗначениеВМассиве("id"));

	СхемаZod = Swag_ZodАдаптер.СхемаВZod(Схема, Новый Соответствие);

	Данные = Новый Структура("id, count", "abc", 5);
	ЮТест.ОжидаетЧто(СхемаZod.Проверить(Данные).Успех).ЭтоИстина();

	// Без обязательного id
	ЮТест.ОжидаетЧто(СхемаZod.Проверить(Новый Структура("count", 5)).Успех).ЭтоЛожь();
