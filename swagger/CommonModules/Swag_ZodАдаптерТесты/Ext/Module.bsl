Процедура ИсполняемыеСценарии() Экспорт

	// Если zod-1c не установлен - не регистрируем тесты.
	// YaxUnit увидит пустой набор и не будет падать.
	Если НЕ Swag_ZodАдаптер.ЕстьZod() Тогда
		Возврат;
	КонецЕсли;

	ЮТТесты
		.ДобавитьТестовыйНабор("Swag_ZodАдаптер: маппинг схем")
			.ДобавитьТест("СтрокаВZod")
			.ДобавитьТест("ЦелоеВZod")
			.ДобавитьТест("БулевоВZod")
			.ДобавитьТест("МассивСтрокВZod")
			.ДобавитьТест("ОбъектВZod")
			.ДобавитьТест("ПеречислениеВZod")
			.ДобавитьТест("ОбъединениеВZod")
			.ДобавитьТест("RefРазрешается")
			.ДобавитьТест("NullableДелаетНеобязательным")
			.ДобавитьТест("ОграниченияСтрокиВZod")
			.ДобавитьТест("ОграниченияЧислаВZod")
		.ДобавитьТестовыйНабор("Swag_ZodАдаптер: проверка запроса")
			.ДобавитьТест("ПроверитьЗапрос_ВалидныйJSON")
			.ДобавитьТест("ПроверитьЗапрос_НевалидныйJSON")
			.ДобавитьТест("ПроверитьЗапрос_ОбязательныйПараметр")
			.ДобавитьТест("ПроверитьЗапрос_ОпциональныйПараметрОтсутствует")
			.ДобавитьТест("ПроверитьЗапрос_НетОперации_Пропускаем")
	;
КонецПроцедуры

// ============ МАППИНГ ============

Процедура СтрокаВZod() Экспорт
