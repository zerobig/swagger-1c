		.ДобавитьТестовыйНабор("OpenAPI 3.1: корень")
			.ДобавитьТест("КореньСодержитOpenapiInfoPaths")
			.ДобавитьТест("InfoСодержитTitleИVersion")
		.ДобавитьТестовыйНабор("OpenAPI 3.1: paths и operations")
			.ДобавитьТест("ПутиНачинаютсяСоСлэша")
			.ДобавитьТест("КаждаяОперацияИмеетResponses")
			.ДобавитьТест("PathПараметрыRequiredTrue")
		.ДобавитьТестовыйНабор("OpenAPI 3.1: Schema")
			.ДобавитьТест("TypeТолькоИзДопустимых")
			.ДобавитьТест("NullableПревращаетсяВTypeNull")
			.ДобавитьТест("ExclusiveMinimumЭтоЧисло")
			.ДобавитьТест("RefНачинаетсяСПрефикса")
			.ДобавитьТест("RefНеИмеетСоседей")
			.ДобавитьТест("МассивИмеетItems")
			.ДобавитьТест("ОбъектИмеетProperties")
		.ДобавитьТестовыйНабор("OpenAPI 3.1: параметры и content")
			.ДобавитьТест("ПараметрИмеетNameInSchema")
			.ДобавитьТест("MediaTypeИмеетSchema")
		.ДобавитьТестовыйНабор("OpenAPI 3.1: security")
			.ДобавитьТест("SecuritySchemeТипИзСписка")
			.ДобавитьТест("HttpSchemeBasicИлиBearer")
			.ДобавитьТест("OAuth2ИмеетFlowsИScopes")
		.ДобавитьТестовыйНабор("OpenAPI 3.1: эталонный пример 1С API")
			.ДобавитьТест("ЭталонныйПримерСоответствуетИнвариантам")
		;
КонецПроцедуры

// ============ ВСПОМОГАТЕЛЬНЫЕ ============

// Собирает эталонный «1С-подобный» API: список товаров + создание заказа + security.
Функция СобратьЭталонноеОписание()

	Описание = Swag_Модель.НовоеОписание("Магазин API", "1.0.0");

	Описание = Swag_Модель.ДобавитьСервер(Описание,
			"https://api.example.com", "Продакшен");

	Описание = Swag_Модель.ДобавитьSecurityScheme(Описание, "bearerAuth",
			Swag_Модель.SecurityBearer("JWT от 1С"));
	Описание = Swag_Модель.УстановитьГлобальныйSecurity(Описание, "bearerAuth");

	// Схема: Product
	Описание = Swag_Модель.ДобавитьСхему(Описание, "Product",
			Swag_Модель.СхемаОбъект()
			.Свойство("id", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
			.Свойство("sku", Swag_Модель.СхемаСтрока().МинДлина(1).МаксДлина(50))
			.Свойство("name", Swag_Модель.СхемаСтрока().МинДлина(1))
			.Свойство("price", Swag_Модель.СхемаЧисло().Минимум(0))
			.Свойство("description", Swag_Модель.СхемаСтрока().ДопускаетNull())
			.Требует("id")
			.Требует("sku")
			.Требует("name")
			.Требует("price")
			.Сформировать());

	// Схема: OrderInput
	Описание = Swag_Модель.ДобавитьСхему(Описание, "OrderInput",
			Swag_Модель.СхемаОбъект()
			.Свойство("customerId", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
			.Свойство("items", Swag_Модель.СхемаМассив(
					Swag_Модель.СхемаОбъект()
					.Свойство("productId", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
					.Свойство("quantity", Swag_Модель.СхемаЦелое().Минимум(1))
					.Требует("productId")
					.Требует("quantity")
					.Сформировать()
				).МинЭлементов(1).Сформировать())
			.Свойство("comment", Swag_Модель.СхемаСтрока().МаксДлина(500).ДопускаетNull())
			.Требует("customerId")
			.Требует("items")
			.Сформировать());

	// Операция: GET /products
	Операция = Swag_Модель.НоваяОперация("get", "/products")
		.OperationId("listProducts")
		.КраткоеОписание("Список товаров")
		.Параметр("page", "query", Swag_Модель.СхемаЦелое().Минимум(1))
		.Параметр("limit", "query", Swag_Модель.СхемаЦелое().Минимум(1).Максимум(100))
		.Параметр("search", "query", Swag_Модель.СхемаСтрока())
		.Ответ("200", "OK", Swag_Модель.СхемаМассив(Swag_Модель.СхемаСсылка("Product")))
		.Ответ("400", "Bad request")
		.Сформировать();
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);

	// Операция: GET /products/{id}
	Операция = Swag_Модель.НоваяОперация("get", "/products/{id}")
		.OperationId("getProduct")
		.Параметр("id", "path", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
		.Ответ("200", "OK", Swag_Модель.СхемаСсылка("Product"))
		.Ответ("404", "Not found")
		.Сформировать();
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);

	// Операция: POST /orders
	Операция = Swag_Модель.НоваяОперация("post", "/orders")
		.OperationId("createOrder")
		.ТелоЗапроса(Swag_Модель.СхемаСсылка("OrderInput"), "Данные заказа")
		.Ответ("201", "Created", Swag_Модель.СхемаОбъект()
			.Свойство("orderId", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
			.Свойство("status", Swag_Модель.СхемаСтрока())
			.Требует("orderId")
			.Требует("status")
			.Сформировать())
		.Ответ("400", "Bad request")
		.Ответ("401", "Unauthorized")
		.Сформировать();
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);

	Возврат Описание;

КонецФункции

Функция СериализоватьВСоответствие(Описание)
	ТекстJSON = Swag_СериализаторOpenAPI.Сериализовать(Описание);
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);
КонецФункции

Функция СхемаИзКомпонент(Данные, Имя)
	Возврат Данные.Получить("components").Получить("schemas").Получить(Имя);
КонецФункции

// ============ КОРЕНЬ ============

Процедура КореньСодержитOpenapiInfoPaths() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());

	ЮТест.ОжидаетЧто(Данные.Получить("openapi")).Равно("3.1.0");
	ЮТест.ОжидаетЧто(Данные.Получить("info")).ИмеетТип("Соответствие");
	ЮТест.ОжидаетЧто(Данные.Получить("paths")).ИмеетТип("Соответствие");
	ЮТест.ОжидаетЧто(Данные.Получить("components")).ИмеетТип("Соответствие");

КонецПроцедуры

Процедура InfoСодержитTitleИVersion() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Инфо = Данные.Получить("info");

	ЮТест.ОжидаетЧто(Инфо.Получить("title")).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Инфо.Получить("title")).НеРавно("");
	ЮТест.ОжидаетЧто(Инфо.Получить("version")).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Инфо.Получить("version")).НеРавно("");

КонецПроцедуры

// ============ PATHS И OPERATIONS ============

Процедура ПутиНачинаютсяСоСлэша() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	Для Каждого Путь Из Пути Цикл
		ЮТест.ОжидаетЧто(Лев(Путь.Ключ, 1),
			"Путь '" + Путь.Ключ + "' должен начинаться с /").Равно("/");
	КонецЦикла;

КонецПроцедуры

Процедура КаждаяОперацияИмеетResponses() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	Методы = ЮТКоллекции.ЗначениеВМассиве("get", "post", "put", "patch", "delete");

	Для Каждого Путь Из Пути Цикл
		PathItem = Путь.Значение;
		Для Каждого Метод Из Методы Цикл
			Если PathItem.Получить(Метод) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Операция = PathItem.Получить(Метод);
			Ответы = Операция.Получить("responses");
			ЮТест.ОжидаетЧто(Ответы,
				"Операция " + Метод + " " + Путь.Ключ + " без responses")
				.ИмеетТип("Соответствие");
			ЮТест.ОжидаетЧто(Ответы.Количество()).Больше(0);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура PathПараметрыRequiredTrue() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	Для Каждого Путь Из Пути Цикл
		PathItem = Путь.Значение;
		Для Каждого Метод Из ЮТКоллекции.ЗначениеВМассиве("get", "post", "put", "patch", "delete") Цикл
			Если PathItem.Получить(Метод) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Параметры = PathItem.Получить(Метод).Получить("parameters");
			Если Параметры = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Параметр Из Параметры Цикл
				Если Параметр.Получить("in") = "path" Тогда
					ЮТест.ОжидаетЧто(Параметр.Получить("required"),
						"Path-параметр '" + Параметр.Получить("name") + "' без required")
						.ЭтоИстина();
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// ============ SCHEMA ============

Процедура TypeТолькоИзДопустимых() Экспорт

	Допустимые = ЮТКоллекции.ЗначениеВМассиве(
			"string", "integer", "number", "boolean", "array", "object", "null");

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Схемы = Данные.Получить("components").Получить("schemas");

	Для Каждого Схема Из Схемы Цикл
		ПроверитьТипыРекурсивно(Схема.Значение, Допустимые, Схема.Ключ);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьТипыРекурсивно(Схема, Допустимые, Контекст)
	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Тип = Схема.Получить("type");
	Если Тип <> Неопределено Тогда
		Если ТипЗнч(Тип) = Тип("Массив") Тогда
			Для Каждого Элемент Из Тип Цикл
				ЮТест.ОжидаетЧто(Допустимые, "Тип '" + Строка(Элемент) + "' в " + Контекст)
					.Содержит(Элемент);
			КонецЦикла;
		Иначе
			ЮТест.ОжидаетЧто(Допустимые, "Тип '" + Строка(Тип) + "' в " + Контекст)
				.Содержит(Тип);
		КонецЕсли;
	КонецЕсли;
	Свойства = Схема.Получить("properties");
	Если ТипЗнч(Свойства) = Тип("Соответствие") Тогда
		Для Каждого Свойство Из Свойства Цикл
			ПроверитьТипыРекурсивно(Свойство.Значение, Допустимые,
				Контекст + "." + Свойство.Ключ);
		КонецЦикла;
	КонецЕсли;
	Items = Схема.Получить("items");
	Если Items <> Неопределено Тогда
		ПроверитьТипыРекурсивно(Items, Допустимые, Контекст + "[]");
	КонецЕсли;
КонецПроцедуры

Процедура NullableПревращаетсяВTypeNull() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Схема = СхемаИзКомпонент(Данные, "Product");

	// Поле description в Product - .ДопускаетNull()
	Description = Схема.Получить("properties").Получить("description");

	// nullable в JSON 3.1 не должно быть
	ЮТест.ОжидаетЧто(Description.Получить("nullable")).Равно(Неопределено);

	// type - массив с "null"
	Тип = Description.Получить("type");
	ЮТест.ОжидаетЧто(Тип).ИмеетТип("Массив");
	ЮТест.ОжидаетЧто(Тип).Содержит("string");
	ЮТест.ОжидаетЧто(Тип).Содержит("null");

КонецПроцедуры

Процедура ExclusiveMinimumЭтоЧисло() Экспорт

	// Специально собираем схему с exclusiveMinimum
	Описание = Swag_Модель.НовоеОписание("API", "1.0");
	Описание = Swag_Модель.ДобавитьСхему(Описание, "Amount",
			Swag_Модель.СхемаЧисло().ЭксклюзивныйМинимум(0).Сформировать());

	Данные = СериализоватьВСоответствие(Описание);
	Схема = СхемаИзКомпонент(Данные, "Amount");

	ЮТест.ОжидаетЧто(Схема.Получить("exclusiveMinimum")).Равно(0);
	ЮТест.ОжидаетЧто(Схема.Получить("minimum")).Равно(Неопределено);

КонецПроцедуры

Процедура RefНачинаетсяСПрефикса() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	СхемаGET = Пути.Получить("/products/{id}").Получить("get")
		.Получить("responses").Получить("200")
		.Получить("content").Получить("application/json")
		.Получить("schema");

	Ссылка = СхемаGET.Получить("$ref");
	ЮТест.ОжидаетЧто(Ссылка).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Лев(Ссылка, 21)).Равно("#/components/schemas/");

КонецПроцедуры

Процедура RefНеИмеетСоседей() Экспорт

	// В OpenAPI 3.1 $ref МОЖЕТ иметь соседей, но в нашей модели
	// мы не генерируем их в схемах, ссылающихся на другие схемы.
	// Проверяем, что типичная ссылка - «чистая».
	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	СхемаGET = Пути.Получить("/products/{id}").Получить("get")
		.Получить("responses").Получить("200")
		.Получить("content").Получить("application/json")
		.Получить("schema");

	КлючиСсылки = Новый Массив;
	Для Каждого Ключ Из СхемаGET Цикл
		КлючиСсылки.Добавить(Ключ.Ключ);
	КонецЦикла;

	ЮТест.ОжидаетЧто(КлючиСсылки).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(КлючиСсылки[0]).Равно("$ref");

КонецПроцедуры

Процедура МассивИмеетItems() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());

	// Ищем массив в схеме ответа GET /products
	СхемаМассива = Данные.Получить("paths").Получить("/products").Получить("get")
		.Получить("responses").Получить("200")
		.Получить("content").Получить("application/json")
		.Получить("schema");

	ЮТест.ОжидаетЧто(СхемаМассива.Получить("type")).Равно("array");
	ЮТест.ОжидаетЧто(СхемаМассива.Получить("items")).НеРавно(Неопределено);

КонецПроцедуры

Процедура ОбъектИмеетProperties() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());

	Для Каждого ИмяСхемы Из ЮТКоллекции.ЗначениеВМассиве("Product", "OrderInput") Цикл
		Схема = СхемаИзКомпонент(Данные, ИмяСхемы);
		ЮТест.ОжидаетЧто(Схема.Получить("type")).Равно("object");
		ЮТест.ОжидаетЧто(Схема.Получить("properties"),
			"Object-схема " + ИмяСхемы + " должна иметь properties")
			.ИмеетТип("Соответствие");
	КонецЦикла;

КонецПроцедуры

// ============ ПАРАМЕТРЫ И CONTENT ============

Процедура ПараметрИмеетNameInSchema() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	Параметры = Пути.Получить("/products").Получить("get").Получить("parameters");
	ЮТест.ОжидаетЧто(Параметры).ИмеетТип("Массив");
	ЮТест.ОжидаетЧто(Параметры.Количество()).Больше(0);

	Для Каждого Параметр Из Параметры Цикл
		ЮТест.ОжидаетЧто(Параметр.Получить("name")).НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(Параметр.Получить("in")).НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(Параметр.Получить("schema")).НеРавно(Неопределено);
	КонецЦикла;

КонецПроцедуры

Процедура MediaTypeИмеетSchema() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Пути = Данные.Получить("paths");

	RequestBody = Пути.Получить("/orders").Получить("post").Получить("requestBody");
	Content = RequestBody.Получить("content");

	Для Каждого Media Из Content Цикл
		ЮТест.ОжидаетЧто(Media.Значение.Получить("schema"),
			"MediaType '" + Media.Ключ + "' без schema").НеРавно(Неопределено);
	КонецЦикла;

КонецПроцедуры

// ============ SECURITY ============

Процедура SecuritySchemeТипИзСписка() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Schemes = Данные.Получить("components").Получить("securitySchemes");

	Допустимые = ЮТКоллекции.ЗначениеВМассиве("http", "apiKey", "oauth2");

	Для Каждого Схема Из Schemes Цикл
		Тип = Схема.Значение.Получить("type");
		ЮТест.ОжидаетЧто(Допустимые, "Тип '" + Строка(Тип) + "' в securitySchemes")
			.Содержит(Тип);
	КонецЦикла;

КонецПроцедуры

Процедура HttpSchemeBasicИлиBearer() Экспорт

	Данные = СериализоватьВСоответствие(СобратьЭталонноеОписание());
	Schemes = Данные.Получить("components").Получить("securitySchemes");

	Для Каждого Схема Из Schemes Цикл
		Если Схема.Значение.Получить("type") = "http" Тогда
			ЮТест.ОжидаетЧто(ЮТКоллекции.ЗначениеВМассиве("basic", "bearer"),
				"http scheme должен быть basic или bearer")
				.Содержит(Схема.Значение.Получить("scheme"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура OAuth2ИмеетFlowsИScopes() Экспорт

	// Собираем описание с OAuth2
	Описание = Swag_Модель.НовоеОписание("API", "1.0");
	Описание = Swag_Модель.ДобавитьSecurityScheme(Описание, "oauth2",
			Swag_Модель.SecurityOAuth2ClientCredentials(
				"https://auth.example.com/token",
				ЮТКоллекции.ЗначениеВМассиве("read", "write")));

	Данные = СериализоватьВСоответствие(Описание);
	OAuth = Данные.Получить("components").Получить("securitySchemes").Получить("oauth2");

	ЮТест.ОжидаетЧто(OAuth.Получить("type")).Равно("oauth2");
	ЮТест.ОжидаетЧто(OAuth.Получить("flows")).ИмеетТип("Соответствие");

	Flow = OAuth.Получить("flows").Получить("clientCredentials");
	ЮТест.ОжидаетЧто(Flow.Получить("tokenUrl")).Равно("https://auth.example.com/token");
	ЮТест.ОжидаетЧто(Flow.Получить("scopes")).ИмеетТип("Соответствие");
	ЮТест.ОжидаетЧто(Flow.Получить("scopes").Получить("read")).Равно("");
	ЮТест.ОжидаетЧто(Flow.Получить("scopes").Получить("write")).Равно("");

КонецПроцедуры

// ============ ЭТАЛОННЫЙ ПРИМЕР ============

Процедура ЭталонныйПримерСоответствуетИнвариантам() Экспорт

	Описание = СобратьЭталонноеОписание();

	// 1. Внутренняя валидация модели
	Результат = Swag_Модель.ПроверитьОписание(Описание);
	ЮТест.ОжидаетЧто(Результат.Валидно,
		"Модель невалидна: " + Swag_Модель.ТекстОшибок(Результат.Ошибки)).ЭтоИстина();

	// 2. Сериализация
	ТекстJSON = Swag_СериализаторOpenAPI.Сериализовать(Описание);
	ЮТест.ОжидаетЧто(ТекстJSON).НеРавно("");

	// 3. Парсинг обратно
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЮТест.ОжидаетЧто(Данные).ИмеетТип("Соответствие");

	// 4. Ключевые поля на месте
	ЮТест.ОжидаетЧто(Данные.Получить("openapi")).Равно("3.1.0");
	ЮТест.ОжидаетЧто(Данные.Получить("paths").Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Данные.Получить("components").Получить("schemas").Количество())
		.Равно(2);
	ЮТест.ОжидаетЧто(Данные.Получить("components").Получить("securitySchemes").Количество())
		.Равно(1);

	// 5. Все ссылки в JSON ведут на существующие схемы
	СуществующиеСхемы = Новый Соответствие;
	Для Каждого Схема Из Данные.Получить("components").Получить("schemas") Цикл
		СуществующиеСхемы.Вставить(Схема.Ключ, Истина);
	КонецЦикла;
	ПроверитьВсеСсылки(Данные, СуществующиеСхемы);

	Swag_СериализаторOpenAPI.СериализоватьВФайл(
		СобратьЭталонноеОписание(), "E:\1cv8\_github\etalon-swagger.json");

КонецПроцедуры

Процедура ПроверитьВсеСсылки(Узел, СуществующиеСхемы)
	Если ТипЗнч(Узел) = Тип("Соответствие") Тогда
		Ссылка = Узел.Получить("$ref");
		Если Ссылка <> Неопределено Тогда
			Имя = Сред(Ссылка, 22); // после "#/components/schemas/"
			ЮТест.ОжидаетЧто(СуществующиеСхемы, "Ссылка на несуществующую схему: " + Имя)
				.ИмеетСвойство(Имя);
		КонецЕсли;
		Для Каждого Поле Из Узел Цикл
			ПроверитьВсеСсылки(Поле.Значение, СуществующиеСхемы);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Узел) = Тип("Массив") Тогда
		Для Каждого Элемент Из Узел Цикл
			ПроверитьВсеСсылки(Элемент, СуществующиеСхемы);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
