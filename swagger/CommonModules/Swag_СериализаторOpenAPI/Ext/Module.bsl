////////////////////////////////////////////////////////////////////////////////
// Swag_СериализаторOpenAPI - превращает модель OpenAPI в JSON-строку.
//
// Поддерживает два формата:
//   3.1 (по умолчанию) - nullable → type: [..., "null"], exclusive - числа
//   3.0 (флаг СовместимостьС30) - nullable: true, exclusive - булев модификатор
//
// Сериализатор НЕ валидирует модель. Перед вызовом рекомендуется
// Swag_Модель.ПроверитьОписание(Модель) или ПроверитьОписаниеИлиВыбросить.
////////////////////////////////////////////////////////////////////////////////

// Возвращает JSON-строку.
Функция Сериализовать(Описание, СовместимостьС30 = Ложь) Экспорт

	ПодготовленнаяМодель = ПодготовитьМодель(Описание, СовместимостьС30);

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, ПодготовленнаяМодель);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Сериализует и сохраняет в файл. Полезно для локальной проверки в CI/отладке.
Процедура СериализоватьВФайл(Описание, ИмяФайла, СовместимостьС30 = Ложь) Экспорт

	ТекстJSON = Сериализовать(Описание, СовместимостьС30);

	ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(ТекстJSON);
	ЗаписьТекста.Закрыть();

КонецПроцедуры

// ============ ПОДГОТОВКА МОДЕЛИ ============

Функция ПодготовитьМодель(Значение, Флаг3_0)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		Возврат ПодготовитьОбъект(Значение, Флаг3_0);
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат ПодготовитьМассив(Значение, Флаг3_0);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ПодготовитьОбъект(Объект, Флаг3_0)

	Результат = Новый Соответствие;

	// Рекурсивный обход всех полей
	Для Каждого Поле Из Объект Цикл
		Результат.Вставить(Поле.Ключ, ПодготовитьМодель(Поле.Значение, Флаг3_0));
	КонецЦикла;

	// Служебные поля модели - не выводятся в JSON
	Результат.Удалить("_СтрогаяПроверка");

	// Переименование внутренних имён в имена OpenAPI
	ПереименоватьПоле(Результат, "ref", "$ref");
	ПереименоватьПоле(Результат, "location", "in");

	// Преобразования схем
	Если НЕ Флаг3_0 Тогда
		ПрименитьNullable31(Результат);
	Иначе
		ПрименитьExclusive30(Результат);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПодготовитьМассив(Массив, Флаг3_0)

	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		Результат.Добавить(ПодготовитьМодель(Элемент, Флаг3_0));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// ============ ПРЕОБРАЗОВАНИЯ ============

Процедура ПереименоватьПоле(Объект, СтароеИмя, НовоеИмя)

	// Строгое сравнение с Неопределено: если значение поля само Неопределено,
	// считаем, что поля нет (для ref/location это не встречается в модели).
	Значение = Объект.Получить(СтароеИмя);
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.Удалить(СтароеИмя);
	Объект.Вставить(НовоеИмя, Значение);

КонецПроцедуры

// В OpenAPI 3.1 nullable превращается в type: [исходный, "null"].
Процедура ПрименитьNullable31(Объект)

	Nullable = Объект.Получить("nullable");
	Если Nullable <> Истина Тогда
		Возврат;
	КонецЕсли;

	Тип = Объект.Получить("type");
	Если Тип = Неопределено Тогда
		// Валидатор уже должен был поругаться; оставляем как есть.
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Тип) = Тип("Массив") Тогда
		// Уже массив - добавляем "null", если ещё нет
		Для Каждого Элемент Из Тип Цикл
			Если Элемент = "null" Тогда
				Объект.Удалить("nullable");
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Тип.Добавить("null");
		Объект.Удалить("nullable");
		Возврат;
	КонецЕсли;

	ТипМассив = Новый Массив;
	ТипМассив.Добавить(Тип);
	ТипМассив.Добавить("null");
	Объект.Вставить("type", ТипМассив);
	Объект.Удалить("nullable");

КонецПроцедуры

// В OpenAPI 3.0 exclusiveMinimum / exclusiveMaximum - булевы модификаторы
// к minimum / maximum. В модели хранятся числа (формат 3.1).
Процедура ПрименитьExclusive30(Объект)

	ЭксМин = Объект.Получить("exclusiveMinimum");
	Если ЭксМин <> Неопределено И ТипЗнч(ЭксМин) <> Тип("Булево") Тогда
		Объект.Вставить("minimum", ЭксМин);
		Объект.Вставить("exclusiveMinimum", Истина);
	КонецЕсли;

	ЭксМакс = Объект.Получить("exclusiveMaximum");
	Если ЭксМакс <> Неопределено И ТипЗнч(ЭксМакс) <> Тип("Булево") Тогда
		Объект.Вставить("maximum", ЭксМакс);
		Объект.Вставить("exclusiveMaximum", Истина);
	КонецЕсли;

КонецПроцедуры

// Компактный JSON без переносов - для внешнего валидатора в CI.
Функция СериализоватьКомпактно(Описание, СовместимостьС30 = Ложь) Экспорт

	ПодготовленнаяМодель = ПодготовитьМодель(Описание, СовместимостьС30);

	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, ПодготовленнаяМодель);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции
