////////////////////////////////////////////////////////////////////////////////
// Swag_Сборщик - сканирует HTTP-сервисы конфигурации и собирает модель OpenAPI.
//
// Устойчив к ошибкам в пользовательских модулях <Имя>Описание:
//   - если модуль отсутствует - пропускаем сервис;
//   - если функция модуля упала - пропускаем её результат, пишем в журнал;
//   - если метод в Swag_ОбработкаHTTP упал - пропускаем метод.
// Контур не должен падать из-за ошибок разработчика в описаниях.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция СобратьМодель(Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = Новый Структура;
	КонецЕсли;

	СтрогаяПроверка = ПолучитьНастройкуБулево(Настройки, "СтрогаяПроверка", Ложь);

	Описание = Swag_Модель.НовоеОписание(
			ПолучитьНастройкуСтроку(Настройки, "Title", Метаданные.Имя),
			ПолучитьНастройкуСтроку(Настройки, "Version", Метаданные.Версия));

	// Служебный флаг - участвует в валидаторе, в JSON не попадает
	Описание.Вставить("_СтрогаяПроверка", СтрогаяПроверка);

	Если НЕ ПустаяСтрока(Метаданные.Комментарий) Тогда
		Описание.info.Вставить("description", Метаданные.Комментарий);
	КонецЕсли;

	URL = ПолучитьНастройкуСтроку(Настройки, "BaseURL", "");
	Если НЕ ПустаяСтрока(URL) Тогда
		Описание = Swag_Модель.ДобавитьСервер(Описание, URL);
	КонецЕсли;

	ИспользоватьBasic = ПолучитьНастройкуБулево(Настройки, "UseBasicAuth", Истина);
	Если ИспользоватьBasic Тогда
		Описание = Swag_Модель.ДобавитьSecurityScheme(Описание, "basic",
				Swag_Модель.SecurityBasic());
		Описание = Swag_Модель.УстановитьГлобальныйSecurity(Описание, "basic");
	КонецЕсли;

	Исключить = ПолучитьМассивИсключений();

	Для Каждого HTTPСервис Из Метаданные.HTTPСервисы Цикл

		Если HTTPСервис.Имя = "Swag_Сервис" Тогда
			Продолжить;
		КонецЕсли;
		Если Исключить.Найти(HTTPСервис.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Описание = БезопасноСобратьОписаниеСервиса(Описание, HTTPСервис);

	КонецЦикла;

	Возврат Описание;

КонецФункции

// Обёртка: один сломанный сервис не должен ронять сборку всей модели.
Функция БезопасноСобратьОписаниеСервиса(Описание, HTTPСервис) Экспорт

	Попытка
		Возврат СобратьОписаниеСервиса(Описание, HTTPСервис);
	Исключение
		ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
			"Сборка описания HTTP-сервиса не выполнена",
			ИнформацияОбОшибке());
		Возврат Описание;
	КонецПопытки;

КонецФункции

Функция СобратьОписаниеСервиса(Описание, HTTPСервис) Экспорт

	Модуль = ПолучитьМодульОписания(HTTPСервис.Имя);
	Если Модуль = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;

	// Общие настройки
	Общие = БезопасноПолучитьОбщиеНастройки(HTTPСервис.Имя, Модуль);
	Если Общие <> Неопределено
		И Общие.Свойство("НеОтображать")
		И Общие.НеОтображать = Истина Тогда
		Возврат Описание;
	КонецЕсли;

	// сервисы с протоколом json-rpc в swagger.json не попадают
	Если Общие <> Неопределено
		И Общие.Свойство("Протокол")
		И Общие.Протокол = "json-rpc" Тогда
		Возврат Описание;
	КонецЕсли;

	// Тег
	НаименованиеТега = ?(ЗначениеЗаполнено(HTTPСервис.Синоним),
			HTTPСервис.Синоним, HTTPСервис.Имя);
	ОписаниеТега = Неопределено;
	Если Общие <> Неопределено И Общие.Свойство("Описание") Тогда
		ОписаниеТега = Общие.Описание;
	ИначеЕсли НЕ ПустаяСтрока(HTTPСервис.Комментарий) Тогда
		ОписаниеТега = HTTPСервис.Комментарий;
	КонецЕсли;
	Описание = Swag_Модель.ДобавитьТег(Описание, НаименованиеТега, ОписаниеТега);

	// Схемы - независимая попытка, чтобы падение не убило методы
	МассивОбъектов = БезопасноПолучитьОбъекты(HTTPСервис.Имя, Модуль);
	Если МассивОбъектов <> Неопределено Тогда
		Попытка
			Для Каждого Схема Из Swag_АдаптерСовместимости.ПреобразоватьОбъекты(МассивОбъектов) Цикл
				Описание = Swag_Модель.ДобавитьСхему(Описание, Схема.Имя, Схема.Значение);
			КонецЦикла;
		Исключение
			ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
				"Не удалось преобразовать объекты (схемы) сервиса",
				ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	// Методы - независимая попытка
	МассивМетодов = БезопасноПолучитьМетоды(HTTPСервис.Имя, Модуль);
	Если МассивМетодов <> Неопределено Тогда
		Попытка
			Для Каждого Операция Из Swag_АдаптерСовместимости.ПреобразоватьМетоды(
					HTTPСервис, Модуль, МассивМетодов) Цикл
				Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);
			КонецЦикла;
		Исключение
			ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
				"Не удалось преобразовать методы сервиса",
				ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Возвращает отчёт по всем сервисам: какие описания стоит доработать.
// Работает всегда в мягком режиме, чтобы показать полный список замечаний.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки: Код, Путь, Сообщение, Критичность, Сервис.
//
Функция ДиагностикаОписаний() Экспорт

	Модель = СобратьМодель(Новый Структура("СтрогаяПроверка", Ложь));
	Проверка = Swag_Модель.ПроверитьОписание(Модель);

	Отчёт = Новый ТаблицаЗначений;
	Отчёт.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	Отчёт.Колонки.Добавить("URL", Новый ОписаниеТипов("Строка"));
	Отчёт.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка"));
	Отчёт.Колонки.Добавить("Критичность", Новый ОписаниеТипов("Строка"));
	Отчёт.Колонки.Добавить("Сервис", Новый ОписаниеТипов("Строка"));

	Для Каждого Ош Из Проверка.Ошибки Цикл

		Строка = Отчёт.Добавить();
		Строка.Код = Ош.Код;
		Строка.URL = ИзвлечьURLИзПути(Ош.Путь);
		Строка.Сообщение = Ош.Сообщение;
		Строка.Критичность = ?(Прав(Ош.Код, 5) = "_WARN", "Предупреждение", "Ошибка");
		Строка.Сервис = ИзвлечьИмяСервисаИзПути(Ош.Путь);

	КонецЦикла;

	Возврат Отчёт;

КонецФункции

// Разрешает пару (ИмяСервиса, ИмяМетода) в параметры HTTP-метода.
// ИмяМетода - это ШаблонURL.Имя + HTTPМетод (например "ТоварыGET").
//
// Параметры:
//   ИмяСервиса - Строка - имя HTTP-сервиса (как в конфигураторе)
//   ИмяМетода  - Строка - имя метода из модуля <Имя>Описание
//
// Возвращаемое значение:
//   Структура - {URL: Строка, HTTPМетод: Строка} или Неопределено
//
Функция ПараметрыHTTPМетода(ИмяСервиса, ИмяМетода) Экспорт

	HTTPСервис = Метаданные.HTTPСервисы.Найти(ИмяСервиса);
	Если HTTPСервис = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого ШаблонURL Из HTTPСервис.ШаблоныURL Цикл
		Для Каждого Метод Из ШаблонURL.Методы Цикл
			Если ШаблонURL.Имя + Метод.HTTPМетод = ИмяМетода Тогда
				Результат = Новый Структура;
				Результат.Вставить("URL",
					"/" + HTTPСервис.КорневойURL + ШаблонURL.Шаблон);
				Результат.Вставить("HTTPМетод", НРег(Метод.HTTPМетод));
				Возврат Результат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Собирает документ OpenRPC из HTTP-сервисов с Протокол = "json-rpc".
//
// Параметры:
//   Настройки - Структура - опционально:
//     * Title       - Строка - заголовок (по умолчанию Метаданные.Имя)
//     * Version     - Строка - версия (по умолчанию Метаданные.Версия)
//     * BaseURL     - Строка - базовый URL (хост из запроса)
//
// Возвращаемое значение:
//   Структура - документ OpenRPC или Неопределено, если ни одного
//   json-rpc сервиса нет.
//
Функция СобратьМодельOpenRPC(Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = Новый Структура;
	КонецЕсли;

	Документ = Новый Структура;
	Документ.Вставить("openrpc", "1.3.2");

	Инфо = Новый Структура;
	Инфо.Вставить("title",
		ПолучитьНастройкуСтроку(Настройки, "Title", Метаданные.Имя));
	Инфо.Вставить("version",
		ПолучитьНастройкуСтроку(Настройки, "Version", Метаданные.Версия));
	Документ.Вставить("info", Инфо);

	Документ.Вставить("servers", Новый Массив);
	Документ.Вставить("methods", Новый Массив);
	Компоненты = Новый Структура;
	Компоненты.Вставить("schemas", Новый Соответствие);
	Документ.Вставить("components", Компоненты);

	БазовыйURL = ПолучитьНастройкуСтроку(Настройки, "BaseURL", "");
	Исключить = ПолучитьМассивИсключений();

	// Для контроля уникальности имён методов между сервисами
	ИменаМетодов = Новый Соответствие;
	НайденХотяБыОдин = Ложь;

	Для Каждого HTTPСервис Из Метаданные.HTTPСервисы Цикл

		Если HTTPСервис.Имя = "Swag_Сервис" Тогда
			Продолжить;
		КонецЕсли;
		Если Исключить.Найти(HTTPСервис.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Модуль = ПолучитьМодульОписания(HTTPСервис.Имя);
		Если Модуль = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Общие = БезопасноПолучитьОбщиеНастройки(HTTPСервис.Имя, Модуль);
		Если Общие = Неопределено
			ИЛИ НЕ Общие.Свойство("Протокол")
			ИЛИ Общие.Протокол <> "json-rpc" Тогда
			Продолжить;
		КонецЕсли;

		Если Общие.Свойство("НеОтображать") И Общие.НеОтображать = Истина Тогда
			Продолжить;
		КонецЕсли;

		// Проверка ограничения: не более одного шаблона URL
		Если HTTPСервис.ШаблоныURL.Количество() > 1 Тогда
			ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
				"Описание json-rpc не может быть применено к HTTP-сервису "
				+ "с несколькими шаблонами. Сервис пропущен.", Неопределено);
			Продолжить;
		КонецЕсли;

		ДобавитьJSONRPCSервис(Документ, HTTPСервис, Модуль, БазовыйURL, ИменаМетодов);
		НайденХотяБыОдин = Истина;

	КонецЦикла;

	Если НЕ НайденХотяБыОдин Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Документ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ============ БЕЗОПАСНЫЕ ВЫЗОВЫ ПОЛЬЗОВАТЕЛЬСКОГО МОДУЛЯ ============

Функция БезопасноПолучитьОбъекты(ИмяСервиса, Модуль)

	Попытка
		Результат = Модуль.ПолучитьОбъектыHTTPСервиса();
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;
		ЗаписатьОшибкуСервиса(ИмяСервиса,
			"ПолучитьОбъектыHTTPСервиса вернула не Массив, а " + Строка(ТипЗнч(Результат)),
			Неопределено);
		Возврат Неопределено;
	Исключение
		ЗаписатьОшибкуСервиса(ИмяСервиса,
			"Ошибка в ПолучитьОбъектыHTTPСервиса",
			ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция БезопасноПолучитьМетоды(ИмяСервиса, Модуль)

	Попытка
		Результат = Модуль.ПолучитьОписаниеHTTPСервиса();
		Если ТипЗнч(Результат) = Тип("Массив") Тогда
			Возврат Результат;
		КонецЕсли;
		ЗаписатьОшибкуСервиса(ИмяСервиса,
			"ПолучитьОписаниеHTTPСервиса вернула не Массив, а " + Строка(ТипЗнч(Результат)),
			Неопределено);
		Возврат Неопределено;
	Исключение
		ЗаписатьОшибкуСервиса(ИмяСервиса,
			"Ошибка в ПолучитьОписаниеHTTPСервиса",
			ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция БезопасноПолучитьОбщиеНастройки(ИмяСервиса, Модуль)

	Попытка
		Результат = Модуль.ПолучитьОбщиеНастройки();
		Если ТипЗнч(Результат) = Тип("Структура") Тогда
			Возврат Результат;
		КонецЕсли;
		Возврат Неопределено;
	Исключение
		// Отсутствие ПолучитьОбщиеНастройки - штатная ситуация, не ошибка.
		// Пишем в журнал на уровне «Информация» только если функция есть, но падает.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// ============ ЛОГИРОВАНИЕ ============

Процедура ЗаписатьОшибкуСервиса(ИмяСервиса, Текст, ИнформацияОбОшибке = Неопределено)

	Детали = "";
	Если ИнформацияОбОшибке <> Неопределено Тогда
		Детали = ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"Swagger: Сборка модели OpenAPI",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		СтрШаблон("HTTP-сервис ""%1"". %2%3", ИмяСервиса, Текст, Детали));

КонецПроцедуры

// ============ ОСТАЛЬНОЕ ============

Функция ПолучитьМодульОписания(ИмяСервиса) Экспорт
	ИмяМодуля = ИмяСервиса + "Описание";
	Если Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ПолучитьМассивИсключений()
	Результат = Новый Массив;
	Если Метаданные.ОбщиеМодули.Найти("SwaggerОбщиеНастройки") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль("SwaggerОбщиеНастройки");
		Настройки = Модуль.ПолучитьОбщиеНастройки();
		Если ТипЗнч(Настройки) = Тип("Структура")
			И Настройки.Свойство("МассивНеотображаемыхСервисов")
			И ТипЗнч(Настройки.МассивНеотображаемыхСервисов) = Тип("Массив") Тогда
			Результат = Настройки.МассивНеотображаемыхСервисов;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Извлекает имя HTTP-сервиса из пути ошибки.
// Приблизительно: из "paths./swagger_test/first.get.responses" → "swagger_test"
// Точнее: используем URL-шаблон, чтобы понять, какому корневому URL принадлежит.
Функция ИзвлечьИмяСервисаИзПути(ПутьОшибки)

	Позиция = СтрНайти(ПутьОшибки, "paths.");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(ПутьОшибки, Позиция + 6); // после "paths."
	Конец = СтрНайти(Остаток, ".");
	Если Конец = 0 Тогда
		Возврат Остаток;
	КонецЕсли;

	Возврат Лев(Остаток, Конец - 1);

КонецФункции

// ============ ТИПИЗИРОВАННЫЕ НАСТРОЙКИ ============

Функция ПолучитьНастройкуБулево(Настройки, Имя, ПоУмолчанию)
	Значение = ПрочитатьЗначениеНастройки(Настройки, Имя);
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ПолучитьНастройкуСтроку(Настройки, Имя, ПоУмолчанию = "")
	Значение = ПрочитатьЗначениеНастройки(Настройки, Имя);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ?(ПустаяСтрока(Значение), ПоУмолчанию, Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ПрочитатьЗначениеНастройки(Настройки, Имя)
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Настройки);
	Если ТипЗначения = Тип("Структура") Тогда
		Результат = Неопределено;
		Если Настройки.Свойство(Имя, Результат) Тогда
			Возврат Результат;
		КонецЕсли;
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат Настройки.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ИзвлечьURLИзПути(ПутьОшибки)
	Позиция = СтрНайти(ПутьОшибки, "paths.");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(ПутьОшибки, Позиция + 6);
	// Отрезаем ".<метод>.<...>" - ищем первую точку после закрывающей "}"
	// или после последнего "/", смотря что встретится позже
	ПозицияМетода = НайтиНачалоМетода(Остаток);
	Возврат ?(ПозицияМетода > 0, Лев(Остаток, ПозицияМетода - 1), Остаток);
КонецФункции

Функция НайтиНачалоМетода(ПутьПослеPaths)
	// Ищем ".get.", ".post.", ".put.", ".patch.", ".delete." в строке
	Для Каждого Метод Из СтрРазделить("get,post,put,patch,delete", ",") Цикл
		Позиция = СтрНайти(ПутьПослеPaths, "." + Метод + ".");
		Если Позиция > 0 Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Процедура ДобавитьJSONRPCSервис(Документ, HTTPСервис, Модуль, БазовыйURL, ИменаМетодов)

	// 1. URL endpoint: единственный шаблон
	ШаблонURL = HTTPСервис.ШаблоныURL[0];
	URL = "/" + HTTPСервис.Имя + "/" + HTTPСервис.КорневойURL + ШаблонURL.Шаблон;
	Сервер = Новый Структура("url", БазовыйURL + URL);
	Документ.servers.Добавить(Сервер);

	// 2. Схемы в components.schemas
	МассивОбъектов = БезопасноПолучитьОбъекты(HTTPСервис.Имя, Модуль);
	Если МассивОбъектов <> Неопределено Тогда
		Попытка
			Для Каждого Схема Из Swag_АдаптерСовместимости.ПреобразоватьОбъекты(МассивОбъектов) Цикл
				Документ.components.schemas.Вставить(Схема.Имя, Схема.Значение);
			КонецЦикла;
		Исключение
			ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
				"Ошибка преобразования схем в OpenRPC", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	// 3. Методы
	МассивМетодов = БезопасноПолучитьМетоды(HTTPСервис.Имя, Модуль);
	Если МассивМетодов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По МассивМетодов.Количество() - 1 Цикл

		Метод = МассивМетодов[Индекс];
		Идентификатор = "метод #" + Строка(Индекс + 1);

		Попытка
			JSONRPCMетод = Swag_АдаптерСовместимости.ПреобразоватьМетодJSONRPC(Метод);
			Если JSONRPCMетод = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ИмяМетода = JSONRPCMетод.name;
			Идентификатор = "метод """ + ИмяМетода + """";

			Если ИменаМетодов.Получить(ИмяМетода) <> Неопределено Тогда
				ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
					СтрШаблон(
						"Имя JSON-RPC-метода ""%1"" уже используется в сервисе ""%2"". "
						+ "Метод пропущен.",
						ИмяМетода, ИменаМетодов.Получить(ИмяМетода)),
					Неопределено);
				Продолжить;
			КонецЕсли;
			ИменаМетодов.Вставить(ИмяМетода, HTTPСервис.Имя);

			Документ.methods.Добавить(JSONRPCMетод);
		Исключение
			ЗаписатьОшибкуСервиса(HTTPСервис.Имя,
				"Ошибка преобразования JSON-RPC-метода (" + Идентификатор + ")",
				ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
