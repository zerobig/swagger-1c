Процедура ДобавитьПуть() Экспорт

	Описание = Swag_Модель.НовоеОписание("API", "1.0");

	Операция = Swag_Модель.НоваяОперация("get", "/test")
		.КраткоеОписание("Тестовый метод")
		.Ответ("200", "OK")
		.Сформировать();

	// Диагностика 1: что вернула операция до попадания в paths
	ОтветыОперации = Неопределено;
	ЮТест.ОжидаетЧто(Операция.Свойство("responses", ОтветыОперации),
		"Операция.Сформировать() не вернула responses").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОтветыОперации).ИмеетТип("Соответствие");

	// Добавляем в описание
	Описание = Swag_Модель.ДобавитьОперацию(Описание, Операция);

	// Диагностика 2: PathItem
	PathItem = Описание.paths.Получить("/test");
	ЮТест.ОжидаетЧто(PathItem).ИмеетТип("Структура");

	// Диагностика 3: операция внутри PathItem
	ОперацияGET = Неопределено;
	ЮТест.ОжидаетЧто(PathItem.Свойство("get", ОперацияGET),
		"PathItem не содержит get").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОперацияGET).ИмеетТип("Структура");

	// Диагностика 4: responses внутри операции
	ОтветыGET = Неопределено;
	ЮТест.ОжидаетЧто(ОперацияGET.Свойство("responses", ОтветыGET),
		"Операция get не содержит responses - "
		+ "проверьте ДобавитьОперацию: она должна копировать ВСЕ поля, кроме method и path").ЭтоИстина();
	ЮТест.ОжидаетЧто(ОтветыGET).ИмеетТип("Соответствие");

	// Финальная проверка: код ответа 200
	ЮТест.ОжидаетЧто(ОтветыGET.Получить("200")).ИмеетТип("Структура");

КонецПроцедуры

Процедура ДобавитьСхемуВКомпоненты() Экспорт
	Описание = Swag_Модель.НовоеОписание("API", "1.0");

	Схема = Swag_Модель.СхемаОбъект()
		.Свойство("id", Swag_Модель.СхемаСтрока().ФорматЗначения("uuid"))
		.Свойство("name", Swag_Модель.СхемаСтрока())
		.Требует("id")
		.Требует("name")
		.Сформировать();

	Описание = Swag_Модель.ДобавитьСхему(Описание, "Customer", Схема);

	ЮТест.ОжидаетЧто(Описание.components.schemas.Получить("Customer"))
		.ИмеетТип("Структура")
		.Свойство("type").Равно("object")
		;
КонецПроцедуры

