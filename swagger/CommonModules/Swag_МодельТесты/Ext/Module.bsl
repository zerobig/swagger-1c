	Операция = Swag_Модель.НоваяОперация("get", "/test")
		.Сформировать();

	ЮТест.ОжидаетЧто(Операция)
		.ИмеетТип("Структура")
		.Свойство("method").Равно("get")
		.Свойство("path").Равно("/test")
		.Свойство("responses").ИмеетТип("Соответствие")
		;
	// parameters не вставляется, если пуст - это валидно по OpenAPI
	ЮТест.ОжидаетЧто(Операция.Свойство("parameters")).ЭтоЛожь();
