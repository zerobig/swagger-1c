////////////////////////////////////////////////////////////////////////////////
// Swag_ZodАдаптер - превращает модель OpenAPI в схемы zod-1c
// и предоставляет функции валидации запросов и ответов.
//
// Поиск операции - по (URL, HTTP-метод), а не по operationId.
// Это убирает зависимость от пользовательского поля operationId
// и позволяет находить операцию, даже если оно переопределено.
//
// ВАЖНО: модуль не содержит статических ссылок на общий модуль Zod.
// Ссылка получается динамически через Вычислить (как в БСП).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает Истина, если в конфигурации доступен общий модуль Zod (zod-1c).
Функция ЕстьZod() Экспорт

	Возврат Метаданные.ОбщиеМодули.Найти("Zod") <> Неопределено;

КонецФункции

// Проверяет входящий HTTP-запрос по описанию метода.
// Модель собирается заново - для high-load используйте ПроверитьЗапросПоМодели.
//
// Параметры:
//   ИмяСервиса - Строка - имя HTTP-сервиса (как в конфигураторе)
//   ИмяМетода  - Строка - имя метода из модуля <Имя>Описание (например "СоздатьPOST")
//   Запрос     - HTTPСервисЗапрос
//
// Возвращаемое значение:
//   Структура - {Успех: Булево, Данные: Структура, Ошибки: Массив}
//
Функция ПроверитьЗапрос(ИмяСервиса, ИмяМетода, Запрос) Экспорт

	Параметры = Swag_Сборщик.ПараметрыHTTPМетода(ИмяСервиса, ИмяМетода);
	Если Параметры = Неопределено Тогда
		// Метод не найден в метаданных - пропускаем без ошибки
		Возврат РезультатУспехаСДанными(Неопределено);
	КонецЕсли;

	Возврат ПроверитьЗапросПоМодели(
		Swag_Сборщик.СобратьМодель(),
		Параметры.URL, Параметры.HTTPМетод,
		Запрос);

КонецФункции

// Проверяет входящий HTTP-запрос по описанию метода.
// Модель передаётся снаружи - позволяет кэшировать её на уровне вызывающего кода.
//
// Параметры:
//   Модель    - Структура - модель OpenAPI (Swag_Модель)
//   URL       - Строка - путь операции (например "/test")
//   HTTPМетод - Строка - "get", "post", "put", "patch", "delete"
//   Запрос    - HTTPСервисЗапрос
//
// Возвращаемое значение:
//   Структура - {Успех: Булево, Данные: Структура, Ошибки: Массив}
//
Функция ПроверитьЗапросПоМодели(Модель, URL, HTTPМетод, Запрос) Экспорт

	МодульZod = ПолучитьМодульZodИлиВыбросить();

	Операция = НайтиОперацию(Модель, URL, HTTPМетод);
	Если Операция = Неопределено Тогда
		Возврат РезультатУспехаСДанными(Неопределено);
	КонецЕсли;

	Ошибки = Новый Массив;
	Данные = Новый Структура;
	Кэш = СобратьКэшСхем(Модель);

	Параметры = ПолучитьПоле(Операция, "parameters");
	Если ТипЗнч(Параметры) = Тип("Массив") Тогда
		Для Каждого Параметр Из Параметры Цикл
			ПроверитьПараметрЗапроса(Параметр, Запрос, Данные, Ошибки, Кэш, МодульZod);
		КонецЦикла;
	КонецЕсли;

	RequestBody = ПолучитьПоле(Операция, "requestBody");
	Если RequestBody <> Неопределено Тогда
		ПроверитьТелоЗапроса(RequestBody, Запрос, Данные, Ошибки, Кэш, МодульZod);
	КонецЕсли;

	Результат = Новый Структура("Успех, Данные, Ошибки");
	Результат.Успех = (Ошибки.Количество() = 0);
	Результат.Данные = Данные;
	Результат.Ошибки = Ошибки;
	Возврат Результат;

КонецФункции

// Проверяет исходящий HTTP-ответ по описанию метода.
//
// Параметры:
//   Модель    - Структура - модель OpenAPI
//   URL       - Строка
//   HTTPМетод - Строка
//   Ответ     - HTTPСервисОтвет
//
// Возвращаемое значение:
//   Структура - {Успех: Булево, Ошибки: Массив}
//
Функция ПроверитьОтветПоМодели(Модель, URL, HTTPМетод, Ответ) Экспорт

	МодульZod = ПолучитьМодульZodИлиВыбросить();

	Операция = НайтиОперацию(Модель, URL, HTTPМетод);
	Если Операция = Неопределено Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	Ошибки = Новый Массив;
	Кэш = СобратьКэшСхем(Модель);

	Ответы = ПолучитьПоле(Операция, "responses");
	КодОтвета = Строка(Ответ.КодСостояния);

	ОписаниеОтвета = Неопределено;
	Если ТипЗнч(Ответы) = Тип("Соответствие") Тогда
		ОписаниеОтвета = Ответы.Получить(КодОтвета);
	КонецЕсли;
	Если ОписаниеОтвета = Неопределено Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	Content = ПолучитьПоле(ОписаниеОтвета, "content");
	Если Content = Неопределено Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	ТипMIME = Ответ.Заголовки.Получить("Content-Type");
	Если ТипMIME = Неопределено Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	MediaType = Content.Получить(ТипMIME);
	Если MediaType = Неопределено Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	СхемаОтвета = ПолучитьПоле(MediaType, "schema");
	Если СхемаОтвета = Неопределено Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	ТелоСтрокой = Ответ.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоСтрокой) Тогда
		Возврат РезультатУспеха();
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоСтрокой);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		Ошибки.Добавить(Новый Структура("Путь, Сообщение",
				"", "Ответ не является корректным JSON"));
		Результат = Новый Структура("Успех, Ошибки");
		Результат.Успех = Ложь;
		Результат.Ошибки = Ошибки;
		Возврат Результат;
	КонецПопытки;

	СхемаZod = СхемаВZodВнутренний(СхемаОтвета, Кэш, МодульZod);
	Проверка = СхемаZod.Проверить(Данные);

	Для Каждого Ош Из Проверка.Ошибки Цикл
		Ошибки.Добавить(Ош);
	КонецЦикла;

	Результат = Новый Структура("Успех, Ошибки");
	Результат.Успех = (Ошибки.Количество() = 0);
	Результат.Ошибки = Ошибки;
	Возврат Результат;

КонецФункции

// Превращает Schema модели в Zod_Схема.
//
// Параметры:
//   Схема - Структура/Соответствие - OpenAPI Schema
//   Кэш   - Соответствие - разрешённые схемы из components
//
// Возвращаемое значение:
//   Zod_Схема (обработка)
//
Функция СхемаВZod(Схема, Кэш) Экспорт

	МодульZod = ПолучитьМодульZodИлиВыбросить();
	Возврат СхемаВZodВнутренний(Схема, Кэш, МодульZod);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ============ ПОЛУЧЕНИЕ МОДУЛЯ ZOD ============

Функция ПолучитьМодульZod()

	Если НЕ ЕстьZod() Тогда
		Возврат Неопределено;
	КонецЕсли;

	// АПК:488-выкл. ВычислитьВБезопасномРежиме не используется,
	// чтобы избежать рекурсивного вызова ЕстьZod() → ОбщийМодуль → Вычислить.
	// Имя проверено через Метаданные, вызов безопасен.
	ТекущийБезопасныйРежим = БезопасныйРежим();
	МодульZod = Неопределено;
	Попытка
		УстановитьБезопасныйРежим(Истина);
		МодульZod = Вычислить("Zod");
	Исключение
		МодульZod = Неопределено;
	КонецПопытки;
	УстановитьБезопасныйРежим(ТекущийБезопасныйРежим);
	// АПК:488-вкл

	Если ТипЗнч(МодульZod) <> Тип("ОбщийМодуль") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат МодульZod;

КонецФункции

Функция ПолучитьМодульZodИлиВыбросить()

	МодульZod = ПолучитьМодульZod();
	Если МодульZod = Неопределено Тогда
		ВызватьИсключение
		"Swag_ZodАдаптер: требуется библиотека zod-1c (общий модуль ""Zod""). "
		+ "Установите расширение zod-1c или не используйте функции Swag_ZodАдаптер.";
	КонецЕсли;
	Возврат МодульZod;

КонецФункции

Функция РезультатУспеха()
	Результат = Новый Структура("Успех, Ошибки");
	Результат.Успех = Истина;
	Результат.Ошибки = Новый Массив;
	Возврат Результат;
КонецФункции

Функция РезультатУспехаСДанными(Данные)
	Результат = Новый Структура("Успех, Данные, Ошибки");
	Результат.Успех = Истина;
	Результат.Данные = Данные;
	Результат.Ошибки = Новый Массив;
	Возврат Результат;
КонецФункции

// ============ ПОИСК ОПЕРАЦИИ ============

// Ищет операцию в модели по (URL, HTTP-метод).
// Не зависит от operationId - пользователь может переопределить его.
Функция НайтиОперацию(Модель, URL, HTTPМетод)

	Пути = ПолучитьПоле(Модель, "paths");
	Если ТипЗнч(Пути) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	PathItem = Пути.Получить(URL);
	Если PathItem = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПолучитьПоле(PathItem, HTTPМетод);

КонецФункции

Функция СобратьКэшСхем(Модель)

	Кэш = Новый Соответствие;
	Компоненты = ПолучитьПоле(Модель, "components");
	Если Компоненты = Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;
	Схемы = ПолучитьПоле(Компоненты, "schemas");
	Если ТипЗнч(Схемы) <> Тип("Соответствие") Тогда
		Возврат Кэш;
	КонецЕсли;
	Для Каждого Схема Из Схемы Цикл
		Кэш.Вставить(Схема.Ключ, Схема.Значение);
	КонецЦикла;
	Возврат Кэш;

КонецФункции

// ============ ПОСТРОЕНИЕ СХЕМ ============

Функция СхемаВZodВнутренний(Схема, Кэш, МодульZod)

	Если Схема = Неопределено Тогда
		Возврат МодульZod.Любое();
	КонецЕсли;

	Ссылка = ПолучитьПоле(Схема, "ref");
	Если Ссылка <> Неопределено Тогда
		ИмяСхемы = ИзвлечьИмяСхемы(Ссылка);
		Разрешённая = Кэш.Получить(ИмяСхемы);
		Если Разрешённая = Неопределено Тогда
			Возврат МодульZod.Любое();
		КонецЕсли;
		Если Разрешённая = "В_ПРОЦЕССЕ" Тогда
			Возврат МодульZod.Любое();
		КонецЕсли;
		Кэш.Вставить(ИмяСхемы, "В_ПРОЦЕССЕ");
		Результат = СхемаВZodВнутренний(Разрешённая, Кэш, МодульZod);
		Кэш.Вставить(ИмяСхемы, Разрешённая);
		Возврат Результат;
	КонецЕсли;

	Для Каждого КлючВариантов Из СтрРазделить("oneOf,anyOf,allOf", ",") Цикл
		Варианты = ПолучитьПоле(Схема, КлючВариантов);
		Если ТипЗнч(Варианты) = Тип("Массив") И Варианты.Количество() > 0 Тогда
			СхемыВариантов = Новый Массив;
			Для Каждого Вариант Из Варианты Цикл
				СхемыВариантов.Добавить(СхемаВZodВнутренний(Вариант, Кэш, МодульZod));
			КонецЦикла;
			Возврат МодульZod.Объединение(СхемыВариантов);
		КонецЕсли;
	КонецЦикла;

	Перечисление = ПолучитьПоле(Схема, "enum");
	Если ТипЗнч(Перечисление) = Тип("Массив") И Перечисление.Количество() > 0 Тогда
		Возврат МодульZod.Перечисление(Перечисление);
	КонецЕсли;

	Тип = ПолучитьПоле(Схема, "type");
	Формат = ПолучитьПоле(Схема, "format");

	Если Тип = "string" Тогда
		Возврат СтрокаВZod(Схема, Формат, МодульZod);
	ИначеЕсли Тип = "integer" Тогда
		СхемаZod = МодульZod.Числа().Целое();
		ПрименитьЧисловыеОграничения(СхемаZod, Схема);
		Возврат ПрименитьNullable(СхемаZod, Схема);
	ИначеЕсли Тип = "number" Тогда
		СхемаZod = МодульZod.Числа();
		ПрименитьЧисловыеОграничения(СхемаZod, Схема);
		Возврат ПрименитьNullable(СхемаZod, Схема);
	ИначеЕсли Тип = "boolean" Тогда
		Возврат ПрименитьNullable(МодульZod.Булевы(), Схема);
	ИначеЕсли Тип = "array" Тогда
		Возврат МассивВZod(Схема, Кэш, МодульZod);
	ИначеЕсли Тип = "object" Тогда
		Возврат ОбъектВZod(Схема, Кэш, МодульZod);
	КонецЕсли;

	Возврат МодульZod.Любое();

КонецФункции

Функция СтрокаВZod(Схема, Формат, МодульZod)

	Если Формат = "email" Тогда
		СхемаZod = МодульZod.Email();
	ИначеЕсли Формат = "uuid" Тогда
		СхемаZod = МодульZod.UUID();
	ИначеЕсли Формат = "date" ИЛИ Формат = "date-time" Тогда
		СхемаZod = МодульZod.ДатаISO();
	Иначе
		СхемаZod = МодульZod.Строки();
	КонецЕсли;

	МинДлина = ПолучитьПоле(Схема, "minLength");
	Если МинДлина <> Неопределено Тогда
		СхемаZod.МинДлина(МинДлина);
	КонецЕсли;
	МаксДлина = ПолучитьПоле(Схема, "maxLength");
	Если МаксДлина <> Неопределено Тогда
		СхемаZod.МаксДлина(МаксДлина);
	КонецЕсли;
	Паттерн = ПолучитьПоле(Схема, "pattern");
	Если Паттерн <> Неопределено Тогда
		СхемаZod.Паттерн(Паттерн);
	КонецЕсли;

	Возврат ПрименитьNullable(СхемаZod, Схема);

КонецФункции

Функция МассивВZod(Схема, Кэш, МодульZod)

	СхемаZod = МодульZod.Массивы();

	Элементы = ПолучитьПоле(Схема, "items");
	Если Элементы <> Неопределено Тогда
		СхемаZod.Элемент(СхемаВZodВнутренний(Элементы, Кэш, МодульZod));
	КонецЕсли;

	МинЭл = ПолучитьПоле(Схема, "minItems");
	Если МинЭл <> Неопределено Тогда
		СхемаZod.МинЭлементов(МинЭл);
	КонецЕсли;
	МаксЭл = ПолучитьПоле(Схема, "maxItems");
	Если МаксЭл <> Неопределено Тогда
		СхемаZod.МаксЭлементов(МаксЭл);
	КонецЕсли;

	Возврат ПрименитьNullable(СхемаZod, Схема);

КонецФункции

Функция ОбъектВZod(Схема, Кэш, МодульZod)

	СхемаZod = МодульZod.СтрогийОбъект();

	Свойства = ПолучитьПоле(Схема, "properties");
	Обязательные = ПолучитьПоле(Схема, "required");

	Если ТипЗнч(Свойства) = Тип("Соответствие") Тогда
		Для Каждого Свойство Из Свойства Цикл
			СхемаСвойства = СхемаВZodВнутренний(Свойство.Значение, Кэш, МодульZod);
			Если НЕ СодержитИмя(Обязательные, Свойство.Ключ) Тогда
				СхемаСвойства = СхемаСвойства.Необязательное();
			КонецЕсли;
			СхемаZod.Поле(Свойство.Ключ, СхемаСвойства);
		КонецЦикла;
	КонецЕсли;

	Возврат ПрименитьNullable(СхемаZod, Схема);

КонецФункции

// ============ ПАРАМЕТРЫ ЗАПРОСА ============

Процедура ПроверитьПараметрЗапроса(Параметр, Запрос, Данные, Ошибки, Кэш, МодульZod)

	Имя = ПолучитьПоле(Параметр, "name");
	Расположение = ПолучитьПоле(Параметр, "location");
	Обязательный = (ПолучитьПоле(Параметр, "required") = Истина);
	Схема = ПолучитьПоле(Параметр, "schema");

	Если Имя = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значение = ИзвлечьЗначениеПараметра(Расположение, Имя, Запрос);

	Если Значение = Неопределено Тогда
		Если Обязательный Тогда
			Ошибки.Добавить(Новый Структура("Путь, Сообщение",
					Имя, "Обязательный параметр не передан"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	СхемаZod = СхемаВZodВнутренний(Схема, Кэш, МодульZod);
	СхемаZodПриведённая = ПрименитьПриведение(СхемаZod, Схема, Расположение, МодульZod);
	Проверка = СхемаZodПриведённая.Проверить(Значение);

	Если Проверка.Успех Тогда
		Данные.Вставить(Имя, Проверка.Данные);
	Иначе
		Для Каждого Ош Из Проверка.Ошибки Цикл
			Ошибки.Добавить(Новый Структура("Путь, Сообщение",
					Имя + ?(ПустаяСтрока(Ош.Путь), "", "." + Ош.Путь),
					Ош.Сообщение));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ИзвлечьЗначениеПараметра(Расположение, Имя, Запрос)

	Если Расположение = "query" Тогда
		Возврат Запрос.ПараметрыЗапроса.Получить(Имя);
	ИначеЕсли Расположение = "header" Тогда
		Возврат Запрос.Заголовки.Получить(Имя);
	ИначеЕсли Расположение = "path" Тогда
		Возврат Запрос.ПараметрыURL.Получить(Имя);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПрименитьПриведение(СхемаZod, Схема, Расположение, МодульZod)

	Если Расположение = "query" ИЛИ Расположение = "path" ИЛИ Расположение = "header" Тогда
		Тип = ПолучитьПоле(Схема, "type");
		Если Тип = "integer" ИЛИ Тип = "number" Тогда
			Возврат МодульZod.ПриведенноеЧисло();
		ИначеЕсли Тип = "boolean" Тогда
			Возврат МодульZod.ПриведенноеБулево();
		КонецЕсли;
	КонецЕсли;
	Возврат СхемаZod;

КонецФункции

// ============ ТЕЛО ЗАПРОСА ============

Процедура ПроверитьТелоЗапроса(RequestBody, Запрос, Данные, Ошибки, Кэш, МодульZod)

	Content = ПолучитьПоле(RequestBody, "content");
	Если ТипЗнч(Content) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	ТипMIME = Запрос.Заголовки.Получить("Content-Type");
	Если ТипMIME = Неопределено Тогда
		ТипMIME = "application/json";
	КонецЕсли;

	MediaType = Content.Получить(ТипMIME);
	Если MediaType = Неопределено Тогда
		MediaType = Content.Получить("application/json");
	КонецЕсли;
	Если MediaType = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Схема = ПолучитьПоле(MediaType, "schema");
	Если Схема = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТелоСтрокой = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоСтрокой) Тогда
		Обязательный = (ПолучитьПоле(RequestBody, "required") = Истина);
		Если Обязательный Тогда
			Ошибки.Добавить(Новый Структура("Путь, Сообщение",
					"", "Тело запроса обязательно, но не передано"));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоСтрокой);
		ДанныеТела = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		Ошибки.Добавить(Новый Структура("Путь, Сообщение",
				"", "Тело запроса не является корректным JSON"));
		Возврат;
	КонецПопытки;

	СхемаZod = СхемаВZodВнутренний(Схема, Кэш, МодульZod);
	Проверка = СхемаZod.Проверить(ДанныеТела);

	Если Проверка.Успех Тогда
		ТипДанных = ТипЗнч(Проверка.Данные);
		Если ТипДанных = Тип("Структура") ИЛИ ТипДанных = Тип("Соответствие") Тогда
			// Тело - объект: мержим поля на верхний уровень
			Для Каждого Поле Из Проверка.Данные Цикл
				Данные.Вставить(Поле.Ключ, Поле.Значение);
			КонецЦикла;
		Иначе
			// Тело - массив, примитив, Неопределено
			Данные.Вставить("body", Проверка.Данные);
		КонецЕсли;
	Иначе
		Для Каждого Ош Из Проверка.Ошибки Цикл
			Ошибки.Добавить(Ош);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// ============ ОБЩИЕ ХЕЛПЕРЫ ============

Функция ПолучитьПоле(Коллекция, Имя)

	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Коллекция);
	Если ТипЗначения = Тип("Структура") Тогда
		Результат = Неопределено;
		Коллекция.Свойство(Имя, Результат);
		Возврат Результат;
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ИзвлечьИмяСхемы(Ссылка)
	Префикс = "#/components/schemas/";
	Если Лев(Ссылка, СтрДлина(Префикс)) = Префикс Тогда
		Возврат Сред(Ссылка, СтрДлина(Префикс) + 1);
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция СодержитИмя(МассивИмён, Имя)
	Если ТипЗнч(МассивИмён) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Элемент Из МассивИмён Цикл
		Если Элемент = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПрименитьNullable(СхемаZod, Схема)
	Если ПолучитьПоле(Схема, "nullable") = Истина Тогда
		Возврат СхемаZod.ДопускаетNull();
	КонецЕсли;
	Возврат СхемаZod;
КонецФункции

Процедура ПрименитьЧисловыеОграничения(СхемаZod, Схема)

	Минимум = ПолучитьПоле(Схема, "minimum");
	ЭксМин = ПолучитьПоле(Схема, "exclusiveMinimum");
	Если Минимум <> Неопределено Тогда
		СхемаZod.МинЗначение(Минимум);
	ИначеЕсли ЭксМин <> Неопределено И ТипЗнч(ЭксМин) <> Тип("Булево") Тогда
		СхемаZod.МинЗначение(ЭксМин);
	КонецЕсли;

	Максимум = ПолучитьПоле(Схема, "maximum");
	ЭксМакс = ПолучитьПоле(Схема, "exclusiveMaximum");
	Если Максимум <> Неопределено Тогда
		СхемаZod.МаксЗначение(Максимум);
	ИначеЕсли ЭксМакс <> Неопределено И ТипЗнч(ЭксМакс) <> Тип("Булево") Тогда
		СхемаZod.МаксЗначение(ЭксМакс);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
