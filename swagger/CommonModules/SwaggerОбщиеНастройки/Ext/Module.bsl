////////////////////////////////////////////////////////////////////////////////
// SwaggerОбщиеНастройки - настройки библиотеки swagger-1c.
//
// ЭТО МЕСТО ДЛЯ ВАШИХ НАСТРОЕК.
//
// Функция ПолучитьОбщиеНастройки() возвращает структуру, которую читают
// Swag_Запросы и Swag_Сборщик. Чтобы изменить поведение библиотеки -
// отредактируйте эту функцию. Никаких других файлов трогать не нужно.
//
// ЧТО МОЖНО НАСТРОИТЬ:
//
//   1. РежимГенератора - какой генератор использовать для swagger.json:
//        "Выкл"    - старый генератор (по умолчанию, ничего не меняется)
//        "Мягкий"  - новый OpenAPI 3.1, неполные описания = предупреждения
//        "Строгий" - новый OpenAPI 3.1, любая ошибка = fallback на старый
//
//   2. Title / Version - заголовок и версия API в info. По умолчанию
//      берутся из метаданных конфигурации. Задайте явно, если хотите
//      публичное имя API, отличное от имени конфигурации.
//
//   3. BaseURL - сервер API. Пустая строка = автоопределение из запроса.
//      Задайте явно, если API публикуется на фиксированном домене.
//
//   4. UseBasicAuth - добавлять ли глобальную Basic-аутентификацию.
//      Истина (по умолчанию) - как в старом swagger-1c. Ложь - если
//      используете OAuth2/JWT через отдельный security-схемы.
//
//   5. МассивНеотображаемыхСервисов - какие HTTP-сервисы НЕ показывать
//      в swagger.json. Полезно для скрытия тестовых, отладочных,
//      внутренних сервисов из публичной документации.
//
//   6. (Опционально) - можно создать отдельный общий модуль
//      "SwaggerОбщиеНастройкиПользователя" и перенести настройки туда.
//      Тогда этот модуль останется как есть (не редактируется при
//      обновлении расширения), а ваши настройки - в отдельном модуле.
//      Поддерживается автоматически: Swag_Сборщик сначала ищет
//      "SwaggerОбщиеНастройкиПользователя", потом - этот модуль.
//
// ПРИМЕР ВКЛЮЧЕНИЯ НОВОГО ГЕНЕРАТОРА:
//
//   Настройки.Вставить("РежимГенератора", "Мягкий");
//
// После этого откройте /swagger/swagger.json - увидите "openapi": "3.1.0".
// Если что-то пойдёт не так - верните "Выкл", и всё будет как раньше.
// Подробная инструкция по переходу - в MIGRATION.md.
//
// ПРИМЕР ИСКЛЮЧЕНИЯ СЕРВИСА:
//
//   Настройки.МассивНеотображаемыхСервисов.Добавить("МойВнутреннийСервис");
//
// Сервис перестанет попадать в swagger.json, но продолжит работать.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает текущие настройки библиотеки.
//
// Возвращаемое значение:
//   Структура - см. описание полей в шапке модуля.
//
Функция ПолучитьОбщиеНастройки() Экспорт

	Настройки = Новый Структура;

	// ============ РЕЖИМ ГЕНЕРАТОРА ============
	//
	// "Выкл"    - старый генератор OpenAPI 3.0.0 (по умолчанию)
	// "Мягкий"  - новый генератор OpenAPI 3.1, неполные описания = предупреждения
	// "Строгий" - новый генератор OpenAPI 3.1, ошибки = fallback на старый
	//
	// Начните с "Мягкий" при переходе. См. MIGRATION.md.
	Настройки.Вставить("РежимГенератора", "Выкл");

	// ============ ИНФОРМАЦИЯ ОБ API ============
	//
	// По умолчанию - из метаданных конфигурации.
	// Переопределите, если публичное имя API отличается от имени конфигурации.
	//
	// Пример:
	//   Настройки.Вставить("Title", "Customer API");
	//   Настройки.Вставить("Version", "2.1.0");
	Настройки.Вставить("Title", Метаданные.Имя);
	Настройки.Вставить("Version", Метаданные.Версия);

	// ============ БАЗОВЫЙ URL ============
	//
	// Пустая строка - автоопределение из запроса (рекомендуется).
	// Если API публикуется на фиксированном домене - задайте явно:
	//   "https://api.example.com"
	Настройки.Вставить("BaseURL", "");

	// ============ BASIC-АУТЕНТИФИКАЦИЯ ============
	//
	// Истина - добавить глобальную security-схему "basic" (как в старом swagger-1c).
	// Ложь - если используете OAuth2/JWT и не хотите показывать basic в UI.
	Настройки.Вставить("UseBasicAuth", Истина);

	// ============ ИСКЛЮЧЕНИЯ ============
	//
	// HTTP-сервисы, которые НЕ должны попадать в swagger.json.
	// Полезно для скрытия тестовых, отладочных, внутренних сервисов.
	//
	// Пример:
	//   Настройки.МассивНеотображаемыхСервисов.Добавить("МойВнутреннийСервис");
	//   Настройки.МассивНеотображаемыхСервисов.Добавить("Demo_Ошибки");
	Настройки.Вставить("МассивНеотображаемыхСервисов", Новый Массив);

	Возврат Настройки;

КонецФункции

#КонецОбласти
