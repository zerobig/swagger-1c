	|        ""schema"": {""type"": ""string""}
	|      }
	|    }
	|  ]
	|}";
КонецФункции

#КонецОбласти

#Область НовыйГенератор

// Возвращает JSON-строку или Неопределено, если новый генератор не справился.
Функция СформироватьНовымГенератором(БазовыйURL, РежимГенератора) Экспорт

	СтрогаяПроверка = (РежимГенератора = "Строгий");

	Попытка
		// Читаем все настройки из SwaggerОбщиеНастройки
		Настройки = ПрочитатьОбщиеНастройкиДляСборщика(БазовыйURL, СтрогаяПроверка);

		Модель = Swag_Сборщик.СобратьМодель(Настройки);
		Возврат ОбработатьМодельВРежиме(Модель, РежимГенератора);
	Исключение
		ЗаписатьДиагностикуРежима(УровеньЖурналаРегистрации.Ошибка,
			"Новый генератор упал: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Собирает структуру настроек для Swag_Сборщик.СобратьМодель,
// объединяя значения из SwaggerОбщиеНастройки с переданными параметрами.
Функция ПрочитатьОбщиеНастройкиДляСборщика(БазовыйURL, СтрогаяПроверка)

	Результат = Новый Структура;
	Результат.Вставить("BaseURL", БазовыйURL);
	Результат.Вставить("СтрогаяПроверка", СтрогаяПроверка);

	// Читаем остальные настройки из SwaggerОбщиеНастройки (если модуль есть)
	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль("SwaggerОбщиеНастройки");
		Настройки = Модуль.ПолучитьОбщиеНастройки();

		Если ТипЗнч(Настройки) = Тип("Структура") Тогда
			Если Настройки.Свойство("Title") Тогда
				Результат.Вставить("Title", Настройки.Title);
			КонецЕсли;
			Если Настройки.Свойство("Version") Тогда
				Результат.Вставить("Version", Настройки.Version);
			КонецЕсли;
			Если Настройки.Свойство("BaseURL")
				И НЕ ПустаяСтрока(Строка(Настройки.BaseURL)) Тогда
				// Явно заданный BaseURL в настройках важнее автоопределения
				Результат.Вставить("BaseURL", Настройки.BaseURL);
			КонецЕсли;
			Если Настройки.Свойство("UseBasicAuth") Тогда
				Результат.Вставить("UseBasicAuth", Настройки.UseBasicAuth);
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Модуля нет или он падает - работаем с дефолтами из СобратьМодель
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает текущий режим генератора: "Выкл" | "Мягкий" | "Строгий".
// Читается из SwaggerОбщиеНастройки; при отсутствии - "Выкл".
Функция ПолучитьРежимГенератора() Экспорт

	Попытка
		Модуль = ОбщегоНазначения.ОбщийМодуль("SwaggerОбщиеНастройки");
		Настройки = Модуль.ПолучитьОбщиеНастройки();
		Если ТипЗнч(Настройки) = Тип("Структура")
			И Настройки.Свойство("РежимГенератора") Тогда
			Режим = СокрЛП(Строка(Настройки.РежимГенератора));
			Если Режим = "Мягкий" ИЛИ Режим = "Строгий" Тогда
				Возврат Режим;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Модуля настроек нет или он падает - используем старый генератор
	КонецПопытки;

	Возврат "Выкл";

КонецФункции

// Чистая логика обработки готовой модели в зависимости от режима.
// Не собирает модель из конфигурации - принимает её готовой.
// Это позволяет тестировать логику режимов детерминированно.
//
// Параметры:
//   Модель          - Структура - готовая модель OpenAPI
//   РежимГенератора - Строка    - "Мягкий" | "Строгий"
//
// Возвращаемое значение:
//   Строка      - JSON, если модель обработана успешно
//   Неопределено - если нужен fallback на старый генератор
//
Функция ОбработатьМодельВРежиме(Модель, РежимГенератора) Экспорт

	Проверка = Swag_Модель.ПроверитьОписание(Модель);

	Если РежимГенератора = "Мягкий" Тогда
		Если Проверка.Ошибки.Количество() > 0 Тогда
			ЗаписатьДиагностикуРежима(УровеньЖурналаРегистрации.Предупреждение,
				"Мягкий режим: JSON отдан с замечаниями ("
				+ Проверка.Ошибки.Количество() + "):"
				+ Символы.ПС + Swag_Модель.ТекстОшибок(Проверка.Ошибки));
		КонецЕсли;
		Возврат Swag_СериализаторOpenAPI.Сериализовать(Модель, Ложь);
	КонецЕсли;

	// Строгий
	Если Проверка.Валидно Тогда
		Возврат Swag_СериализаторOpenAPI.Сериализовать(Модель, Ложь);
	Иначе
		ЗаписатьДиагностикуРежима(УровеньЖурналаРегистрации.Ошибка,
			"Строгий режим: модель невалидна, fallback на старый генератор:"
			+ Символы.ПС + Swag_Модель.ТекстОшибок(Проверка.Ошибки));
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Процедура ЗаписатьДиагностикуРежима(Уровень, Текст)
	ЗаписьЖурналаРегистрации(
		"Swagger: Переход на новый генератор",
		Уровень, , , Текст);
КонецПроцедуры

#КонецОбласти

#КонецОбласти
