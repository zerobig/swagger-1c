// ============ РЕЗУЛЬТАТ ============

Процедура РезультатИзОтвета200() Экспорт

    Схема = Новый Соответствие;
    Схема.Вставить("type", "object");
    Схема.Вставить("ref", "#/components/schemas/Result");

    Ответы = Новый Массив;
    Ответы.Добавить(Ответ(200, "OK", Схема));

    Рез = Swag_АдаптерСовместимости.ПреобразоватьМетодJSONRPC(
        Метод("test", Неопределено, Неопределено, Ответы));

    ЮТест.ОжидаетЧто(Рез.result.name).Равно("result");
    ЮТест.ОжидаетЧто(Рез.result.description).Равно("OK");
    ЮТест.ОжидаетЧто(Рез.result.schema.Получить("ref"),
        "Внутреннее имя - ref (сериализатор превратит в $ref)")
        .Равно("#/components/schemas/Result");

КонецПроцедуры

