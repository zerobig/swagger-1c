Процедура НесколькоОтветов_БерётсяТолькоОдин200() Экспорт

    Схема200 = Новый Соответствие;
	Схема200.Вставить("type", "object");
    Схема404 = Новый Соответствие;
	Схема404.Вставить("type", "string");

    Ответы = Новый Массив;
    Ответы.Добавить(Ответ(404, "Not found", Схема404));
    Ответы.Добавить(Ответ(200, "OK", Схема200));
    Ответы.Добавить(Ответ(500, "Error"));

    Рез = Swag_АдаптерСовместимости.ПреобразоватьМетодJSONRPC(
        Метод("test", Неопределено, Неопределено, Ответы));

    ЮТест.ОжидаетЧто(Рез.result.description).Равно("OK");
    ЮТест.ОжидаетЧто(Рез.result.schema.Получить("type")).Равно("object");

КонецПроцедуры
