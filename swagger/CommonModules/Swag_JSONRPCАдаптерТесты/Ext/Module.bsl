Процедура ВсеПараметрыПопадаютВParams() Экспорт

    // Параметры созданы как .ПараметрЗапроса() / .ПараметрURL() / .ПараметрЗаголовка()
    // - все должны попасть в params, потому что сервис целиком json-rpc
    Параметры = Новый Массив;
    Параметры.Добавить(ПараметрHTTP("queryParam", "query"));
    Параметры.Добавить(ПараметрHTTP("headerParam", "header"));
    Параметры.Добавить(ПараметрHTTP("pathParam", "path"));

    Рез = Swag_АдаптерСовместимости.ПреобразоватьМетодJSONRPC(
        Метод("test", Неопределено, Параметры));

    ЮТест.ОжидаетЧто(Рез.params.Количество()).Равно(3);
    ЮТест.ОжидаетЧто(Рез.params[0].name).Равно("queryParam");
    ЮТест.ОжидаетЧто(Рез.params[1].name).Равно("headerParam");
    ЮТест.ОжидаетЧто(Рез.params[2].name).Равно("pathParam");

КонецПроцедуры

