// ============ ХЕЛПЕРЫ ============

// Создаёт параметр JSON-RPC с заданными полями.
Функция ПараметрJSONRPC(Имя, ТипЗначения = "string", Обязательный = Ложь)
    Результат = Новый Структура;
    Результат.Вставить("Имя", Имя);
    Результат.Вставить("Описание", Неопределено);
    Результат.Вставить("ТипПараметра", "query");
    Результат.Вставить("Обязательный", Обязательный);
    Результат.Вставить("ТипЗначения", ТипЗначения);
    Результат.Вставить("Перечисление", Неопределено);
    Результат.Вставить("МинимальнаяДлина", Неопределено);
    Результат.Вставить("МаксимальнаяДлина", Неопределено);
    Возврат Результат;
КонецФункции

// Создаёт параметр с другим ТипПараметра (query/header/path/form).
Функция ПараметрHTTP(Имя, ТипПараметра = "query")
    Результат = Новый Структура;
    Результат.Вставить("Имя", Имя);
    Результат.Вставить("Описание", Неопределено);
    Результат.Вставить("ТипПараметра", ТипПараметра);
    Результат.Вставить("Обязательный", Ложь);
    Результат.Вставить("ТипЗначения", "string");
    Результат.Вставить("Перечисление", Неопределено);
    Результат.Вставить("МинимальнаяДлина", Неопределено);
    Результат.Вставить("МаксимальнаяДлина", Неопределено);
    Возврат Результат;
КонецФункции

// Создаёт ответ с кодом и (опционально) схемой.
Функция Ответ(Код, Описание, Схема = Неопределено)
    Результат = Новый Структура;
    Результат.Вставить("Код", Код);
    Результат.Вставить("Описание", Описание);
    Если Схема <> Неопределено Тогда
        MIME = Новый Структура;
        MIME.Вставить("Заголовок", "application/json");
        MIME.Вставить("Тип", Неопределено);
        MIME.Вставить("Схема", Схема);
        МассивMIME = Новый Массив;
        МассивMIME.Добавить(MIME);
        Результат.Вставить("МассивТиповMIME", МассивMIME);
    Иначе
        Результат.Вставить("МассивТиповMIME", Неопределено);
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Создаёт «голый» метод для передачи в ПреобразоватьМетодJSONRPC.
Функция Метод(Имя, Описание = Неопределено, Параметры = Неопределено, Ответы = Неопределено)
    Результат = Новый Структура;
    Результат.Вставить("Имя", Имя);
    Результат.Вставить("Описание", Описание);
    Если Параметры = Неопределено Тогда
        Результат.Вставить("Параметры", Новый Массив);
    Иначе
        Результат.Вставить("Параметры", Параметры);
    КонецЕсли;
    Если Ответы = Неопределено Тогда
        Результат.Вставить("Ответы", Новый Массив);
    Иначе
        Результат.Вставить("Ответы", Ответы);
    КонецЕсли;
    Возврат Результат;
КонецФункции

